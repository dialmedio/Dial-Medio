{
  // Worker de Dial en Cloudflare. Cada push a main en GitHub lo compila y publica (Workers Builds).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dial-medio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // El Worker atiende primero la redirección de www y el formulario.
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
