{
  // Worker de Dial en Cloudflare. Cada push a main en GitHub lo compila y publica (Workers Builds).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dial-medio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // El Worker atiende primero la redirección de www y el formulario.
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Aportes en /apoya (worker/index.ts). Por ahora el comercio de Wompi es el de la RED Quynza.
  // El secreto WOMPI_INTEGRITY_SECRET se pone con: bash scripts/activar-wompi.sh
  "vars": { "WOMPI_PUBLIC_KEY": "pub_prod_Yz9ROtHkvKsiGQwAUqmTIqNUd5z4KkWf" }
}
