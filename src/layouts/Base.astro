---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import sitio from '../data/sitio.json';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  imagenAlt?: string;
  noindex?: boolean;
  tipo?: 'website' | 'article' | 'video.other';
  /** La portada lleva la mancheta grande. */
  portada?: boolean;
  /** Para artículos: fechas, autor y sección (Open Graph y datos estructurados). */
  articulo?: { publicado: Date; modificado?: Date; autor: string; seccion: string; tipo?: 'NewsArticle' | 'OpinionNewsArticle' | 'AnalysisNewsArticle' };
  /** Datos estructurados propios de la página (se suman a los de la organización). */
  ld?: Record<string, unknown>;
}

// Imagen para compartir de cada página (se generan con scripts/generar-imagenes.mjs).
const tarjetas: Record<string, string> = {
  '/': 'inicio',
  '/noticias': 'noticias',
  '/opinion': 'opinion',
  '/podcast': 'podcast',
  '/documentales': 'documentales',
  '/laboratorio': 'laboratorio',
  '/principios': 'principios',
  '/nosotros': 'nosotros',
  '/estudio': 'estudio',
  '/estudio/como-trabajamos': 'estudio',
  '/impacto': 'impacto',
  '/impacto/medicion': 'medicion',
  '/encuentros': 'encuentros',
  '/encuentros/celebraciones': 'celebraciones',
  '/contacto': 'contacto',
};
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';

const {
  titulo,
  descripcion = sitio.descripcion,
  imagen = `/og/${tarjetas[ruta] ?? 'inicio'}.jpg`,
  noindex = false,
  tipo = 'website',
  portada = false,
  articulo,
  ld,
} = Astro.props;

const tituloCompleto = !titulo ? 'Dial · Análisis, opinión y documental desde Colombia' : titulo.startsWith('Dial') ? titulo : `${titulo} · Dial`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const imagenPropia = imagenAbs.hostname === Astro.site?.hostname;
const imagenAlt = Astro.props.imagenAlt ?? (titulo ? `${titulo} — Dial` : 'Dial: análisis, opinión y documental desde Colombia');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': new URL('/#dial', Astro.site).toString(),
  name: 'Dial',
  publishingPrinciples: new URL('/principios', Astro.site).toString(),
  correctionsPolicy: new URL('/principios#correcciones', Astro.site).toString(),
  ethicsPolicy: new URL('/principios', Astro.site).toString(),
  slogan: sitio.tagline,
  description: sitio.descripcion,
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  email: sitio.correo,
  address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
  sameAs: sitio.redes.map((r) => r.url),
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1a1613" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content="Dial" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:secure_url" content={imagenAbs} />
    <meta property="og:image:alt" content={imagenAlt} />
    {imagenPropia && <meta property="og:image:type" content="image/jpeg" />}
    {imagenPropia && imagen.startsWith('/og') && <meta property="og:image:width" content="1200" />}
    {imagenPropia && imagen.startsWith('/og') && <meta property="og:image:height" content="630" />}
    {articulo && <meta property="article:published_time" content={articulo.publicado.toISOString()} />}
    {articulo?.modificado && <meta property="article:modified_time" content={articulo.modificado.toISOString()} />}
    {articulo && <meta property="article:author" content={articulo.autor} />}
    {articulo && <meta property="article:section" content={articulo.seccion} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />
    <meta name="twitter:image:alt" content={imagenAlt} />

    <link rel="alternate" type="application/rss+xml" title="Dial" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Dial · Opinión" href="/opinion/rss.xml" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...ld })} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header portada={portada} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      // Menú del celular: lo abren la hamburguesa de la mancheta y la de la fila fija de secciones.
      const botones = document.querySelectorAll<HTMLButtonElement>('[data-menu-boton]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const cerrar = () => {
        if (!menu || menu.hidden) return;
        botones.forEach((b) => b.setAttribute('aria-expanded', 'false'));
        menu.hidden = true;
        document.body.style.overflow = '';
      };
      botones.forEach((b) =>
        b.addEventListener('click', () => {
          if (!menu) return;
          botones.forEach((x) => x.setAttribute('aria-expanded', 'true'));
          menu.hidden = false;
          document.body.style.overflow = 'hidden';
          menu.querySelector<HTMLElement>('[data-menu-cerrar]')?.focus();
        }),
      );
      document.querySelector('[data-menu-cerrar]')?.addEventListener('click', cerrar);
      document.addEventListener('keydown', (e) => e.key === 'Escape' && cerrar());
      matchMedia('(min-width: 861px)').addEventListener('change', cerrar);

      // Videos livianos: el reproductor solo carga al hacer clic
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.video-boton');
        if (!btn) return;
        const cont = btn.closest<HTMLElement>('[data-video]');
        if (!cont) return;
        const { video: id, plataforma, titulo } = cont.dataset;
        const src =
          plataforma === 'vimeo'
            ? `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1`
            : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = titulo ?? 'Video';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        cont.classList.add('reproduciendo');
        btn.replaceWith(iframe);
        iframe.focus();
      });
      // Si YouTube no tiene miniatura en alta resolución, usa la estándar.
      document.querySelectorAll<HTMLImageElement>('img[data-respaldo]').forEach((img) => {
        const cambiar = () => {
          if (img.dataset.respaldo && img.src !== img.dataset.respaldo) img.src = img.dataset.respaldo;
        };
        // YouTube responde 120x90 cuando no existe la versión grande.
        const revisar = () => img.naturalWidth <= 120 && cambiar();
        img.addEventListener('error', cambiar);
        img.complete ? revisar() : img.addEventListener('load', revisar, { once: true });
      });

      // Revelado suave al entrar en pantalla
      const io = new IntersectionObserver(
        (entradas) =>
          entradas.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('visible');
              io.unobserve(en.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-revela]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
