---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Firma from '../../components/Firma.astro';
import { fechaLarga, isoDia } from '../../lib/medio';

export async function getStaticPaths() {
  const ensayos = await getCollection('fotografia', (f) => !f.data.borrador);
  return ensayos.map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const d = e.data;
const autor = d.autor ? await getEntry(d.autor) : undefined;
const { Content } = await render(e);
---

<Base titulo={d.titulo} descripcion={d.bajada} tipo="article">
  <article class="tema-carbon grano ensayo" data-pagefind-body>
    <header class="contenedor cabeza">
      <p class="rotulo"><a href="/fotografia">Fotografía</a>{d.lugar && ` · ${d.lugar}`}</p>
      <h1 class="titular">{d.titulo}</h1>
      <p class="bajada">{d.bajada}</p>
      <div class="firma-fila">
        <Firma autor={autor} nombre={d.fotografo} />
        <p class="datos"><time datetime={isoDia(d.fecha)}>{fechaLarga(d.fecha)}</time></p>
      </div>
    </header>
    <figure class="portada"><Image src={d.portada} alt="" widths={[960, 1600, 2400]} sizes="100vw" loading="eager" /></figure>
    <div class="contenedor texto prosa"><Content /></div>
    <div class="fotos">
      {
        d.fotos.map((f) => (
          <figure>
            <Image src={f.src} alt={f.pie ?? ''} widths={[800, 1400, 2000]} sizes="(min-width: 1200px) 1100px, 100vw" />
            {f.pie && <figcaption class="pie-foto">{f.pie}</figcaption>}
          </figure>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .ensayo { position: relative; padding-bottom: clamp(64px, 8vw, 112px); }
  .cabeza { display: grid; gap: 18px; padding-block: clamp(48px, 6vw, 88px) 40px; max-width: calc(900px + 2 * var(--gutter)); }
  .cabeza a { color: inherit; text-decoration: none; }
  .cabeza h1 { font-size: clamp(3rem, 1.4rem + 5vw, 6.4rem); line-height: .94; }
  .cabeza .bajada { color: var(--hueso-2); }
  .firma-fila { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; }
  .portada img { width: 100%; height: auto; }
  .texto { padding-block: 56px; }
  .fotos { display: grid; gap: clamp(40px, 6vw, 96px); max-width: 1100px; margin-inline: auto; padding-inline: var(--gutter); }
  .fotos img { width: 100%; height: auto; }
</style>
