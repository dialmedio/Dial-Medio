---
import Base from '../layouts/Base.astro';
import Simbolo from '../components/Simbolo.astro';
import sitio from '../data/sitio.json';
import Boletin from '../components/Boletin.astro';
---

<Base titulo="Gracias" noindex>
  <section class="gracias tema-carbon grano">
    <div class="contenedor gracias-cuerpo">
      <Simbolo tono="claro" anima class="gracias-simbolo" />
      <p class="kicker"><span class="acento">Señal recibida</span></p>
      <h1 class="display d-2">Gracias. Ya tenemos tu mensaje.</h1>
      <p class="lead texto-2">{sitio.respuesta} Mientras tanto, puedes ver lo que hacemos en Dial Medio.</p>
      <div class="acciones">
        <a href="/medio" class="btn">Ver Dial Medio <span class="flecha">→</span></a>
        <a href="/" class="btn linea">Volver al inicio</a>
      </div>
      <div class="gracias-boletin">
        <p class="kicker sin-linea"><span class="acento">Boletín</span> · {sitio.boletin.frecuencia}</p>
        <p class="texto-2">{sitio.boletin.descripcion}</p>
        <Boletin id="boletin-gracias" origen="gracias" />
      </div>
    </div>
  </section>
</Base>

<style>
  .gracias { min-height: calc(100svh - 72px); display: grid; align-items: center; position: relative; padding-block: 72px; }
  .gracias-cuerpo { display: grid; gap: 24px; justify-items: start; }
  .gracias-cuerpo :global(.gracias-simbolo) { width: 120px; margin-bottom: 12px; }
  .gracias h1 { max-width: 16ch; }
  .gracias .lead { margin: 0; }
  .gracias-boletin { display: grid; gap: 12px; margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--linea-clara); width: 100%; max-width: 560px; }
  .gracias-boletin p { margin: 0; }
</style>
