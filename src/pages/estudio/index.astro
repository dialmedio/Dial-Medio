---
/**
 * Dial Estudio (nov 2026): la productora de Dial. Página comercial con imagen propia: fotogramas de las piezas
 * y fotos de Martín, reveladas con la película de la casa (src/assets/estudio). Nada de clientes ni cifras inventadas.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import VideoLite from '../../components/VideoLite.astro';
import EscalaMedicion from '../../components/EscalaMedicion.astro';
import CTAFinal from '../../components/CTAFinal.astro';
import Sintonizador from '../../components/Sintonizador.astro';
import sitio from '../../data/sitio.json';
import cap from '../../data/capacidades.json';
import { dos, anio, rutaCaso } from '../../lib/util';
import { rutaVideo } from '../../lib/medio';

import palenque from '../../assets/estudio/palenque.jpg';
import congreso from '../../assets/estudio/congreso.jpg';
import liveSession from '../../assets/estudio/live-session.jpg';
import feoPalante from '../../assets/estudio/feo-palante.jpg';
import dragon from '../../assets/estudio/shadow-of-the-dragon.jpg';
import disco from '../../assets/estudio/in-vitro-disco.jpg';
import Simbolo from '../../components/Simbolo.astro';

const servicios = (await getCollection('servicios')).sort((a, b) =>
  a.data.linea === b.data.linea ? a.data.orden - b.data.orden : a.data.linea === 'impacto' ? -1 : 1,
);

// Trabajo: primero los casos por encargo (cuando los haya), luego la obra propia y las muestras de oficio.
const casos = (await getCollection('casos', (c) => !c.data.borrador && !!c.data.video && c.data.vitrina !== 'celebraciones')).map((c) => ({
  titulo: c.data.titulo,
  video: c.data.video!,
  href: rutaCaso(c.data.vitrina, c.id),
  rotulo: c.data.organizacion ?? 'Por encargo',
  meta: `${c.data.lugar} · ${c.data.anio}`,
}));
// Currulao se queda en Documentales pero no aquí: su miniatura es una foto que no es de Dial (Martín, 1 nov 2026).
const propios = (await getCollection('medio', (m) => !m.data.borrador && m.data.mostrarEnImpacto && !!m.data.video && m.id !== 'currulao-musicas-del-pacifico-sur'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((m) => ({ titulo: m.data.titulo, video: m.data.video!, href: rutaVideo(m), rotulo: 'Documental · Dial', meta: `${m.data.lugar} · ${anio(m.data.fecha)}` }));
const muestras = (await getCollection('muestras', (m) => !m.data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((m) => ({ titulo: m.data.titulo, video: m.data.video, href: undefined, rotulo: m.data.disciplinas.join(' · '), meta: `${m.data.rol.replace(/\.$/, '')} · ${m.data.anio}` }));
// La sesión en vivo de In-Vitro va primero: sonido e imagen hechos en casa.
const sesion = { titulo: 'In-Vitro Live Sessions', video: { plataforma: 'youtube' as const, id: 'tt3X0UynmCk' }, href: 'https://youtu.be/tt3X0UynmCk', rotulo: 'Sesión en vivo · Sonido e imagen', meta: 'Bogotá' };
const trabajo = [sesion, ...casos, ...propios, ...muestras].slice(0, 6);
const DISCO = 'https://www.youtube.com/playlist?list=PLtGEMPLbnH8X4YTzesInC5vgKMwdJm9LD';

const lugares = ['Bogotá', 'Pacífico colombiano', 'San Basilio de Palenque', 'Pereira', 'Barranquilla', 'Cali', 'Popayán', 'Tres países de Asia'];
---

<Base
  titulo="Dial Estudio · Productora audiovisual"
  descripcion="Dial Estudio: documental, cobertura y eventos para organizaciones, con la mirada del medio Dial. Contamos, y medimos, el encuentro humano."
>
  <!-- PORTADA -->
  <section class="heroe tema-carbon grano">
    <div class="heroe-grid">
      <div class="heroe-texto contenedor-izq">
        <p class="heroe-logo"><Logo tono="claro" linea="estudio" titulo="Dial Estudio" /></p>
        <p class="kicker">Productora audiovisual · {sitio.ciudad}</p>
        <h1 class="display heroe-titulo">Contamos, <em>y medimos,</em> el encuentro humano.</h1>
        <p class="lead heroe-bajada">
          Documentales, coberturas y eventos para organizaciones sociales, culturales y de cooperación. Los hace el mismo equipo de Dial, con imagen, sonido y música original propios.
        </p>
        <div class="acciones">
          <a href="/contacto" class="btn">Cotiza tu proyecto <span class="flecha">→</span></a>
          <a href="#trabajo" class="btn linea">Ver trabajo</a>
        </div>
      </div>
      <div class="heroe-marca" aria-hidden="true">
        <Simbolo tono="claro" anima class="heroe-simbolo" />
      </div>
    </div>
    <div class="lugares">
      <p class="rotulo">Hemos filmado en</p>
      <ul>{lugares.map((l) => <li>{l}</li>)}</ul>
    </div>
  </section>

  <!-- MOSAICO -->
  <section class="seccion tema-papel mosaico-sec">
    <div class="contenedor">
      <header class="mosaico-cabeza">
        <p class="kicker">Dónde trabajamos</p>
        <h2 class="display d-2">Del set al <em>territorio.</em></h2>
        <p class="bajada">Hemos grabado en estudio, en la calle, en plazas y en zonas rurales, con un equipo pequeño que cubre imagen, sonido y edición.</p>
      </header>
      <div class="mosaico">
        <figure class="m-a"><Image src={palenque} alt="Calle de San Basilio de Palenque, con casas de colores" widths={[640, 1000, 1600]} sizes="(min-width: 980px) 58vw, 100vw" /><figcaption>San Basilio de Palenque, Bolívar · Foto: Martín Perea</figcaption></figure>
        <a href="https://youtu.be/tt3X0UynmCk" target="_blank" rel="noopener" class="m-b"><figure><Image src={liveSession} alt="Saxofonista y guitarrista tocando en una sesión en vivo" widths={[480, 800, 1280]} sizes="(min-width: 980px) 38vw, 100vw" /><figcaption>In-Vitro Live Sessions · Ver la sesión ↗</figcaption></figure></a>
        <figure class="m-c"><Image src={congreso} alt="Plenaria en el Capitolio Nacional vista desde el balcón" widths={[480, 800, 1280]} sizes="(min-width: 980px) 30vw, 100vw" /><figcaption>Capitolio Nacional, Bogotá · Generación de noticias</figcaption></figure>
        <a href="https://www.youtube.com/watch?v=1PCgmrlsKUQ" target="_blank" rel="noopener" class="m-d"><figure><Image src={feoPalante} alt="Retrato en blanco y negro de un cantante con gafas oscuras" widths={[480, 800, 1280]} sizes="(min-width: 980px) 30vw, 100vw" /><figcaption>Delayn Núñez, «Feo Palante» · Videoclip ↗</figcaption></figure></a>
        <a href="https://youtu.be/6DZmq3vevQ4" target="_blank" rel="noopener" class="m-e"><figure><Image src={dragon} alt="Un dragón animado sobre las rocas, junto al mar" widths={[480, 800, 1280]} sizes="(min-width: 980px) 30vw, 100vw" /><figcaption>Shadow Of The Dragon · Diseño sonoro y música ↗</figcaption></figure></a>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="seccion tema-hueso" id="servicios">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">Qué hacemos</p>
          <h2 class="display d-2">Historias para organizaciones que <em>transforman.</em></h2>
        </div>
        <p class="texto-2">Para ONG, fundaciones, cooperación internacional, universidades, entidades culturales y marcas con propósito. Cada proyecto se cotiza a la medida.</p>
      </header>
      <ol class="servicios">
        {
          servicios.map((s, i) => (
            <li>
              <a href={`/${s.data.linea}#${s.id}`} class="servicio">
                <span class="servicio-n">{dos(i + 1)}</span>
                <span class="rotulo">{s.data.linea === 'impacto' ? 'Impacto' : 'Encuentros'}</span>
                <span class="titular t-2">{s.data.titulo}</span>
                {s.data.gancho && <span class="gancho servicio-gancho">{s.data.gancho}</span>}
                <span class="servicio-resumen">{s.data.resumen}</span>
                <span class="servicio-entrega">{s.data.entregables.join(' · ')}</span>
                <span class="servicio-mas">Ver el servicio <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- MEDICIÓN -->
  <section class="seccion tema-carbon grano medicion">
    <div class="contenedor medicion-grid">
      <div class="medicion-texto">
        <p class="kicker">Pieza + medición</p>
        <h2 class="display d-2">Del ruido a la señal, <em>con datos.</em></h2>
        <p class="lead texto-2">
          Encuestamos a la audiencia antes y después de ver la pieza. Tu organización sabe qué cambió y lo puede reportar. Lo probamos
          primero en casa: en los debates de Dial preguntamos a la sala al entrar y al salir.
        </p>
        <a href="/impacto/medicion" class="enlace">Cómo medimos <span>→</span></a>
      </div>
      <EscalaMedicion />
    </div>
  </section>

  <!-- TRABAJO -->
  <section class="seccion tema-papel" id="trabajo">
    <div class="contenedor">
      <header class="seccion-cabeza"><h2>Trabajo</h2><a href="/impacto#portafolio" class="ver">Portafolio completo →</a></header>
      <div class:list={['trabajo', { impar: trabajo.length % 3 === 2, cuatro: trabajo.length === 4 }]}>
        {
          trabajo.map((t, i) => (
            <article class:list={['obra', { grande: i === 0 }]}>
              <VideoLite video={t.video} titulo={t.titulo} />
              <p class="rotulo">{t.rotulo}</p>
              <h3 class:list={['titular', i === 0 ? 't-2' : 't-3']}>{t.href ? <a href={t.href}>{t.titulo}</a> : t.titulo}</h3>
              <p class="datos"><span>{t.meta}</span></p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SINTONÍA: el medio respalda al estudio -->
  <section class="seccion compacta tema-carbon grano sintonia">
    <div class="contenedor sintonia-grid">
      <div>
        <p class="kicker">Dial</p>
        <h2 class="display d-3">Un medio detrás del <em>estudio.</em></h2>
      </div>
      <div class="sintonia-texto">
        <p>
          Dial publica cada semana noticias, podcast, documentales y debates. El Estudio trabaja con ese mismo equipo, y lo que gana ayuda a sostener el medio.
        </p>
        <div class="acciones">
          <a href="/" class="btn linea">Conoce el medio</a>
          <a href="/encuentros" class="btn linea">Dial Encuentros: eventos</a>
        </div>
      </div>
    </div>
    <div class="contenedor"><Sintonizador /></div>
  </section>

  <!-- MÚSICA ORIGINAL -->
  <section class="seccion compacta tema-hueso musica">
    <div class="contenedor musica-grid">
      <a href={DISCO} target="_blank" rel="noopener" class="musica-portada">
        <Image src={disco} alt="Arte del disco In-Vitro" widths={[480, 800, 1280]} sizes="(min-width: 980px) 50vw, 100vw" />
        <span class="musica-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg></span>
      </a>
      <div class="musica-texto">
        <p class="kicker">Música original</p>
        <h2 class="display d-2">La música la <em>componemos</em> en casa.</h2>
        <p class="lead texto-2">
          Componemos la música de cada pieza en lugar de usar bancos de sonido. <em>In-Vitro</em> es el disco de Martín Perea Tobón, director de Dial,
          y sus sesiones en vivo se grabaron y filmaron en nuestro propio espacio.
        </p>
        <div class="acciones">
          <a href={DISCO} class="btn" target="_blank" rel="noopener">Escuchar el disco <span class="flecha">↗</span></a>
          <a href="https://youtu.be/tt3X0UynmCk" class="btn linea" target="_blank" rel="noopener">Ver las sesiones en vivo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="seccion compacta tema-papel">
    <div class="contenedor">
      <header class="seccion-cabeza"><h2>Cómo trabajamos</h2><a href="/estudio/como-trabajamos" class="ver">Equipo y capacidades →</a></header>
      <ol class="proceso">
        {
          cap.proceso.map((p, i) => (
            <li>
              <span class="proc-n">{dos(i + 1)}</span>
              <h3 class="sub s-2">{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <p class="una-persona">Hablas con una sola persona durante todo el proyecto. La historia no cambia de manos.</p>
    </div>
  </section>

  <CTAFinal mensajeWhatsapp="Hola, Martín. Vi la página de Dial Estudio y quiero cotizar un proyecto." />
</Base>

<style>
  /* ---------- Portada: texto a la izquierda, foto a sangre a la derecha ---------- */
  .heroe { position: relative; overflow: hidden; }
  .heroe-grid { display: grid; }
  .contenedor-izq { padding-inline: var(--gutter); }
  .heroe-texto { display: grid; gap: 22px; justify-items: start; align-content: center; padding-block: clamp(40px, 6vw, 88px); position: relative; z-index: 1; }
  .heroe-logo { margin: 0; font-size: clamp(40px, 4.4vw, 60px); }
  .heroe-titulo { font-size: clamp(2.8rem, 1.2rem + 4.4vw, 5.6rem); line-height: .96; max-width: 11ch; }
  .heroe-bajada { margin: 0; color: var(--hueso-2); max-width: 44ch; }
  .heroe-marca { display: grid; place-items: center; padding: 0 var(--gutter) clamp(40px, 6vw, 64px); }
  .heroe :global(.heroe-simbolo) { width: min(64vw, 440px); height: auto; }
  @media (min-width: 1000px) {
    .heroe-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); min-height: min(78vh, 760px); }
    .contenedor-izq { padding-left: max(var(--gutter), calc((100vw - var(--ancho)) / 2)); padding-right: 48px; }
    .heroe-marca { padding: 0 max(var(--gutter), calc((100vw - var(--ancho)) / 2)) 0 0; justify-items: center; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .heroe-texto { animation: aparece .9s var(--ease) both; }
  }
  @keyframes aparece { from { opacity: 0; transform: translateY(10px); } }
  @keyframes revela { from { opacity: 0; transform: scale(1.04); } }

  .lugares { border-top: 1px solid var(--linea-clara); padding: 18px var(--gutter); display: flex; flex-wrap: wrap; gap: 10px 24px; align-items: baseline; position: relative; z-index: 1; }
  @media (min-width: 1000px) { .lugares { padding-inline: max(var(--gutter), calc((100vw - var(--ancho)) / 2)); } }
  .lugares .rotulo { color: var(--hueso-2); margin: 0; }
  .lugares ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 0; }
  .lugares li { font-family: var(--f-display); font-size: 1.25rem; line-height: 1.2; }
  .lugares li + li::before { content: '·'; margin: 0 .55em; color: var(--luz); }

  /* ---------- Mosaico ---------- */
  .mosaico-cabeza { display: grid; gap: 16px; max-width: 60ch; margin-bottom: clamp(32px, 4vw, 56px); }
  .mosaico-cabeza p { margin: 0; }
  .mosaico { display: grid; gap: 12px; }
  .mosaico figure { margin: 0; position: relative; overflow: hidden; background: var(--carbon-2); height: 100%; }
  .mosaico > a { display: block; text-decoration: none; color: inherit; }
  .mosaico img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s var(--ease); }
  .mosaico figure:hover img { transform: scale(1.03); }
  .mosaico figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 14px 10px;
    font-size: .78rem; color: var(--papel); background: linear-gradient(0deg, rgba(20, 17, 15, .72), transparent);
  }
  .mosaico > figure, .mosaico > a { aspect-ratio: 3 / 2; }
  @media (min-width: 980px) {
    .mosaico { grid-template-columns: repeat(12, 1fr); grid-auto-rows: clamp(150px, 15vw, 210px); }
    .mosaico > figure, .mosaico > a { aspect-ratio: auto; }
    .m-a { grid-column: 1 / span 7; grid-row: span 2; }
    .m-b { grid-column: 8 / span 5; grid-row: span 2; }
    .m-c, .m-d, .m-e { grid-column: span 4; grid-row: span 2; }
  }

  /* ---------- Servicios ---------- */
  .servicios { list-style: none; display: grid; gap: 1px; background: var(--linea); border: 1px solid var(--linea); }
  @media (min-width: 760px) { .servicios { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .servicios { grid-template-columns: repeat(3, 1fr); } }
  .servicio {
    display: grid; gap: 12px; align-content: start; height: 100%;
    padding: clamp(22px, 2.4vw, 32px); background: var(--fibra); text-decoration: none;
    transition: background .3s var(--ease);
  }
  .servicio:hover { background: var(--papel); }
  .servicio-n { font-family: var(--f-display); font-style: italic; font-size: 2rem; line-height: 1; color: var(--texto-2); }
  .servicio-gancho { font-size: 1.15rem; }
  .servicio-resumen { font-size: .98rem; color: var(--tinta-2); line-height: 1.5; }
  .servicio-entrega { font-size: .82rem; color: var(--texto-2); border-top: 1px solid var(--linea); padding-top: 12px; }
  .servicio-mas { font-weight: 600; font-size: .92rem; margin-top: 4px; }
  .servicio:hover .servicio-mas { color: var(--terracota-ink); }

  /* ---------- Medición ---------- */
  .medicion { position: relative; }
  .medicion-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 980px) { .medicion-grid { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
  .medicion-texto { display: grid; gap: 20px; justify-items: start; }
  .medicion-texto p { margin: 0; }

  /* ---------- Trabajo ---------- */
  .trabajo { display: grid; gap: 40px 28px; }
  @media (min-width: 760px) { .trabajo { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .trabajo { grid-template-columns: repeat(3, 1fr); } .obra.grande { grid-column: span 2; grid-row: span 2; }
    .trabajo.impar .obra.grande { grid-row: auto; }
    .trabajo.cuatro { grid-template-columns: repeat(2, 1fr); }
    .trabajo.cuatro .obra.grande { grid-column: auto; grid-row: auto; }
    .trabajo.cuatro .obra h3 { font-size: clamp(1.7rem, 1.2rem + 1.4vw, 2.35rem); } }
  .obra { display: grid; gap: 10px; align-content: start; }
  .obra .rotulo { margin-top: 6px; }
  .obra h3 a { text-decoration: none; }
  .obra .datos { font-size: .84rem; }

  /* ---------- Proceso ---------- */
  .proceso { list-style: none; display: grid; gap: 28px 32px; counter-reset: p; }
  @media (min-width: 760px) { .proceso { grid-template-columns: repeat(3, 1fr); } }
  .proceso li { display: grid; gap: 8px; align-content: start; border-top: 1px solid var(--carbon); padding-top: 14px; }
  .proceso p { margin: 0; color: var(--tinta-2); font-size: .98rem; }
  .proc-n { font-family: var(--f-display); font-size: 2.4rem; line-height: 1; color: var(--luz); }
  .una-persona { margin: 40px 0 0; font-family: var(--f-serif); font-style: italic; font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); line-height: 1.2; max-width: 30ch; }

  /* ---------- Música original ---------- */
  .musica { position: relative; }
  .musica-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 980px) { .musica-grid { grid-template-columns: 1.1fr 1fr; gap: 72px; } }
  .musica-portada { position: relative; display: block; overflow: hidden; aspect-ratio: 16 / 9; }
  .musica-portada img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .musica-portada:hover img { transform: scale(1.03); }
  .musica-play { position: absolute; left: 50%; top: 50%; width: 72px; height: 72px; margin: -36px 0 0 -36px; border-radius: 50%; background: var(--luz); color: var(--papel); display: grid; place-items: center; }
  .musica-play svg { width: 28px; height: 28px; margin-left: 3px; }
  .musica-texto { display: grid; gap: 20px; justify-items: start; }
  .musica-texto p { margin: 0; }

  /* ---------- Sintonía ---------- */
  .sintonia { position: relative; }
  .sintonia-grid { display: grid; gap: 28px; align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
  @media (min-width: 980px) { .sintonia-grid { grid-template-columns: 1fr 1fr; gap: 72px; } }
  .sintonia-grid .kicker { margin-bottom: 16px; }
  .sintonia-texto { display: grid; gap: 20px; }
  .sintonia-texto p { margin: 0; color: var(--hueso-2); }
</style>
