---
/**
 * Portada de Dial Medio, la productora (marca v6, 18 nov 2026). Dial dejó de presentarse como medio de
 * comunicación: «medio» es el punto medio. Héroe con fotogramas propios en formato ancho, servicios, trabajo,
 * lo que nos distingue y la casa (Fototoma en la música, RED Quynza en la investigación).
 * Nada de clientes ni cifras inventadas.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoLite from '../components/VideoLite.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Sintonizador from '../components/Sintonizador.astro';
import { dos, anio } from '../lib/util';
import { rutaVideo } from '../lib/medio';

import palenque from '../assets/estudio/palenque.jpg';
import liveSession from '../assets/estudio/live-session.jpg';
import feoPalante from '../assets/estudio/feo-palante.jpg';
import disco from '../assets/estudio/in-vitro-disco.jpg';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);

// Trabajo: la sesión en vivo primero (sonido e imagen en casa), luego la obra propia y las muestras de oficio.
// Currulao no va aquí: su miniatura es una foto que no es de Dial (Martín, 1 nov 2026).
const propios = (await getCollection('medio', (m) => !m.data.borrador && m.data.mostrarEnImpacto && !!m.data.video && m.id !== 'currulao-musicas-del-pacifico-sur'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((m) => ({ titulo: m.data.titulo, video: m.data.video!, href: rutaVideo(m), rotulo: 'Documental', meta: `${m.data.lugar} · ${anio(m.data.fecha)}` }));
const muestras = (await getCollection('muestras', (m) => !m.data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((m) => ({ titulo: m.data.titulo, video: m.data.video, href: undefined, rotulo: m.data.disciplinas.join(' · '), meta: `${m.data.rol.replace(/\.$/, '')} · ${m.data.anio}` }));
const sesion = { titulo: 'In-Vitro Live Sessions', video: { plataforma: 'youtube' as const, id: 'tt3X0UynmCk' }, href: 'https://youtu.be/tt3X0UynmCk', rotulo: 'Sesión en vivo · Imagen y sonido', meta: 'Bogotá' };
const trabajo = [sesion, ...propios, ...muestras].slice(0, 5);

const fotogramas = [
  { src: palenque, alt: 'Calle de San Basilio de Palenque, con casas de colores', lugar: 'San Basilio de Palenque', autor: 'Foto de Martín Perea' },
  { src: liveSession, alt: 'Saxofonista y guitarrista tocando en una sesión en vivo', lugar: 'In-Vitro Live Sessions', autor: 'Bogotá' },
  { src: feoPalante, alt: 'Retrato en blanco y negro de un cantante con gafas oscuras', lugar: 'Delayn Núñez, «Feo Palante»', autor: 'Videoclip' },
];

const distintos = [
  { titulo: 'Música original', texto: 'Fototoma, nuestra productora hermana, compone la música y hace el diseño sonoro de cada pieza. No usamos bancos de música.' },
  { titulo: 'Investigación antes del rodaje', texto: 'La RED Quynza, una red de profesores e investigadores, revisa el contexto, las cifras y las fuentes antes de filmar.' },
  { titulo: 'Acceso al territorio', texto: 'Los nodos de la RED nos presentan con la gente en regiones donde una productora de Bogotá llega como extraña. Vamos con un equipo pequeño.' },
  { titulo: 'Kit de circulación', texto: 'Cada pieza sale con cortes verticales, subtítulos en español e inglés, miniaturas y un carrusel con los datos.' },
  { titulo: 'Informe de recepción', texto: 'Después del estreno te entregamos lo que pasó con la pieza: vistas, retención y una lectura de lo que dijo la gente.' },
];
---

<Base
  titulo="Dial Medio · Productora audiovisual"
  descripcion="Dial Medio es una productora audiovisual de Bogotá: publicidad, videoclips, eventos y documental, con la investigación de la RED Quynza y la música original de Fototoma."
  portada
>
  <!-- HÉROE: fotogramas a sangre con bandas de cine arriba y abajo -->
  <section class="heroe tema-carbon grano">
    <div class="cuadros">
      {
        fotogramas.map((f, i) => (
          <figure class="cuadro" style={`--i:${i}`}>
            <Image src={f.src} alt={i === 0 ? f.alt : ''} widths={[800, 1400, 2200]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
            <figcaption class="credito"><b>{f.lugar}</b><span>{f.autor}</span></figcaption>
          </figure>
        ))
      }
    </div>
    <div class="contenedor heroe-texto">
      <p class="kicker">Productora audiovisual · Bogotá</p>
      <h1 class="display heroe-titulo">Investigamos antes de <em>filmar.</em></h1>
      <p class="lead heroe-bajada">
        Hacemos publicidad, videoclips, eventos y documental. La investigación la hacemos con la RED Quynza y la música la compone Fototoma, nuestra productora hermana.
      </p>
      <div class="acciones">
        <a href="/contacto" class="btn">Cotiza tu proyecto <span class="flecha">→</span></a>
        <a href="/trabajo" class="btn linea">Ver el trabajo</a>
      </div>
    </div>
  </section>

  <!-- EL PUNTO MEDIO -->
  <section class="seccion tema-papel punto">
    <div class="contenedor punto-grid">
      <div data-revela>
        <p class="kicker">Por qué Dial Medio</p>
        <h2 class="display d-2">El punto <em>medio.</em></h2>
      </div>
      <div class="punto-texto" data-revela style="--retraso:.1s">
        <p class="lead-xl">Un dial se mueve hasta encontrar la señal. En nuestro nombre, <em>medio</em> es ese punto.</p>
        <p class="texto-2">
          Trabajamos con empresas, entidades públicas, organizaciones sociales y artistas de todas las orillas. En cada proyecto buscamos el lugar desde donde
          la historia se puede contar con datos verificados y sin caricaturas, para que la entienda quien está de acuerdo y también quien no.
        </p>
      </div>
    </div>
    <div class="contenedor"><Sintonizador frecuencia={1110} /></div>
  </section>

  <!-- SERVICIOS -->
  <section class="seccion tema-carbon grano" id="servicios">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">Qué hacemos</p>
          <h2 class="display d-2">Del comercial al <em>documental.</em></h2>
        </div>
        <p class="texto-2" data-revela>Cada proyecto se cotiza a la medida. Hablas con una sola persona de principio a fin.</p>
      </header>
      <ol class="servicios">
        {
          servicios.map((s, i) => (
            <li data-revela style={`--retraso:${i * 0.04}s`}>
              <a href={`/servicios#${s.id}`} class="servicio">
                <span class="servicio-n">{dos(i + 1)}</span>
                <span class="titular t-2">{s.data.titulo}</span>
                {s.data.gancho && <span class="gancho servicio-gancho">{s.data.gancho}</span>}
                <span class="servicio-para">{s.data.paraQuien}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="mas"><a href="/servicios" class="enlace">Todos los servicios <span>→</span></a></p>
    </div>
  </section>

  <!-- TRABAJO -->
  <section class="seccion tema-papel" id="trabajo">
    <div class="contenedor">
      <header class="seccion-cabeza"><h2>Trabajo</h2><a href="/trabajo" class="ver">Todo el trabajo →</a></header>
      <div class="obras">
        {
          trabajo.map((t, i) => (
            <article class:list={['obra', { grande: i === 0 }]} data-revela>
              <VideoLite video={t.video} titulo={t.titulo} />
              <p class="rotulo">{t.rotulo}</p>
              <h3 class:list={['titular', i === 0 ? 't-2' : 't-3']}>{t.href ? <a href={t.href}>{t.titulo}</a> : t.titulo}</h3>
              <p class="datos"><span>{t.meta}</span></p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- LO QUE NOS DISTINGUE -->
  <section class="seccion tema-hueso">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">Lo que nos distingue</p>
          <h2 class="display d-2">Lo que no se <em>alquila.</em></h2>
        </div>
        <p class="texto-2" data-revela>Las cámaras se consiguen por proyecto. Esto viene con nosotros.</p>
      </header>
      <ol class="numerada">
        {
          distintos.map((d) => (
            <li data-revela>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- LA CASA: Fototoma y RED Quynza -->
  <section class="seccion tema-carbon grano casa">
    <div class="contenedor">
      <header class="cabeza" data-revela>
        <p class="kicker">La casa</p>
        <h2 class="display d-2">Imagen, sonido e <em>investigación.</em></h2>
      </header>
      <div class="casa-grid">
        <article class="casa-pieza" data-revela>
          <a href="https://fototomaproducciones.com" target="_blank" rel="noopener" class="fotograma r-16-9 casa-foto">
            <Image src={disco} alt="Arte del disco In-Vitro" widths={[640, 1000, 1400]} sizes="(min-width: 980px) 50vw, 100vw" />
          </a>
          <p class="rotulo">Música y sonido</p>
          <h3 class="titular t-2">Fototoma</h3>
          <p class="texto-2">
            La productora de música de Martín Perea, Santiago García y Juan Rizoma. Compone, graba y mezcla la música y el sonido de las piezas de Dial, y trabaja
            también para cine, publicidad y videojuegos.
          </p>
          <a href="https://fototomaproducciones.com" class="enlace" target="_blank" rel="noopener">fototomaproducciones.com <span>↗</span></a>
        </article>
        <article class="casa-pieza" data-revela style="--retraso:.1s">
          <div class="casa-red" aria-hidden="true">
            <p class="cartela-mini">Una misma pregunta en Bogotá, en los nodos de la RED y en el campo. Al final, lo que dicen las cifras.</p>
            <p class="rotulo">En preparación · Preguntas en la calle</p>
          </div>
          <p class="rotulo">Investigación</p>
          <h3 class="titular t-2">RED Quynza</h3>
          <p class="texto-2">
            Una red académica de profesores e investigadores con nodos en varias regiones. Revisa el contexto y los datos de cada proyecto, nos abre la puerta en
            los territorios y coproduce con Dial el podcast <em>Lo que la gente quiere es vivir</em>.
          </p>
          <a href="/investigacion" class="enlace">Cómo investigamos <span>→</span></a>
        </article>
      </div>
    </div>
  </section>

  <CTAFinal
    titulo="¿Qué historia quieres contar?"
    texto="Cuéntanos qué necesitas, para quién y para cuándo. Te respondemos con una propuesta a la medida."
    mensajeWhatsapp="Hola, Martín. Vi la página de Dial Medio y quiero cotizar un proyecto."
  />
</Base>

<style>
  /* ---------- Héroe: fotogramas que se funden, bandas de cine ---------- */
  .heroe { position: relative; min-height: 100svh; display: grid; align-items: end; background: #0f0d0c; overflow: hidden; }
  .cuadros { position: absolute; inset: clamp(68px, 9vh, 96px) 0 clamp(28px, 7vh, 72px); }
  .cuadro { position: absolute; inset: 0; margin: 0; opacity: 0; animation: funde 21s infinite; animation-delay: calc(var(--i) * 7s); }
  .cuadro:first-child { opacity: 1; }
  .cuadro img { width: 100%; height: 100%; object-fit: cover; animation: acerca 21s infinite linear; animation-delay: calc(var(--i) * 7s); }
  .cuadro::after { content: ''; position: absolute; inset: 0; background:
    linear-gradient(0deg, rgba(15, 13, 12, .9) 0%, rgba(15, 13, 12, .2) 50%, rgba(15, 13, 12, 0) 100%),
    linear-gradient(90deg, rgba(15, 13, 12, .82) 0%, rgba(15, 13, 12, .5) 38%, rgba(15, 13, 12, 0) 70%); }
  @media (max-width: 760px) { .cuadro::after { background: linear-gradient(0deg, rgba(15, 13, 12, .95) 0%, rgba(15, 13, 12, .6) 55%, rgba(15, 13, 12, .15) 100%); } }
  .cuadro .credito { position: absolute; right: var(--gutter); bottom: 14px; z-index: 2; color: rgba(244, 238, 229, .75); margin: 0; }
  @keyframes funde { 0% { opacity: 0; } 6% { opacity: 1; } 33% { opacity: 1; } 39% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes acerca { from { transform: scale(1); } to { transform: scale(1.08); } }
  @media (prefers-reduced-motion: reduce) {
    .cuadro, .cuadro img { animation: none; }
    .cuadro:not(:first-child) { display: none; }
  }
  .heroe-texto { position: relative; z-index: 2; display: grid; gap: 22px; justify-items: start; padding-bottom: clamp(72px, 13vh, 140px); }
  .heroe-titulo { font-size: clamp(3rem, 1.3rem + 5.6vw, 7rem); line-height: .94; max-width: 12ch; }
  .heroe-bajada { margin: 0; color: var(--hueso-2); max-width: 46ch; }
  @media (prefers-reduced-motion: no-preference) { .heroe-texto { animation: aparece 1.1s var(--ease) both .2s; } }
  @keyframes aparece { from { opacity: 0; transform: translateY(12px); } }

  /* ---------- Punto medio ---------- */
  .punto-grid { display: grid; gap: 28px 72px; margin-bottom: clamp(40px, 5vw, 72px); }
  @media (min-width: 980px) { .punto-grid { grid-template-columns: 1fr 1.3fr; align-items: end; } }
  .punto-texto { display: grid; gap: 20px; }
  .punto-texto p { margin: 0; max-width: 56ch; }

  /* ---------- Servicios ---------- */
  .servicios { list-style: none; display: grid; gap: 1px; background: var(--linea-clara); border: 1px solid var(--linea-clara); }
  @media (min-width: 760px) { .servicios { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .servicios { grid-template-columns: repeat(3, 1fr); } }
  .servicios li { display: grid; }
  .servicio { display: grid; gap: 12px; align-content: start; padding: clamp(24px, 2.6vw, 36px); background: var(--carbon); text-decoration: none; transition: background .3s var(--ease); }
  .servicio:hover { background: var(--carbon-2); }
  .servicio-n { font-family: var(--f-display); font-style: italic; font-size: 1.6rem; line-height: 1; color: var(--terracota-clara); }
  .servicio-gancho { font-size: 1.12rem; color: var(--hueso-2); }
  .servicio-para { font-size: .86rem; color: var(--hueso-2); border-top: 1px solid var(--linea-clara); padding-top: 12px; margin-top: 6px; }
  .mas { margin: 32px 0 0; }

  /* ---------- Trabajo ---------- */
  .obras { display: grid; gap: 40px 28px; }
  @media (min-width: 760px) { .obras { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .obras { grid-template-columns: repeat(3, 1fr); } .obra.grande { grid-column: span 2; grid-row: span 2; } }
  .obra { display: grid; gap: 10px; align-content: start; }
  .obra .rotulo { margin-top: 6px; }
  .obra h3 a { text-decoration: none; }

  /* ---------- La casa ---------- */
  .casa-grid { display: grid; gap: 56px 48px; }
  @media (min-width: 980px) { .casa-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .casa-pieza { display: grid; gap: 14px; align-content: start; justify-items: start; min-width: 0; }
  .casa-pieza > .casa-foto, .casa-pieza > .casa-red { justify-self: stretch; }
  .casa-pieza p { margin: 0; }
  .casa-foto { width: 100%; display: block; }
  .casa-foto img { transition: transform 1.2s var(--ease); }
  .casa-foto:hover img { transform: scale(1.03); }
  .casa-red { width: 100%; min-height: clamp(240px, 26vw, 360px); display: grid; align-content: space-between; padding: clamp(22px, 3vw, 40px); background: #0f0d0c; border: 1px solid var(--linea-clara); }
  .cartela-mini { font-family: var(--f-display); font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem); line-height: 1.08; max-width: 20ch; }
</style>
