---
/**
 * Portada de Dial Medio, la productora (marca v6, 18 nov 2026). Héroe de fotogramas a sangre que alterna lo
 * documental y lo comercial, el dial como cartela (Martín: no explicar «medio», lo importante es el dial y los
 * servicios), pantalla partida para los dos públicos, campañas completas (el diferencial que Martín quiere
 * resaltar), servicios con imagen, trabajo, lo que nos distingue y la casa.
 * Las fotos de ambiente son libres (src/lib/cine.ts) y nunca se presentan como trabajo de Dial.
 * Nada de clientes ni cifras inventadas.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoLite from '../components/VideoLite.astro';
import CTAFinal from '../components/CTAFinal.astro';
import DialServicios from '../components/DialServicios.astro';
import CarruselMuestra from '../components/CarruselMuestra.astro';
import { CARRUSELES, carrusel } from '../lib/muestras';
import { dos, anio } from '../lib/util';
import { rutaVideo } from '../lib/medio';

import disco from '../assets/estudio/in-vitro-disco.jpg';
import { FOTOS, FOTO_SERVICIO, credito } from '../lib/cine';
import { OBRA } from '../lib/obra';
import { rutaServicio } from '../lib/servicios';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);

// Trabajo (Martín, 19 nov 2026): Mongolia es la principal (grande, 2×2) y alrededor lo mejor: In-Vitro en vivo,
// Feo Palante, los dos debates y el jazz. Currulao no va: su miniatura es una foto que no es de Dial (1 nov 2026).
const muestras = Object.fromEntries((await getCollection('muestras', (m) => !m.data.borrador)).map((m) => [m.id, m]));
const deMuestra = (id: string) => {
  const m = muestras[id];
  return { titulo: m.data.titulo, video: m.data.video, href: undefined, rotulo: m.data.disciplinas.join(' · '), meta: `${m.data.rol.replace(/\.$/, '')} · ${m.data.anio}` };
};
const medio = Object.fromEntries((await getCollection('medio', (m) => !m.data.borrador && !!m.data.video)).map((m) => [m.id, m]));
const deMedio = (id: string, rotulo: string) => {
  const m = medio[id];
  return { titulo: m.data.titulo, video: m.data.video!, href: rutaVideo(m), rotulo, meta: [m.data.lugar, anio(m.data.fecha)].filter(Boolean).join(' · ') };
};
const sesion = { titulo: 'In-Vitro, sesión en vivo', video: { plataforma: 'youtube' as const, id: 'L84B5ZGakjY' }, href: 'https://youtu.be/L84B5ZGakjY', rotulo: 'Sesión en vivo · Imagen y sonido', meta: 'Música del disco In-Vitro · 2026' };
const trabajo = [
  deMuestra('mongolia'),
  sesion,
  deMuestra('videoclip-feo-palante'),
  deMedio('debate-mano-dura', 'Debate'),
  deMedio('historia-del-jazz-colombiano', 'Documental'),
  deMedio('debate-proyecto-de-pais', 'Debate'),
];

// Mosaico de campañas: imagen propia (src/lib/obra.ts), nada de stock. [clase, foto o carrusel, tamaño]
const mosaico = [
  ['cm-a', OBRA.inVitroVivo, 'grande'],
  ['cm-b', OBRA.feoPalante, 'chica'],
  ['cm-c', 'carrusel', 'chica'],
  ['cm-d', OBRA.palenque, 'chica'],
  ['cm-e', OBRA.mongolia, 'chica'],
  ['cm-f', OBRA.mangorito, 'chica'],
] as const;

// Héroe: documental y comercial intercalados, seis fotogramas de 6 s.
const fotogramas = [FOTOS.paramoFigura, FOTOS.camaraLuz, FOTOS.retratoAndino, FOTOS.setAzul, FOTOS.palmasNiebla, FOTOS.concierto];

// Campañas se ilustra con carruseles propios (los eligió Martín, src/lib/muestras.ts).
const laminas = ['quintin-lame', 'museo-nacional', 'tina-modotti'].map((id) => carrusel(id).laminas[0]);
const CORTO: Record<string, string> = { documental: 'Documental', diseno: 'Campañas', publicidad: 'Publicidad', musica: 'Videoclips', eventos: 'Eventos', divulgacion: 'Divulgación', retratos: 'Retratos' };
const dialServicios = servicios.map((s) => ({ id: s.id, titulo: s.data.titulo, corto: CORTO[s.id] ?? s.data.titulo, gancho: s.data.gancho, href: rutaServicio(s) }));
const ruta = Object.fromEntries(servicios.map((s) => [s.id, rutaServicio(s)]));

const publicos = [
  {
    id: 'marcas',
    kicker: 'Para marcas y artistas',
    titulo: 'Imagen de cine para lo que <em>haces.</em>',
    texto: 'Campañas completas, comerciales, videoclips y sesiones en vivo. La música la compone Fototoma para cada pieza.',
    foto: FOTOS.setRodaje,
    enlaces: ['diseno', 'publicidad', 'musica'],
  },
  {
    id: 'organizaciones',
    kicker: 'Para organizaciones e instituciones',
    titulo: 'Historias con <em>contexto.</em>',
    texto: 'Documental, divulgación de investigación y eventos, con la investigación de la RED Quynza detrás.',
    foto: FOTOS.ancianaColina,
    enlaces: ['documental', 'divulgacion', 'eventos'],
  },
];
const nombre = Object.fromEntries(servicios.map((s) => [s.id, s.data.titulo]));

const campana = {
  para: ['Marcas sociales y con propósito', 'Restaurantes y cafés', 'Cultura y artistas', 'Empresas e instituciones'],
  pasos: [
    { titulo: 'Concepto y mensaje', texto: 'Qué quiere decir la marca, a quién y con qué tono. Si hay datos, se verifican.' },
    { titulo: 'Rodaje', texto: 'El spot, los cortes verticales y las fotos, con imagen de cine y música de Fototoma.' },
    { titulo: 'Diseño', texto: 'Carruseles, afiches, cartas, infografías y plantillas para que la marca se vea igual en todas partes.' },
    { titulo: 'Publicación e informe', texto: 'Un calendario para publicar y, al final, lo que pasó: alcance, respuesta y lo que dijo la gente.' },
  ],
};

const distintos = [
  { titulo: 'Música original', texto: 'Fototoma, nuestra productora hermana, compone la música y hace el diseño sonoro de cada pieza. No usamos bancos de música.' },
  { titulo: 'Investigación antes del rodaje', texto: 'La RED Quynza, una red de profesores e investigadores, revisa el contexto, las cifras y las fuentes antes de filmar.' },
  { titulo: 'Acceso al territorio', texto: 'Los nodos de la RED nos presentan con la gente en regiones donde una productora de Bogotá llega como extraña. Vamos con un equipo pequeño.' },
  { titulo: 'Kit de circulación', texto: 'Cada pieza sale con cortes verticales, subtítulos en español e inglés, miniaturas y un carrusel con los datos.' },
  { titulo: 'Informe de recepción', texto: 'Después del estreno te entregamos lo que pasó con la pieza: vistas, retención y una lectura de lo que dijo la gente.' },
];
---

<Base
  titulo="Dial Medio · Productora audiovisual en Bogotá"
  descripcion="Productora audiovisual en Bogotá: documentales, comerciales, videoclips, campañas para redes y cobertura de eventos, con investigación de la RED Quynza y música original de Fototoma."
  portada
>
  <!-- HÉROE: fotogramas a sangre, sin bandas -->
  <section class="heroe tema-carbon grano" data-parallax>
    <div class="cuadros" data-parallax-capa>
      {
        fotogramas.map((f, i) => (
          <figure class="cuadro" style={`--i:${i}`}>
            <Image src={f.src} alt={i === 0 ? f.alt : ''} widths={[800, 1400, 2200]} sizes="100vw" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} style={f.foco ? `object-position:${f.foco}` : undefined} />
            <figcaption class="credito">{credito(f)}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="contenedor heroe-texto">
      <p class="kicker">Productora audiovisual · Bogotá</p>
      <h1 class="display heroe-titulo">Investigamos antes de <em>filmar.</em></h1>
      <p class="lead heroe-bajada">
        Hacemos campañas, publicidad, videoclips, eventos y documental. La investigación la hacemos con la RED Quynza y la música la compone Fototoma, nuestra productora hermana.
      </p>
      <div class="acciones">
        <a href="/contacto" class="btn">Cotiza tu proyecto <span class="flecha">→</span></a>
        <a href="/trabajo" class="btn linea">Ver el trabajo</a>
      </div>
    </div>
    <ol class="heroe-conteo" aria-hidden="true">{fotogramas.map((_, i) => <li style={`--i:${i}`} />)}</ol>
  </section>

  <!-- EL DIAL: cartela sobre el páramo -->
  <section class="punto tema-carbon grano">
    <figure class="punto-foto" aria-hidden="true">
      <Image src={FOTOS.lagunaParamo.src} alt="" widths={[800, 1400, 2200]} sizes="100vw" />
      <figcaption class="credito">{credito(FOTOS.lagunaParamo)}</figcaption>
    </figure>
    <div class="contenedor punto-texto" data-revela>
      <p class="kicker">Dial Medio</p>
      <h2 class="display d-1">Encontramos la <em>señal.</em></h2>
      <p class="lead-xl">Como la aguja de un dial, buscamos la frecuencia en la que tu historia se escucha clara.</p>
    </div>
    <div class="contenedor punto-dial"><DialServicios servicios={dialServicios} /></div>
  </section>

  <!-- DOS PÚBLICOS: pantalla partida -->
  <section class="publicos" aria-label="Para quién trabajamos">
    {
      publicos.map((p) => (
        <article class:list={['publico', 'tema-carbon', p.id]}>
          <figure class="publico-foto" aria-hidden="true">
            <Image src={p.foto.src} alt="" widths={[700, 1100, 1600]} sizes="(min-width: 980px) 50vw, 100vw" style={p.foto.foco ? `object-position:${p.foto.foco}` : undefined} />
          </figure>
          <div class="publico-texto">
            <p class="kicker">{p.kicker}</p>
            <h2 class="display d-2" set:html={p.titulo} />
            <p class="texto-2">{p.texto}</p>
            <ul class="publico-enlaces">
              {p.enlaces.map((id) => <li><a href={ruta[id]}>{nombre[id]}<span aria-hidden="true">→</span></a></li>)}
            </ul>
          </div>
          <p class="credito publico-credito">{credito(p.foto)}</p>
        </article>
      ))
    }
  </section>

  <!-- CAMPAÑAS COMPLETAS: el diferencial -->
  <section class="seccion tema-carbon grano campana" id="campanas">
    <div class="contenedor campana-grid">
      <div class="campana-texto">
        <header data-revela>
          <p class="kicker">Campañas completas</p>
          <h2 class="display d-2">Del spot al último <em>post.</em></h2>
        </header>
        <p class="lead texto-2" data-revela>
          Armamos la campaña entera: el concepto, el video, las piezas para redes, los afiches y el calendario. Un solo equipo cuida que todo hable igual, con
          imagen de cine y música hecha para la marca.
        </p>
        <ul class="campana-para" data-revela>{campana.para.map((p) => <li>{p}</li>)}</ul>
        <ol class="numerada campana-pasos">{campana.pasos.map((p) => <li data-revela><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}</ol>
        <div class="acciones" data-revela>
          <a href="/contacto?servicio=diseno" class="btn">Cotiza tu campaña <span class="flecha">→</span></a>
          <a href={ruta.diseno} class="btn linea">Ver el servicio</a>
        </div>
      </div>
      <div class="campana-mosaico" data-revela>
        {
          mosaico.map(([clase, f, ancho]) =>
            f === 'carrusel' ? (
              <div class={clase}><CarruselMuestra c={carrusel('quintin-lame')} pie={false} sizes="(min-width: 1000px) 16vw, 33vw" /></div>
            ) : (
              <a href={f.href} class:list={['cm-foto', clase]}>
                <Image src={f.src} alt={f.alt} widths={ancho === 'grande' ? [700, 1100, 1280] : [400, 700]} sizes={ancho === 'grande' ? '(min-width: 1000px) 45vw, 100vw' : '(min-width: 1000px) 22vw, 50vw'} style={f.foco ? `object-position:${f.foco}` : undefined} />
                <span class="cm-pie"><b>{f.titulo}</b>{f.nota}</span>
              </a>
            ),
          )
        }
        <p class="credito cm-credito">Fotogramas de trabajos nuestros y una foto de Martín en Palenque. El carrusel también es de Dial.</p>
      </div>
    </div>
    <div class="contenedor tira-cabeza" data-revela>
      <p class="kicker">Carruseles que hicimos</p>
      <p class="texto-2">Pasa el mouse por encima (o toca) para ver las láminas. Arrastra la tira para ver más.</p>
    </div>
    <div class="tira" data-tira data-cursor="Arrastra">
      {CARRUSELES.map((c) => <CarruselMuestra c={c} class="tira-item" sizes="(min-width: 980px) 18vw, 62vw" />)}
    </div>
  </section>

  <!-- SERVICIOS con imagen -->
  <section class="seccion tema-papel" id="servicios">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">Qué hacemos</p>
          <h2 class="display d-2">Del comercial al <em>documental.</em></h2>
        </div>
        <p class="texto-2" data-revela>Cada proyecto se cotiza a la medida. Hablas con una sola persona de principio a fin.</p>
      </header>
      <ol class="servicios">
        {
          servicios.map((s, i) => (
            <li data-revela class:list={{ ancho: servicios.length % 2 === 1 && i === servicios.length - 1 }} style={`--retraso:${(i % 3) * 0.06}s`}>
              <a href={ruta[s.id]} class="servicio">
                {s.id === 'diseno' ? (
                  <span class="servicio-foto servicio-laminas">
                    <Image src={FOTOS.afiche.src} alt="" class="laminas-fondo" widths={[480, 800, 1100]} sizes="(min-width: 1100px) 31vw, (min-width: 760px) 48vw, 100vw" />
                    {laminas.map((l) => <Image src={l} alt="" class="lamina-mini" widths={[240, 400]} sizes="12vw" />)}
                  </span>
                ) : FOTO_SERVICIO[s.id] ? (
                  <span class="servicio-foto">
                    <Image src={FOTO_SERVICIO[s.id].src} alt="" widths={[480, 800, 1100, 1600, 2200]} sizes={servicios.length % 2 === 1 && i === servicios.length - 1 ? '(min-width: 760px) 92vw, 100vw' : '(min-width: 1100px) 31vw, (min-width: 760px) 48vw, 100vw'} style={FOTO_SERVICIO[s.id].foco ? `object-position:${FOTO_SERVICIO[s.id].foco}` : undefined} />
                  </span>
                ) : null}
                <span class="servicio-n">{dos(i + 1)}</span>
                <span class="titular t-3">{s.data.titulo}</span>
                {s.data.gancho && <span class="gancho servicio-gancho">{s.data.gancho}</span>}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

<!-- TRABAJO -->
  <section class="seccion tema-carbon grano" id="trabajo">
    <div class="contenedor">
      <header class="seccion-cabeza"><h2>Trabajo</h2><a href="/trabajo" class="ver">Todo el trabajo →</a></header>
      <div class="obras">
        {
          trabajo.map((t, i) => (
            <article class="obra" data-revela>
              <VideoLite video={t.video} titulo={t.titulo} />
              <p class="rotulo">{t.rotulo}</p>
              <h3 class="titular t-3">{t.href ? <a href={t.href}>{t.titulo}</a> : t.titulo}</h3>
              <p class="datos"><span>{t.meta}</span></p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- LO QUE NOS DISTINGUE -->
  <section class="seccion tema-hueso">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">Lo que nos distingue</p>
          <h2 class="display d-2">Lo que no se <em>alquila.</em></h2>
        </div>
        <p class="texto-2" data-revela>Las cámaras se consiguen por proyecto. Esto viene con nosotros.</p>
      </header>
      <ol class="numerada">
        {
          distintos.map((d) => (
            <li data-revela>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- LA CASA: Fototoma y RED Quynza -->
  <section class="seccion tema-carbon grano casa">
    <div class="contenedor">
      <header class="cabeza" data-revela>
        <p class="kicker">La casa</p>
        <h2 class="display d-2">Imagen, sonido e <em>investigación.</em></h2>
      </header>
      <div class="casa-grid">
        <article class="casa-pieza" data-revela>
          <a href="https://fototomaproducciones.com" target="_blank" rel="noopener" class="fotograma r-16-9 casa-foto">
            <Image src={disco} alt="Arte del disco In-Vitro" widths={[640, 1000, 1400]} sizes="(min-width: 980px) 50vw, 100vw" />
          </a>
          <p class="rotulo">Música y sonido</p>
          <h3 class="titular t-2">Fototoma</h3>
          <p class="texto-2">
            La productora de música de Martín Perea, Santiago García y Juan Rizoma. Compone, graba y mezcla la música y el sonido de las piezas de Dial, y trabaja
            también para cine, publicidad y videojuegos.
          </p>
          <a href="https://fototomaproducciones.com" class="enlace" target="_blank" rel="noopener">fototomaproducciones.com <span>↗</span></a>
        </article>
        <article class="casa-pieza" data-revela style="--retraso:.1s">
          <div class="casa-red" aria-hidden="true">
            <p class="cartela-mini">Una misma pregunta en Bogotá, en los nodos de la RED y en el campo. Al final, lo que dicen las cifras.</p>
            <p class="rotulo">En preparación · Preguntas en la calle</p>
          </div>
          <p class="rotulo">Investigación</p>
          <h3 class="titular t-2">RED Quynza</h3>
          <p class="texto-2">
            Una red académica de profesores e investigadores con nodos en varias regiones. Revisa el contexto y los datos de cada proyecto, nos abre la puerta en
            los territorios y coproduce con Dial el podcast <em>Lo que la gente quiere es vivir</em>.
          </p>
          <a href="/investigacion" class="enlace">Cómo investigamos <span>→</span></a>
        </article>
      </div>
    </div>
  </section>

  <CTAFinal
    titulo="¿Qué historia quieres contar?"
    texto="Cuéntanos qué necesitas, para quién y para cuándo. Te respondemos con una propuesta a la medida."
    mensajeWhatsapp="Hola, Martín. Vi la página de Dial Medio y quiero cotizar un proyecto."
  />
</Base>

<style>
  /* ---------- Héroe: fotogramas a sangre que se funden (sin bandas: Martín, 18 nov) ---------- */
  .heroe { position: relative; min-height: 100svh; display: grid; align-items: end; background: #0f0d0c; overflow: hidden; }
  .cuadros { position: absolute; inset: 0; overflow: hidden; }
  /* Velo arriba para que el logotipo y el menú se lean sobre cualquier foto. */
  .cuadros::after { content: ''; position: absolute; inset: 0 0 auto; height: 200px; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(15, 13, 12, .78) 0%, rgba(15, 13, 12, .35) 55%, rgba(15, 13, 12, 0) 100%); }
  /* Seis fotogramas de 6 s: ciclo de 36 s, cada uno visible un sexto. */
  .cuadro { position: absolute; inset: 0; margin: 0; opacity: 0; overflow: hidden; animation: funde 36s infinite; animation-delay: calc(var(--i) * 6s - 1s); }
  .cuadro img { width: 100%; height: 100%; object-fit: cover; animation: acerca 36s infinite linear; animation-delay: calc(var(--i) * 6s - 1s); }
  .cuadro::after { content: ''; position: absolute; inset: 0; background:
    linear-gradient(0deg, rgba(15, 13, 12, .9) 0%, rgba(15, 13, 12, .2) 50%, rgba(15, 13, 12, 0) 100%),
    linear-gradient(90deg, rgba(15, 13, 12, .82) 0%, rgba(15, 13, 12, .5) 38%, rgba(15, 13, 12, 0) 70%); }
  @media (max-width: 760px) { .cuadro::after { background: linear-gradient(0deg, rgba(15, 13, 12, .95) 0%, rgba(15, 13, 12, .6) 55%, rgba(15, 13, 12, .15) 100%); } }
  .cuadro .credito { position: absolute; right: var(--gutter); bottom: 14px; z-index: 2; color: rgba(244, 238, 229, .75); margin: 0; }
  @keyframes funde { 0% { opacity: 0; } 2.8% { opacity: 1; } 16.7% { opacity: 1; } 19.5% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes acerca { 0% { transform: scale(1.01); } 20% { transform: scale(1.06); } 100% { transform: scale(1.06); } }
  @media (prefers-reduced-motion: reduce) {
    .cuadro, .cuadro img, .heroe-conteo li::after { animation: none; }
    .cuadro:first-child { opacity: 1; }
    .cuadro:not(:first-child) { display: none; }
  }
  /* Conteo de fotogramas: seis rayas finas abajo a la izquierda; la que está en pantalla se llena de luz. */
  .heroe-conteo { position: absolute; left: var(--gutter); bottom: clamp(36px, 5vh, 52px); z-index: 3; list-style: none; display: flex; gap: 6px; }
  @media (min-width: 1000px) { .heroe-conteo { left: max(var(--gutter), calc((100vw - var(--ancho)) / 2)); } }
  .heroe-conteo li { width: 28px; height: 2px; background: rgba(244, 238, 229, .25); position: relative; overflow: hidden; }
  .heroe-conteo li::after { content: ''; position: absolute; inset: 0; background: var(--luz); transform: scaleX(0); transform-origin: left; animation: llena 36s infinite linear; animation-delay: calc(var(--i) * 6s - 1s); }
  @keyframes llena { 0% { transform: scaleX(0); } 16.7% { transform: scaleX(1); } 17% { transform: scaleX(0); } 100% { transform: scaleX(0); } }
  .heroe-texto { position: relative; z-index: 2; display: grid; gap: 22px; justify-items: start; padding-bottom: clamp(72px, 13vh, 140px); }
  .heroe-titulo { font-size: clamp(3rem, 1.3rem + 5.6vw, 7rem); line-height: .94; max-width: 12ch; }
  .heroe-bajada { margin: 0; color: var(--hueso-2); max-width: 46ch; }
  @media (prefers-reduced-motion: no-preference) { .heroe-texto { animation: aparece 1.1s var(--ease) both .2s; } }
  @keyframes aparece { from { opacity: 0; transform: translateY(12px); } }

  /* ---------- El dial: cartela a pantalla sobre el páramo ---------- */
