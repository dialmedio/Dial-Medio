---
/**
 * Portada de Dial (nov 2026): Dial es un medio. Se arma sola con lo que hay en las colecciones:
 * la apertura es la noticia `destacado: true` más reciente (o la última), y cada bloque toma lo suyo.
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import VideoLite from '../components/VideoLite.astro';
import {
  noticiasPublicadas, columnasPublicadas, lineas, conAcento, fechaBreve, isoDia, rutaNoticia, rotulo,
} from '../lib/medio';
import { anio, estados } from '../lib/util';

const noticias = await noticiasPublicadas();
const apertura = noticias.find((n) => n.data.destacado) ?? noticias[0];
const usadas = new Set([apertura.id]);
const tomar = (f: (n: (typeof noticias)[number]) => boolean, k: number) => {
  const out = noticias.filter((n) => !usadas.has(n.id) && f(n)).slice(0, k);
  out.forEach((n) => usadas.add(n.id));
  return out;
};
const segundas = tomar(() => true, 2);
const ultimo = tomar(() => true, 6);
const bloques = [
  { titulo: 'América Latina y el mundo', href: '/noticias', piezas: tomar((n) => n.data.linea === 'al-aire' && n.data.region !== 'colombia', 3) },
  { titulo: lineas.termometro.nombre, href: '/noticias/termometro', piezas: tomar((n) => n.data.linea === 'termometro', 3) },
  { titulo: lineas.expediente.nombre, href: '/noticias/expediente', nota: 'Con la RED Quynza', piezas: tomar((n) => n.data.linea === 'expediente', 3) },
  { titulo: lineas['arte-y-memoria'].nombre, href: '/noticias/arte-y-memoria', piezas: tomar((n) => n.data.linea === 'arte-y-memoria', 3) },
].filter((b) => b.piezas.length);
const colombia = tomar((n) => n.data.region === 'colombia', 4);

const columnas = await columnasPublicadas();
const conAutor = await Promise.all(columnas.slice(0, 4).map(async (c) => ({ c, autor: (await getEntry(c.data.autor))! })));
const martin = await getEntry('autores', 'martin-perea-tobon');

const medio = (await getCollection('medio', (m) => !m.data.borrador)).sort((a, b) => a.data.orden - b.data.orden);
const podcast = medio.filter((m) => m.data.formato === 'videopodcast' && m.data.video).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())[0];
const debate = medio.find((m) => m.data.formato === 'debate' && m.data.destacado) ?? medio.find((m) => m.data.formato === 'debate');
const docs = medio.filter((m) => m.data.formato === 'documental');
const doc = docs.find((d) => d.data.destacado && d.data.video) ?? docs.find((d) => d.data.video);
const enCamino = docs.filter((d) => d.data.estado !== 'publicado');
---

<Base portada>
  <div class="tema-papel portada">
    <!-- APERTURA -->
    <section class="contenedor apertura" aria-label="Apertura">
      <div class="apertura-principal">
        <NoticiaCard n={apertura} variante="principal" cargaInmediata />
        <div class="segundas">
          {segundas.map((n) => <NoticiaCard n={n} />)}
        </div>
      </div>
      <aside class="ultimo" aria-labelledby="ultimo-t">
        <h2 class="rotulo-seccion" id="ultimo-t"><span class="punto" aria-hidden="true"></span>Lo último</h2>
        <ol>
          {
            ultimo.map((n) => (
              <li>
                <p class="ultimo-meta"><a href={`/noticias/${n.data.linea}`} class="rotulo">{rotulo(n)}</a><time datetime={isoDia(n.data.fecha)} class="datos">{fechaBreve(n.data.fecha)}</time></p>
                <h3 class="titular t-4"><a href={rutaNoticia(n)} set:html={conAcento(n.data.titulo)} /></h3>
              </li>
            ))
          }
        </ol>
        <a href="/noticias" class="enlace">Todas las noticias <span>→</span></a>
      </aside>
    </section>

    <!-- OPINIÓN -->
    <section class="contenedor opinion-sec" aria-labelledby="opinion-t">
      <header class="seccion-cabeza"><h2 id="opinion-t"><a href="/opinion">Opinión</a></h2><a href="/opinion" class="ver">Columnas con firma →</a></header>
      {
        conAutor.length > 0 && conAutor.length < 3 ? (
          <div class="opinion-destacada">
            {conAutor.map(({ c, autor }, i) => (
              <article class:list={['columna-grande', { segunda: i > 0 }]}>
                {autor.data.retrato && (
                  <a href={`/opinion/${c.id}`} class="cg-retrato" tabindex="-1" aria-hidden="true">
                    <Image src={autor.data.retrato} alt="" widths={[300, 600]} sizes="(min-width: 800px) 240px, 50vw" />
                  </a>
                )}
                <div class="cg-texto">
                  <p class="rotulo">{c.data.tema ? `${c.data.tema} · ` : ''}{autor.data.nombre}</p>
                  <h3 class="titular t-1"><a href={`/opinion/${c.id}`} set:html={conAcento(c.data.titulo)} /></h3>
                  <p class="bajada">{c.data.bajada}</p>
                  {c.data.destacada && <p class="columna-frase">«{c.data.destacada}»</p>}
                  <a href={`/opinion/${c.id}`} class="enlace">Leer la columna <span>→</span></a>
                </div>
              </article>
            ))}
          </div>
        ) : conAutor.length ? (
          <div class="rejilla r4 con-filetes">
            {conAutor.map(({ c, autor }) => (
              <article class="columna">
                {autor.data.retrato && <Image src={autor.data.retrato} alt="" widths={[200, 400]} sizes="120px" class="columna-retrato" />}
                <p class="rotulo gris">{autor.data.nombre}</p>
                <h3 class="titular t-3"><a href={`/opinion/${c.id}`} set:html={conAcento(c.data.titulo)} /></h3>
                {c.data.destacada && <p class="columna-frase">«{c.data.destacada}»</p>}
              </article>
            ))}
          </div>
        ) : (
          <div class="opinion-vacia">
            {martin?.data.retrato && <Image src={martin.data.retrato} alt="" widths={[240, 480]} sizes="200px" class="opinion-retrato" />}
            <div class="opinion-texto">
              <p class="titular t-2">Ideas que se defienden con argumentos, <em>y con nombre propio.</em></p>
              <p class="bajada">
                Las primeras columnas están por salir. Estamos sumando voces de periodistas, profes, artistas y gente de los territorios,
                y lo mejor saldrá también en papel.
              </p>
              <div class="acciones">
                <a href="/opinion#escribe" class="btn">Escribe en Dial <span class="flecha">→</span></a>
                <a href="#boletin" class="btn linea">Avísame cuando salgan</a>
              </div>
            </div>
          </div>
        )
      }
    </section>

    {/* COLOMBIA */}
    {
      colombia.length > 0 && (
        <section class="contenedor bloque-sec" aria-labelledby="colombia-t">
          <header class="seccion-cabeza"><h2 id="colombia-t"><a href="/noticias/al-aire">Colombia</a></h2><a href="/noticias/al-aire" class="ver">Al Aire →</a></header>
          <div class="rejilla r4 con-filetes">
            {colombia.map((n) => <NoticiaCard n={n} />)}
          </div>
        </section>
      )
    }
  </div>

  <!-- ESCUCHAR Y VER: podcast y laboratorio -->
  <section class="tema-carbon grano escuchar" aria-label="Podcast y laboratorio">
    <div class="contenedor escuchar-grid">
      {
        podcast && (
          <article class="escuchar-pieza">
            <header class="seccion-cabeza"><h2><a href="/podcast">Podcast</a></h2><span class="ver">Con la RED Quynza</span></header>
            <VideoLite video={podcast.data.video!} titulo={podcast.data.titulo} />
            <p class="rotulo">{podcast.data.serie}</p>
            <h3 class="titular t-2"><a href={`/podcast/${podcast.id}`}>{podcast.data.titulo}</a></h3>
            <p class="bajada">{podcast.data.resumen}</p>
          </article>
        )
      }
      {
        debate && (
          <article class="escuchar-pieza">
            <header class="seccion-cabeza"><h2><a href="/laboratorio">Laboratorio</a></h2><span class="ver">Debates y experimentos</span></header>
            <VideoLite video={debate.data.video!} titulo={debate.data.titulo} />
            <p class="rotulo">Debate · La pregunta no es quién ganó, sino quién cambió</p>
            <h3 class="titular t-2"><a href={`/laboratorio/${debate.id}`}>{debate.data.titulo}</a></h3>
            <p class="bajada">{debate.data.resumen}</p>
          </article>
        )
      }
    </div>
  </section>

  <div class="tema-papel">
    {/* LÍNEAS */}
    {
      bloques.length > 0 && (
        <section class="contenedor lineas-sec" aria-label="Más noticias">
          <div class={`rejilla r${Math.max(2, bloques.length)} con-filetes`}>
            {bloques.map((b) => (
              <div class="bloque">
                <header class="seccion-cabeza chica"><h2><a href={b.href}>{b.titulo}</a></h2>{b.nota && <span class="ver">{b.nota}</span>}</header>
                <NoticiaCard n={b.piezas[0]} bajada={false} />
                {b.piezas.slice(1).map((n) => <NoticiaCard n={n} variante="texto" />)}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* DOCUMENTALES */}
    {
      doc && (
        <section class="contenedor docs-sec" aria-labelledby="docs-t">
          <header class="seccion-cabeza"><h2 id="docs-t"><a href="/documentales">Documentales</a></h2><a href="/documentales" class="ver">Música, territorio y memoria →</a></header>
          <div class="docs-grid">
            <div class="docs-principal">
              <VideoLite video={doc.data.video!} titulo={doc.data.titulo} />
              <p class="rotulo">{doc.data.serie ? `Serie ${doc.data.serie}` : 'Documental'} · {doc.data.lugar} · {anio(doc.data.fecha)}</p>
              <h3 class="titular t-2"><a href={`/documentales/${doc.id}`}>{doc.data.titulo}</a></h3>
              <p class="bajada">{doc.data.resumen}</p>
            </div>
            {enCamino.length > 0 && (
              <aside class="docs-camino">
                <p class="rotulo">En camino</p>
                <ul>
                  {enCamino.map((d) => (
                    <li>
                      <span class="titular t-4">{d.data.titulo}</span>
                      <span class="bajada">{d.data.resumen}</span>
                      <span class="rotulo gris">{estados[d.data.estado]}</span>
                    </li>
                  ))}
                </ul>
              </aside>
            )}
          </div>
        </section>
      )
    }

    <!-- DIAL ESTUDIO -->
    <section class="contenedor estudio-sec">
      <a href="/estudio" class="estudio">
        <p class="rotulo">Dial Estudio</p>
        <p class="titular t-3">Producimos documental, cobertura y eventos para organizaciones, con la misma mirada del medio.</p>
        <span class="enlace">Conoce el estudio <span>→</span></span>
      </a>
    </section>
  </div>
</Base>

<style>
  .portada { padding-bottom: 8px; }

  /* Apertura: la noticia principal y la columna de Lo último, separadas por un filete */
  .apertura { display: grid; gap: 40px; padding-top: clamp(24px, 3vw, 36px); padding-bottom: clamp(48px, 6vw, 80px); }
  @media (min-width: 1100px) { .apertura { grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr); gap: 0; } }
  .apertura-principal { display: grid; gap: 36px; align-content: start; }
  @media (min-width: 1100px) { .apertura-principal { padding-right: 40px; } }
  .segundas { display: grid; gap: 32px; border-top: 1px solid var(--linea); padding-top: 28px; }
  @media (min-width: 700px) { .segundas { grid-template-columns: 1fr 1fr; } .segundas > :global(* + *) { border-left: 1px solid var(--linea); padding-left: 28px; } }

  .ultimo { display: grid; gap: 18px; align-content: start; border-top: 1px solid var(--carbon); padding-top: 14px; }
  @media (min-width: 1100px) { .ultimo { border-top: 0; border-left: 1px solid var(--linea); padding: 0 0 0 32px; } }
  .rotulo-seccion { font-family: var(--f-rotulo); font-weight: 600; font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; display: flex; align-items: center; gap: .7em; }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--luz); box-shadow: 0 0 .7em .1em rgba(212, 81, 46, .55); }
  @media (prefers-reduced-motion: no-preference) { .punto { animation: late 2.4s ease-in-out infinite; } }
  @keyframes late { 50% { opacity: .35; } }
  .ultimo ol { list-style: none; }
  .ultimo li { padding: 16px 0; border-bottom: 1px solid var(--linea); display: grid; gap: 6px; }
  .ultimo li:first-child { padding-top: 4px; }
  .ultimo-meta { margin: 0; display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .ultimo-meta .datos { font-size: .78rem; }
  .gris { color: var(--texto-2); }

  /* Opinión */
  .opinion-sec, .bloque-sec, .lineas-sec, .docs-sec { padding-bottom: clamp(48px, 6vw, 80px); }
  .seccion-cabeza h2 a { text-decoration: none; }
  .seccion-cabeza h2 a:hover { color: var(--terracota-ink); }
  .opinion-vacia { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 800px) { .opinion-vacia { grid-template-columns: 200px 1fr; gap: 48px; } }
  :global(.opinion-retrato) { width: 200px; height: auto; }
  .opinion-texto { display: grid; gap: 18px; max-width: 64ch; }
  .opinion-texto p { margin: 0; }
  .columna { display: grid; gap: 10px; align-content: start; }
  .opinion-destacada { display: grid; gap: 40px; }
  .columna-grande { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 800px) { .columna-grande { grid-template-columns: 240px 1fr; gap: 48px; } }
  .columna-grande.segunda { border-top: 1px solid var(--linea); padding-top: 40px; }
  .cg-retrato img { width: 100%; height: auto; display: block; }
  .cg-texto { display: grid; gap: 14px; justify-items: start; max-width: 62ch; }
  .cg-texto p { margin: 0; }
  .cg-texto .columna-frase { font-size: 1.35rem; }
  :global(.columna-retrato) { width: 96px; height: auto; }
  .columna p { margin: 0; }
  .columna-frase { font-family: var(--f-serif); font-style: italic; font-size: 1.1rem; color: var(--texto-2); }

  /* Escuchar y ver */
  .escuchar { padding-block: clamp(56px, 7vw, 96px); position: relative; }
  .escuchar-grid { display: grid; gap: 56px; }
  @media (min-width: 980px) { .escuchar-grid { grid-template-columns: 1fr 1fr; gap: 0; } .escuchar-pieza + .escuchar-pieza { border-left: 1px solid var(--linea-clara); padding-left: 40px; } .escuchar-pieza:first-child { padding-right: 40px; } }
  .escuchar-pieza { display: grid; gap: 14px; align-content: start; }
  .escuchar-pieza .rotulo { margin: 8px 0 0; color: var(--terracota-clara); }
  .escuchar-pieza h3 a { text-decoration: none; }
  .escuchar-pieza .bajada { color: var(--hueso-2); }
  .escuchar .seccion-cabeza .ver { color: var(--hueso-2); }

  /* Bloques por línea */
  .lineas-sec { padding-top: clamp(48px, 6vw, 80px); }
  .bloque { display: grid; gap: 22px; align-content: start; }
  .bloque > :global(.noticia.texto) { border-top: 1px solid var(--linea); padding-top: 16px; }
  .seccion-cabeza.chica { margin-bottom: 0; }
  .seccion-cabeza.chica h2 { font-size: clamp(1.5rem, 1.2rem + .8vw, 1.9rem); }

  /* Documentales */
  .docs-grid { display: grid; gap: 40px; }
  @media (min-width: 1040px) { .docs-grid { grid-template-columns: 1.7fr 1fr; gap: 48px; } }
  .docs-principal { display: grid; gap: 14px; }
  .docs-principal .rotulo { margin-top: 6px; }
  .docs-principal a { text-decoration: none; }
  .docs-camino ul { list-style: none; margin-top: 14px; border-top: 1px solid var(--carbon); }
  .docs-camino li { display: grid; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--linea); }
  .docs-camino .bajada { font-size: .95rem; }

  /* Estudio */
  .estudio-sec { padding-bottom: clamp(56px, 7vw, 96px); }
  .estudio { display: grid; gap: 14px; justify-items: start; padding: clamp(24px, 3vw, 40px) 0; border-top: 1px solid var(--carbon); border-bottom: 1px solid var(--carbon); text-decoration: none; }
  .estudio .titular { max-width: 36ch; }
  .estudio:hover .titular { color: var(--terracota-ink); }
</style>
