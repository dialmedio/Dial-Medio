---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Simbolo from '../components/Simbolo.astro';
import Sintonizador from '../components/Sintonizador.astro';
import EscalaMedicion from '../components/EscalaMedicion.astro';
import VideoLite from '../components/VideoLite.astro';
import CTAFinal from '../components/CTAFinal.astro';
import sitio from '../data/sitio.json';
import { dos, formatos, anio, rutaCaso } from '../lib/util';

const impacto = (await getCollection('servicios', (s) => s.data.linea === 'impacto')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const medio = (await getCollection('medio', (m) => !m.data.borrador)).sort((a, b) => a.data.orden - b.data.orden);
const debate = medio.find((m) => m.data.formato === 'debate' && m.data.destacado);

// Trabajo destacado: primero los casos por encargo, luego la obra propia en territorio.
const casos = (await getCollection('casos', (c) => !c.data.borrador && c.data.vitrina === 'impacto' && c.data.destacado && !!c.data.video)).map(
  (c) => ({
    titulo: c.data.titulo,
    video: c.data.video!,
    href: rutaCaso('impacto', c.id),
    kicker: c.data.organizacion ?? 'Dial Impacto',
    meta: `${c.data.lugar} · ${c.data.anio}`,
    resumen: c.data.resumen,
    duracion: undefined as string | undefined,
  }),
);
const propios = medio
  .filter((m) => m.data.mostrarEnImpacto && m.data.video)
  .map((m) => ({
    titulo: m.data.titulo,
    video: m.data.video!,
    href: `/medio/${m.id}`,
    kicker: `${formatos[m.data.formato]} · Obra propia`,
    meta: `${m.data.lugar} · ${anio(m.data.fecha)}`,
    resumen: m.data.resumen,
    duracion: m.data.duracion,
  }));
const [principal, secundario] = [...casos, ...propios];
---

<Base>
  <!-- PORTADA: del ruido a la señal -->
  <section class="heroe tema-carbon grano">
    <canvas class="estatica" data-estatica aria-hidden="true"></canvas>
    <div class="contenedor heroe-grid">
      <div class="heroe-texto">
        <p class="kicker heroe-kicker">Productora audiovisual · {sitio.ciudad}</p>
        <h1 class="display d-1 heroe-titulo">
          <span class="l">Contamos,</span>
          <span class="l"><span class="acento-t">y medimos,</span></span>
          <span class="l">el encuentro</span>
          <span class="l">humano.</span>
        </h1>
        <p class="lead heroe-bajada">
          Historias reales de personas, comunidades y organizaciones, de la investigación al estreno.
        </p>
        <div class="acciones heroe-acciones">
          <a href="/contacto" class="btn">Cotiza tu proyecto <span class="flecha">→</span></a>
          <a href="#trabajo" class="btn linea">Ver trabajo</a>
        </div>
      </div>
      <div class="heroe-simbolo">
        <Simbolo tono="claro" anima titulo="Símbolo de Dial: una voz y diez alrededor" />
      </div>
    </div>
    <div class="contenedor heroe-dial">
      <Sintonizador />
    </div>
  </section>

  <!-- QUIÉNES SOMOS, EN UNA FRASE -->
  <section class="seccion compacta tema-papel">
    <div class="contenedor">
      <p class="lead-xl manifiesto" data-revela>
        Somos una productora audiovisual con medio propio. Contamos historias que <em>construyen puentes</em> y
        dignifican a quienes aparecen en ellas, con imagen, sonido y música original hechos en casa.
      </p>
    </div>
  </section>

  <!-- DIAL IMPACTO -->
  <section class="seccion tema-hueso" id="impacto">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">{dos(1)} — <span class="acento">Dial Impacto</span></p>
          <h2 class="display d-2">Historias para organizaciones que transforman.</h2>
        </div>
        <p class="texto-2" data-revela style="--retraso:.1s">
          Para ONG, fundaciones, cooperación internacional, universidades y marcas con propósito.
        </p>
      </header>

      <ol class="servicios">
        {
          impacto.map((s, i) => (
            <li data-revela style={`--retraso:${i * 0.06}s`}>
              <a href={`/impacto#${s.id}`} class="servicio">
                <span class="mono servicio-num">{dos(i + 1)}</span>
                <span class="display d-4 servicio-titulo">{s.data.titulo}</span>
                <span class="servicio-resumen texto-2">{s.data.resumen}</span>
                <span class="servicio-entrega mono">{s.data.entregables.join(' · ')}</span>
                <span class="servicio-flecha" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="nota-cotiza mono texto-2" data-revela>Cada proyecto se cotiza a la medida.</p>
    </div>
  </section>

  <!-- TRABAJO -->
  {
    principal && (
      <section class="seccion tema-papel" id="trabajo">
        <div class="contenedor">
          <header class="cabeza doble">
            <div data-revela>
              <p class="kicker">{dos(2)} — Trabajo</p>
              <h2 class="display d-2">En territorio.</h2>
            </div>
            <p class="texto-2" data-revela style="--retraso:.1s">
              Rodamos donde suceden las historias, con un equipo pequeño y cuidadoso.
            </p>
          </header>

          <div class="trabajo">
            {[principal, secundario].filter(Boolean).map((p, i) => (
              <article class:list={['obra', { 'obra-principal': i === 0 }]} data-revela style={`--retraso:${i * 0.1}s`}>
                <VideoLite video={p!.video} titulo={p!.titulo} />
                <div class="obra-texto">
                  <p class="kicker sin-linea">{p!.kicker}</p>
                  <h3 class:list={['sub', i === 0 ? 's-1' : 's-2']}>
                    <a href={p!.href}>{p!.titulo}</a>
                  </h3>
                  {i === 0 && <p class="texto-2 obra-resumen">{p!.resumen}</p>}
                  <p class="mono texto-2 obra-meta">
                    {p!.meta}
                    {p!.duracion && ` · ${p!.duracion}`}
                  </p>
                  {i === 1 && (
                    <a href="/impacto#portafolio" class="enlace obra-mas">
                      Ver más trabajo <span>→</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- MEDICIÓN -->
  <section class="seccion tema-carbon grano">
    <div class="contenedor medicion-grid">
      <div class="medicion-texto">
        <p class="kicker" data-revela>{dos(3)} — <span class="acento">Pieza + medición</span></p>
        <h2 class="display d-2" data-revela>Del ruido a la señal, con datos.</h2>
        <p class="lead texto-2" data-revela>
          Encuestamos a la audiencia antes y después de ver la pieza. Tu organización sabe qué cambió y lo puede reportar.
        </p>
        <a href="/impacto/medicion" class="enlace" data-revela>Cómo medimos <span>→</span></a>
      </div>
      <EscalaMedicion />
    </div>
  </section>

  <!-- LAS OTRAS DOS LÍNEAS -->
  <section class="lineas">
    <a href="/encuentros" class="linea-caja tema-papel">
      <div class="linea-interior">
        <p class="kicker">{dos(4)} — <span class="acento">Dial Encuentros</span></p>
        <h2 class="display d-3">Producimos el encuentro. Y lo dejamos contado.</h2>
        <p class="texto-2">
          Foros, festivales, lanzamientos y música en vivo: tarima, sonido, programación, videomapping y cobertura.
        </p>
        <span class="enlace">Ver Dial Encuentros <span>→</span></span>
      </div>
    </a>
    <div class="linea-caja tema-carbon grano">
      <div class="linea-interior">
        <p class="kicker">{dos(5)} — <span class="acento">Dial Medio</span></p>
        <h2 class="display d-3">Nuestra obra propia.</h2>
        {
          debate && (
            <div class="linea-video">
              <VideoLite video={debate.data.video!} titulo={debate.data.titulo} />
              <p class="mono texto-2">Debate · {debate.data.duracion}</p>
            </div>
          )
        }
        <p class="texto-2">Debates entre sectores enfrentados, videopodcast y documentales.</p>
        <a href="/medio" class="enlace">Ver Dial Medio <span>→</span></a>
      </div>
    </div>
  </section>

  <CTAFinal />
</Base>

<script>
  // Estática de apertura: ruido que se disuelve en señal.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-estatica]');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reducir) {
    const ctx = canvas.getContext('2d');
    const w = (canvas.width = 240);
    const h = (canvas.height = 150);
    const img = ctx!.createImageData(w, h);
    const inicio = performance.now();
    const dur = 1500;
    const cuadro = (t: number) => {
      const p = Math.min((t - inicio) / dur, 1);
      for (let i = 0; i < img.data.length; i += 4) {
        const v = Math.random() * 255;
        img.data[i] = v;
        img.data[i + 1] = v * 0.92;
        img.data[i + 2] = v * 0.84;
        img.data[i + 3] = 255;
      }
      ctx!.putImageData(img, 0, 0);
      canvas.style.opacity = String(0.22 * (1 - p) ** 1.6);
      if (p < 1) requestAnimationFrame(cuadro);
      else canvas.remove();
    };
    requestAnimationFrame(cuadro);
  } else canvas?.remove();
</script>

<style>
  /* ---------- Portada ---------- */
  .heroe {
    position: relative;
    overflow: hidden;
    padding-top: clamp(48px, 7vw, 96px);
    min-height: calc(100svh - 72px);
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .estatica {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2 !important;
    pointer-events: none;
    image-rendering: pixelated;
    mix-blend-mode: screen;
  }
  .heroe-grid { display: grid; grid-template-columns: 1fr; align-items: center; gap: 24px; }
  .heroe-texto { display: grid; gap: 28px; justify-items: start; position: relative; z-index: 1; }
  /* Este titular no lleva tildes: puede ir más apretado que el resto. */
  .heroe-titulo { font-size: clamp(3rem, 0.9rem + 6.4vw, 7.4rem); line-height: 0.94; }
  .heroe-titulo .l { display: block; white-space: nowrap; }
  .acento-t { color: var(--terracota); }
  .heroe-bajada { margin: 0; color: var(--hueso-2); }
  .heroe-simbolo { order: -1; justify-self: end; width: min(40vw, 220px); margin-bottom: -12px; }
  .heroe-dial { padding-block: 48px 36px; }

  @media (prefers-reduced-motion: no-preference) {
    .heroe-titulo .l { animation: sube 1s var(--ease) both; }
    .heroe-titulo .l:nth-child(1) { animation-delay: 0.25s; }
    .heroe-titulo .l:nth-child(2) { animation-delay: 0.35s; }
    .heroe-titulo .l:nth-child(3) { animation-delay: 0.45s; }
    .heroe-titulo .l:nth-child(4) { animation-delay: 0.55s; }
    .heroe-bajada, .heroe-acciones { animation: sube 1s var(--ease) 0.75s both; }
    .heroe-kicker { animation: sube 1s var(--ease) 0.1s both; }
  }
  @keyframes sube { from { opacity: 0; transform: translateY(28px); } }

  @media (min-width: 900px) {
    .heroe-grid { grid-template-columns: 1.5fr 1fr; gap: 48px; }
    .heroe-simbolo { order: 0; width: 100%; max-width: 520px; justify-self: center; margin: 0; }
  }

  /* ---------- Manifiesto ---------- */
  .manifiesto { max-width: 34ch; margin: 0; }
  @media (min-width: 1000px) {
    .manifiesto { font-size: clamp(2rem, 1rem + 1.6vw, 2.75rem); margin-left: calc(100% / 4); }
  }

  /* ---------- Servicios ---------- */
  .servicios { list-style: none; border-top: 1px solid var(--borde); }
  .servicios li { border-bottom: 1px solid var(--borde); }
  .servicio {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    gap: 8px 16px;
    padding-block: 28px;
    text-decoration: none;
    position: relative;
  }
  .servicio::before {
    content: '';
    position: absolute;
    left: 0; top: -1px;
    height: 2px; width: 100%;
    background: var(--terracota);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .servicio:hover::before { transform: scaleX(1); }
  .servicio-num { color: var(--terracota-ink); padding-top: 0.5em; }
  .servicio-titulo { grid-column: 2; transition: color 0.3s; }
  .servicio:hover .servicio-titulo { color: var(--terracota-ink); }
  .servicio-resumen { grid-column: 2; font-size: 0.98rem; max-width: 56ch; }
  .servicio-entrega { grid-column: 2; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cobre); }
  .servicio-flecha { grid-column: 3; grid-row: 1; font-size: 1.6rem; transition: transform 0.4s var(--ease), color 0.3s; }
  .servicio:hover .servicio-flecha { transform: translateX(6px); color: var(--terracota-ink); }
  @media (min-width: 1000px) {
    .servicio { grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1fr) 2rem; align-items: baseline; padding-block: 36px; }
    .servicio-resumen { grid-column: 3; grid-row: 1; }
    .servicio-entrega { grid-column: 3; }
    .servicio-flecha { grid-column: 4; justify-self: end; }
  }
  .nota-cotiza { margin: 28px 0 0; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }

  /* ---------- Trabajo ---------- */
  .trabajo { display: grid; gap: 48px 40px; align-items: start; }
  .obra { display: grid; gap: 20px; align-content: start; }
  .obra-texto { display: grid; gap: 10px; }
  .obra-texto p { margin: 0; }
  .obra h3 a { text-decoration: none; }
  .obra h3 a:hover { color: var(--terracota-ink); }
  .obra-resumen { max-width: 58ch; }
  .obra-mas { justify-self: start; margin-top: 18px; }
  .obra-meta { font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; }
  @media (min-width: 900px) {
    .trabajo { grid-template-columns: 1.75fr 1fr; }
  }

  /* ---------- Medición ---------- */
  .medicion-grid { display: grid; gap: 56px; align-items: center; }
  .medicion-texto { display: grid; gap: 24px; justify-items: start; }
  .medicion-texto p { margin: 0; }
  @media (min-width: 980px) {
    .medicion-grid { grid-template-columns: 1fr 1.05fr; gap: 88px; }
  }

  /* ---------- Otras líneas ---------- */
  .lineas { display: grid; }
  .linea-caja { position: relative; padding: var(--seccion) var(--gutter); text-decoration: none; display: grid; align-content: center; }
  .linea-interior { display: grid; gap: 24px; justify-items: start; max-width: 560px; }
  .linea-interior > p { margin: 0; }
  a.linea-caja { transition: background 0.4s var(--ease); }
  a.linea-caja:hover { background: var(--hueso); }
  a.linea-caja:hover .enlace { color: var(--terracota-ink); gap: 0.9em; }
  .linea-video { width: 100%; display: grid; gap: 12px; }
  .linea-video p { margin: 0; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }
  @media (min-width: 980px) {
    .lineas { grid-template-columns: 1fr 1fr; }
    .linea-caja:first-child .linea-interior { margin-left: auto; margin-right: 56px; }
    .linea-caja:last-child .linea-interior { margin-left: 56px; }
  }
</style>
