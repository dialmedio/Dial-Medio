---
import Base from '../../../layouts/Base.astro';
import NoticiaCard from '../../../components/NoticiaCard.astro';
import { noticiasPublicadas, lineas, type Linea } from '../../../lib/medio';

export async function getStaticPaths() {
  const todas = await noticiasPublicadas();
  return (Object.keys(lineas) as Linea[])
    .filter((k) => todas.some((n) => n.data.linea === k))
    .map((linea) => ({ params: { linea }, props: { linea, piezas: todas.filter((n) => n.data.linea === linea) } }));
}

const { linea, piezas } = Astro.props;
const l = lineas[linea];
const [apertura, ...resto] = piezas;
---

<Base titulo={`${l.nombre} · Noticias`} descripcion={l.texto}>
  <div class="tema-papel">
    <header class="contenedor pagina-cabeza">
      <p class="kicker"><a href="/noticias">Noticias</a> · {l.cadencia}</p>
      <h1>{l.nombre}</h1>
      <p class="bajada">{l.texto}</p>
    </header>

    <section class="contenedor cuerpo">
      <div class="apertura"><NoticiaCard n={apertura} variante="principal" cargaInmediata /></div>
      {
        resto.length > 0 && (
          <div class="rejilla r3 con-filetes">
            {resto.map((n) => <NoticiaCard n={n} />)}
          </div>
        )
      }
    </section>
  </div>
</Base>

<style>
  .kicker a { color: inherit; text-decoration: none; }
  .kicker a:hover { color: var(--terracota-ink); }
  .cuerpo { display: grid; gap: clamp(48px, 6vw, 72px); padding-bottom: clamp(64px, 8vw, 112px); }
  .apertura { border-top: 1px solid var(--carbon); padding-top: 28px; max-width: 1080px; }
  .rejilla { border-top: 1px solid var(--linea); padding-top: 28px; }
</style>
