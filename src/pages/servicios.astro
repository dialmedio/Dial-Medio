---
/**
 * Servicios de la productora (18 nov 2026). Siete servicios en src/content/servicios (orden del 21 nov: los afines juntos, Retratos al lado de Videoclips), cada uno con su ancla
 * y, desde el 21 nov 2026, con su página propia en /servicios/<slug> (src/pages/servicios/[slug].astro).
 * Diseño de comunicación muestra láminas reales de lo que Dial publicó como medio (son portafolio de diseño).
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Casa from '../components/Casa.astro';
import ServicioBloque from '../components/ServicioBloque.astro';
import cap from '../data/capacidades.json';
import { FOTOS } from '../lib/cine';
import { rutaServicio } from '../lib/servicios';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const sitioUrl = Astro.site!;
// Lista de servicios para buscadores (cada uno enlaza a su página propia).
const ld = {
  '@type': 'ItemList',
  name: 'Servicios de producción audiovisual de Dial Medio',
  itemListElement: servicios.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.data.titulo, url: new URL(rutaServicio(s), sitioUrl).toString() })),
};
---

<Base
  portada
  titulo="Servicios de producción audiovisual en Bogotá"
  descripcion="Documental social, campañas para redes, comerciales, videoclips, cobertura de eventos y divulgación de investigación. Productora audiovisual en Bogotá con música original e investigación propia."
  ld={ld}
>
  <PortadaPagina
    kicker="Servicios"
    titulo="Del comercial al <em>documental.</em>"
    bajada="Desde una campaña completa hasta un documental. Lo comercial y lo social los hace el mismo equipo, con investigación detrás y música compuesta para cada pieza."
    indice={servicios.map((s) => ({ texto: s.data.titulo, href: `#${s.id}` }))}
    imagen={FOTOS.camaraLuz}
  />

  {servicios.map((s, i) => <ServicioBloque s={s} i={i} />)}

  <Casa tema="tema-hueso" />

  <section class="seccion tema-carbon grano" id="proceso">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">Cómo trabajamos</p>
          <h2 class="display d-2">De la idea al <em>estreno.</em></h2>
        </div>
        <p class="texto-2" data-revela>Hablas con una sola persona durante todo el proyecto. La historia no cambia de manos.</p>
      </header>
      <ol class="numerada">
        {cap.proceso.map((p) => <li data-revela><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <CTAFinal titulo="¿Qué necesitas contar?" />
</Base>
