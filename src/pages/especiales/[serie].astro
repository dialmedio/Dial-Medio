---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { series, rutaNoticia, conAcento, fechaBreve, isoDia } from '../../lib/medio';

export async function getStaticPaths() {
  return (await series()).map((s) => ({ params: { serie: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const [primera] = s.piezas;
const pendientes = Array.from({ length: s.de - s.piezas.length }, (_, i) => s.piezas.length + i + 1);
---

<Base titulo={`${s.nombre} · Especial`} descripcion={s.presentacion}>
  <section class="tema-carbon grano portada">
    <div class="contenedor portada-grid">
      <div class="portada-texto">
        <p class="kicker vivo">Especial · {s.de} entregas</p>
        <h1 class="titular">{s.nombre}</h1>
        <p class="bajada">{s.presentacion}</p>
        <p class="datos"><span>Publicadas: {s.piezas.length} de {s.de}</span></p>
      </div>
      <figure class="foto r-4-5"><Image src={primera.data.portada} alt="" widths={[480, 800, 1200]} sizes="(min-width: 980px) 40vw, 100vw" loading="eager" style={`object-position:${primera.data.foco}`} /></figure>
    </div>
  </section>

  <section class="seccion compacta tema-papel">
    <ol class="contenedor entregas">
      {
        s.piezas.map((n) => (
          <li>
            <span class="n">{n.data.serie!.parte}</span>
            <div class="e-texto">
              <h2 class="titular t-2"><a href={rutaNoticia(n)} set:html={conAcento(n.data.titulo)} /></h2>
              <p class="bajada">{n.data.bajada}</p>
              <p class="datos"><time datetime={isoDia(n.data.fecha)}>{fechaBreve(n.data.fecha)}</time></p>
            </div>
            <a href={rutaNoticia(n)} class="e-foto" tabindex="-1" aria-hidden="true"><figure class="foto r-3-2"><Image src={n.data.portada} alt="" widths={[320, 640]} sizes="280px" style={`object-position:${n.data.foco}`} /></figure></a>
          </li>
        ))
      }
      {
        pendientes.map((p) => (
          <li class="pendiente">
            <span class="n">{p}</span>
            <p class="datos">Próxima entrega</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .portada { padding-block: clamp(40px, 6vw, 88px); position: relative; }
  .portada-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 980px) { .portada-grid { grid-template-columns: 1.4fr 1fr; gap: 72px; } }
  .portada-texto { display: grid; gap: 20px; justify-items: start; }
  .portada-texto h1 { font-size: clamp(3rem, 1.4rem + 5.4vw, 6.6rem); line-height: .94; }
  .portada-texto .bajada { color: var(--hueso-2); max-width: 44ch; font-size: 1.15rem; }
  .entregas { list-style: none; }
  .entregas li { display: grid; grid-template-columns: 3.4rem 1fr; gap: 20px; padding: 28px 0; border-bottom: 1px solid var(--linea); align-items: start; }
  @media (min-width: 900px) { .entregas li { grid-template-columns: 5rem 1fr 280px; gap: 32px; } }
  .entregas .n { font-family: var(--f-display); font-size: clamp(2.6rem, 2rem + 2vw, 4rem); line-height: .9; }
  .e-texto { display: grid; gap: 10px; }
  .e-texto a { text-decoration: none; }
  .e-foto { display: none; }
  @media (min-width: 900px) { .e-foto { display: block; } }
  .pendiente { color: var(--texto-2); }
  .pendiente .n { color: var(--linea); -webkit-text-stroke: 1px var(--texto-2); color: transparent; }
</style>
