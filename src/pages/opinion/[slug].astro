---
import { existsSync } from 'node:fs';
import { getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Firma from '../../components/Firma.astro';
import Compartir from '../../components/Compartir.astro';
import sitio from '../../data/sitio.json';
import { columnasPublicadas, conAcento, sinAcento, fechaLarga, fechaBreve, isoDia, lectura } from '../../lib/medio';

export async function getStaticPaths() {
  const columnas = await columnasPublicadas();
  return columnas.map((c) => ({ params: { slug: c.id }, props: { c, columnas } }));
}

const { c, columnas } = Astro.props;
const d = c.data;
const autor = (await getEntry(d.autor))!;
const { Content } = await render(c);
const url = new URL(`/opinion/${c.id}`, Astro.site).toString();
const og = d.imagen ? await getImage({ src: d.imagen, width: 1200, format: 'jpg' }) : autor.data.retrato ? await getImage({ src: autor.data.retrato, width: 800, format: 'png' }) : null;
const delAutor = columnas.filter((x) => x.id !== c.id && x.data.autor.id === autor.id).slice(0, 3);
const otras = columnas.filter((x) => x.id !== c.id && x.data.autor.id !== autor.id).slice(0, 3);

const ld = {
  '@type': 'OpinionNewsArticle',
  headline: sinAcento(d.titulo),
  description: d.bajada,
  datePublished: d.fecha.toISOString(),
  author: [{ '@type': 'Person', name: autor.data.nombre, url: new URL(`/autores/${autor.id}`, Astro.site).toString() }],
  publisher: { '@id': new URL('/#dial', Astro.site).toString() },
  articleSection: 'Opinión',
  mainEntityOfPage: url,
  inLanguage: 'es-CO',
  ...(og ? { image: [new URL(og.src, Astro.site).toString()] } : {}),
};
---

<Base
  titulo={sinAcento(d.titulo)}
  descripcion={d.bajada}
  imagen={existsSync(`public/og/opinion/${c.id}.jpg`) ? `/og/opinion/${c.id}.jpg` : og?.src}
  tipo="article"
  articulo={{ publicado: d.fecha, autor: autor.data.nombre, seccion: 'Opinión', tipo: 'OpinionNewsArticle' }}
  ld={ld}
>
  <article class="columna tema-papel" data-pagefind-body>
    <header class="contenedor columna-cabeza">
      <p class="rotulo"><a href="/opinion">Opinión</a>{d.tema && <span> · {d.tema}</span>}</p>
      <h1 class="titular columna-titulo" set:html={conAcento(d.titulo)} />
      <p class="columna-bajada">{d.bajada}</p>
      <div class="columna-firma">
        <Firma autor={autor} grande />
        <p class="datos"><time datetime={isoDia(d.fecha)}>{fechaLarga(d.fecha)}</time><span>{lectura(c.body)} min de lectura</span></p>
      </div>
    </header>

    {
      d.imagen && (
        <figure class="contenedor columna-foto">
          <div class="foto"><Image src={d.imagen} alt="" widths={[640, 960, 1320, 1800]} sizes="(min-width: 1100px) 1100px, 100vw" loading="eager" /></div>
          {d.imagenCredito && <figcaption class="pie-foto">{d.imagenCredito}</figcaption>}
        </figure>
      )
    }

    <div class="contenedor columna-cuerpo">
      <div class="prosa capitular">
        <Content />
      </div>

      {
        d.correcciones.length > 0 && (
          <aside class="erratas" id="correcciones">
            <p class="rotulo">Correcciones</p>
            {d.correcciones.map((c) => <p><time datetime={isoDia(c.fecha)}>{fechaLarga(c.fecha)}</time>: {c.texto}</p>)}
          </aside>
        )
      }
      <footer class="columna-pie">
        <div class="autor-caja">
          {autor.data.retrato && <Image src={autor.data.retrato} alt="" widths={[200, 400]} sizes="120px" class="autor-retrato" />}
          <div>
            <p class="titular t-3"><a href={`/autores/${autor.id}`}>{autor.data.nombre}</a></p>
            <p class="autor-bio">{autor.data.bio}</p>
          </div>
        </div>
        <p class="nota-chica aviso">Las columnas expresan la opinión de quien las firma, no necesariamente la de Dial. ¿Quieres responder? <a href="/opinion#escribe">Escribe en Dial</a>.</p>
        <Compartir titulo={sinAcento(d.titulo)} url={url} />
        <p class="nota-chica aviso">¿Ves un error de dato? <a href={`mailto:${sitio.correo}?subject=${encodeURIComponent('Corrección: ' + sinAcento(d.titulo))}`}>Escríbenos</a>.</p>
      </footer>
    </div>
  </article>

  {
    delAutor.length + otras.length > 0 && (
      <section class="seccion compacta tema-hueso">
        <div class="contenedor">
          <header class="seccion-cabeza"><h2>Más opinión</h2><a href="/opinion" class="ver">Todas las columnas →</a></header>
          <ul class="mas rejilla r3 con-filetes">
            {[...delAutor, ...otras].map((x) => (
              <li>
                <h3 class="titular t-3"><a href={`/opinion/${x.id}`} set:html={conAcento(x.data.titulo)} /></h3>
                <p class="datos"><time datetime={isoDia(x.data.fecha)}>{fechaBreve(x.data.fecha)}</time></p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .columna { padding-bottom: clamp(56px, 7vw, 96px); }
  .columna-cabeza {
    max-width: calc(860px + 2 * var(--gutter));
    padding-top: clamp(40px, 6vw, 88px);
    display: grid; gap: 20px; justify-items: center; text-align: center;
  }
  .rotulo a { color: inherit; text-decoration: none; }
  .columna-titulo { font-size: clamp(2.6rem, 1.3rem + 4.4vw, 5.4rem); line-height: .98; }
  .columna-bajada { font-family: var(--f-serif); font-style: italic; font-size: clamp(1.3rem, 1.1rem + .8vw, 1.8rem); line-height: 1.3; margin: 0; max-width: 40ch; color: var(--tinta-2); }
  .columna-firma { display: grid; gap: 12px; justify-items: center; margin-top: 12px; }
  .columna-foto { margin-block: clamp(32px, 4vw, 56px) 0; max-width: calc(1100px + 2 * var(--gutter)); }
  .columna-foto .foto { aspect-ratio: 16 / 9; }
  .columna-cuerpo { max-width: calc(66ch + 2 * var(--gutter) + 40px); padding-top: clamp(40px, 5vw, 64px); display: grid; gap: 48px; }
  .erratas { display: grid; gap: 8px; padding: 16px 18px; border-left: 2px solid var(--luz); background: var(--fibra); }
  .erratas p { margin: 0; font-size: .95rem; }
  .columna-pie { display: grid; gap: 20px; padding-top: 28px; border-top: 1px solid var(--carbon); }
  .autor-caja { display: grid; grid-template-columns: 120px 1fr; gap: 20px; align-items: start; }
  :global(.autor-retrato) { width: 120px; height: auto; }
  .autor-caja p { margin: 0 0 8px; }
  .autor-caja a { text-decoration: none; }
  .autor-bio { font-size: .98rem; color: var(--texto-2); }
  .nota-chica { margin: 0; font-size: .86rem; color: var(--texto-2); }
  .aviso a { color: inherit; }
  .mas { list-style: none; }
  .mas p { margin-top: 8px; }
</style>
