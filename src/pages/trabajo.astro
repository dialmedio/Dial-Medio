---
/**
 * Trabajo de la productora (18 nov 2026): reúne lo que antes estaba repartido entre Documentales, Laboratorio,
 * Podcast y las muestras de oficio del Estudio. Las páginas de cada pieza siguen en sus rutas de siempre.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import VideoLite from '../components/VideoLite.astro';
import CTAFinal from '../components/CTAFinal.astro';
import { FOTOS, credito } from '../lib/cine';
import { anio, type Video } from '../lib/util';
import { rutaVideo } from '../lib/medio';

type Pieza = { titulo: string; video: Video; href?: string; rotulo: string; meta: string };

// Currulao no va: su miniatura es una foto que no es de Dial (Martín, 1 nov 2026).
const medio = (await getCollection('medio', (m) => !m.data.borrador && m.data.estado === 'publicado' && !!m.data.video && m.data.formato !== 'clip' && m.id !== 'currulao-musicas-del-pacifico-sur'))
  .sort((a, b) => a.data.orden - b.data.orden);
const deMedio = (m: (typeof medio)[number], rotulo: string): Pieza => ({
  titulo: m.data.titulo,
  video: m.data.video!,
  href: rutaVideo(m),
  rotulo,
  meta: [m.data.lugar, anio(m.data.fecha)].filter(Boolean).join(' · '),
});
const muestras = (await getCollection('muestras', (m) => !m.data.borrador)).sort((a, b) => a.data.orden - b.data.orden);

const grupos: { id: string; titulo: string; texto: string; piezas: Pieza[] }[] = [
  {
    id: 'documental',
    titulo: 'Documental',
    texto: 'Obra propia, investigada y filmada por Dial.',
    piezas: medio.filter((m) => m.data.formato === 'documental').map((m) => deMedio(m, m.data.serie ?? 'Documental')),
  },
  {
    id: 'conversacion',
    titulo: 'Conversación',
    texto: 'Debates entre personas que piensan distinto y el podcast que hacemos con la RED Quynza.',
    piezas: medio.filter((m) => m.data.formato === 'debate' || m.data.formato === 'videopodcast').map((m) => deMedio(m, m.data.formato === 'debate' ? 'Debate' : 'Videopodcast · con la RED Quynza')),
  },
  {
    id: 'musica',
    titulo: 'Música e imagen',
    texto: 'Videoclips, sesiones en vivo y música original. La música y el sonido son de Fototoma.',
    piezas: [
      { titulo: 'In-Vitro Live Sessions', video: { plataforma: 'youtube', id: 'tt3X0UynmCk' }, href: 'https://youtu.be/tt3X0UynmCk', rotulo: 'Sesión en vivo · Imagen y sonido', meta: 'Bogotá' },
      ...muestras.map((m) => ({ titulo: m.data.titulo, video: m.data.video, rotulo: m.data.disciplinas.join(' · '), meta: `${m.data.rol.replace(/\.$/, '')} · ${m.data.anio}` })),
    ],
  },
].filter((g) => g.piezas.length > 0);

const enCurso = (await getCollection('medio', (m) => !m.data.borrador && m.data.estado !== 'publicado')).map((m) => ({
  titulo: m.data.titulo,
  estado: m.data.estado === 'en-posproduccion' ? 'En posproducción' : 'En preparación',
  resumen: m.data.resumen,
  lugar: m.data.lugar,
}));
---

<Base portada titulo="Trabajo" descripcion="Documentales, debates, podcast, videoclips, sesiones en vivo y música original de Dial Medio y Fototoma.">
  <PortadaPagina
    kicker="Trabajo"
    titulo="Lo que hemos <em>filmado.</em>"
    bajada="Obra propia y muestras de oficio. Los encargos de clientes se irán sumando aquí."
    indice={[...grupos.map((g) => ({ texto: g.titulo, href: `#${g.id}` })), ...(enCurso.length ? [{ texto: 'En curso', href: '#en-curso' }] : [])]}
    imagen={FOTOS.setAzul}
  />

  {
    grupos.map((g, gi) => (
      <section class:list={['seccion', 'compacta', gi % 2 ? 'tema-hueso' : 'tema-papel']} id={g.id}>
        <div class="contenedor">
          <header class="cabeza doble">
            <div data-revela><h2 class="display d-3">{g.titulo}</h2></div>
            <p class="texto-2" data-revela>{g.texto}</p>
          </header>
          <div class="obras">
            {g.piezas.map((t) => (
              <article class="obra" data-revela>
                <VideoLite video={t.video} titulo={t.titulo} />
                <p class="rotulo">{t.rotulo}</p>
                <h3 class="titular t-3">{t.href ? <a href={t.href}>{t.titulo}</a> : t.titulo}</h3>
                {t.meta && <p class="datos"><span>{t.meta}</span></p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {
    enCurso.length > 0 && (
      <section class="seccion compacta tema-carbon grano" id="en-curso">
        <div class="contenedor">
          <header class="cabeza" data-revela>
            <p class="kicker vivo">En curso</p>
            <h2 class="display d-3">Lo que estamos <em>filmando.</em></h2>
          </header>
          <ul class="creditos">
            {enCurso.map((e) => (
              <li data-revela>
                <span class="rol">{e.estado}{e.lugar && ` · ${e.lugar}`}</span>
                <p class="nombre">{e.titulo}</p>
                <p class="texto-2 en-curso-txt">{e.resumen}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CTAFinal titulo="¿Hacemos el siguiente juntos?" />
</Base>

<style>
  .obras { display: grid; gap: 40px 28px; }
  @media (min-width: 760px) { .obras { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .obras { grid-template-columns: repeat(3, 1fr); } }
  .obra { display: grid; gap: 10px; align-content: start; }
  .obra .rotulo { margin-top: 6px; }
  .obra h3 a { text-decoration: none; }
  .en-curso-txt { margin: 10px 0 0; font-size: .98rem; max-width: 40ch; }
</style>
