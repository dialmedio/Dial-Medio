---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import sitio from '../data/sitio.json';

const autores = (await getCollection('autores')).sort((a, b) => a.data.orden - b.data.orden);

const hacemos = [
  { titulo: 'Noticias', href: '/noticias', texto: 'Lo que pasa en Colombia, América Latina y el mundo, con contexto y con fuentes. Análisis, no primicia.' },
  { titulo: 'Opinión', href: '/opinion', texto: 'Columnas con firma, separadas de las noticias. Ideas que se defienden con argumentos.' },
  { titulo: 'Podcast', href: '/podcast', texto: 'Conversaciones largas con quienes construyen paz, en coproducción con la RED Quynza.' },
  { titulo: 'Documentales', href: '/documentales', texto: 'Música, territorio y memoria: historias que piden tiempo.' },
  { titulo: 'Laboratorio', href: '/laboratorio', texto: 'Debates entre quienes piensan distinto y experimentos sobre cómo conversamos.' },
];
---

<Base
  titulo="Nosotros"
  descripcion="Dial es un medio independiente hecho en Bogotá: noticias con contexto, opinión, podcast, documentales y experimentos de conversación."
>
  <div class="tema-papel">
    <header class="contenedor pagina-cabeza">
      <p class="kicker">Nosotros</p>
      <h1>Un lugar para <em>entender.</em></h1>
      <p class="bajada">
        Dial es un medio independiente hecho en Bogotá. Ordenamos y traducimos la información para pasar del ruido a la señal:
        menos prisa, más contexto, y la gente que lo vive en el centro.
      </p>
    </header>

    <section class="contenedor manifiesto">
      <p class="lead-xl">
        Las redes premian el grito y el titular inflado. Nosotros apostamos por lo contrario: contar <em>completo</em>, mostrar de
        dónde sale cada dato, escuchar a las partes y abrir espacio a lo que también pasa y casi nadie cuenta: lo que nos une,
        lo que funciona, el arte, la memoria.
      </p>
    </section>

    <section class="contenedor bloque" aria-labelledby="hacemos-t">
      <header class="seccion-cabeza"><h2 id="hacemos-t">Qué hacemos</h2></header>
      <ul class="hacemos">
        {hacemos.map((h) => (
          <li>
            <a href={h.href} class="titular t-2">{h.titulo}</a>
            <p class="bajada">{h.texto}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="contenedor bloque" aria-labelledby="equipo-t">
      <header class="seccion-cabeza"><h2 id="equipo-t">Quiénes hacemos Dial</h2></header>
      <div class="equipo">
        {autores.map((a) => (
          <a href={`/autores/${a.id}`} class="persona">
            {a.data.retrato && <Image src={a.data.retrato} alt={`Retrato de ${a.data.nombre}`} widths={[300, 600]} sizes="240px" />}
            <span class="titular t-3">{a.data.nombre}</span>
            <span class="datos">{a.data.rol}</span>
          </a>
        ))}
        <div class="persona texto">
          <span class="titular t-3">Andrés <a href="https://www.instagram.com/andrstafurv/" target="_blank" rel="noopener">@andrstafurv</a></span>
          <span class="datos">Seguimiento del Expediente · RED Quynza</span>
          <p class="bajada">Lleva, decisión por decisión y con fuente, el registro del gobierno De la Espriella. Lo publica la RED Quynza; Dial lo diseña.</p>
        </div>
        <div class="persona texto">
          <span class="titular t-3">Red de realizadores</span>
          <span class="datos">Imagen · sonido · montaje · música</span>
          <p class="bajada">Fotógrafos, sonidistas, editores y músicos que se suman según cada proyecto.</p>
        </div>
      </div>
      <p class="sumate">¿Quieres escribir? <a href="/opinion#escribe">Escribe en Dial</a>.</p>
    </section>

    <section class="contenedor bloque dos" aria-labelledby="red-t">
      <header class="seccion-cabeza"><h2 id="red-t">Con la RED Quynza</h2></header>
      <div class="dos-texto">
        <p>
          La RED Quynza reúne a profes, investigadores y gente de los territorios que trabajan por la paz. Con ella hacemos el podcast
          <a href="/podcast"><em>Lo que la gente quiere es vivir</em></a>, y diseñamos el <a href="/noticias/expediente">Expediente</a> que ella
          publica. Cada pieza dice de quién es la iniciativa y quién la produce.
        </p>
        <p>
          La RED tiene su propia voz académica y Dial su propio análisis político; los mantenemos separados para que una no hable por la otra.
        </p>
        <a href="https://redquynza.org" class="enlace" target="_blank" rel="noopener">redquynza.org <span>↗</span></a>
      </div>
    </section>

    <section class="contenedor bloque dos" aria-labelledby="plata-t">
      <header class="seccion-cabeza"><h2 id="plata-t">Cómo nos sostenemos</h2></header>
      <div class="dos-texto">
        <p>
          Dial se financia con el trabajo de <a href="/estudio">Dial Estudio</a>, nuestra productora: documental, cobertura y eventos
          para organizaciones. Lo que gana el Estudio sostiene el medio. También postulamos a convocatorias de cultura, periodismo
          y cooperación.
        </p>
        <p>
          No dependemos de las vistas ni del algoritmo para existir. Nuestros clientes no deciden qué publicamos, y no producimos
          propaganda electoral. Cuando una pieza tenga apoyo de alguien, lo diremos en la pieza.
        </p>
        <a href="/principios" class="enlace">Principios editoriales <span>→</span></a>
      </div>
    </section>

    <section class="contenedor bloque contacto">
      <p class="titular t-2">Escríbenos: <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></p>
      <p class="redes-fila">{sitio.ciudad} · {sitio.redes.map((r) => <a href={r.url} target="_blank" rel="noopener">{r.nombre}</a>)}</p>
    </section>
  </div>
</Base>

<style>
  .pagina-cabeza h1 em { font-family: var(--f-serif); }
  .manifiesto { padding-block: clamp(16px, 2vw, 32px) clamp(56px, 7vw, 96px); }
  .manifiesto .lead-xl { max-width: 34ch; margin: 0; }
  .bloque { padding-bottom: clamp(56px, 7vw, 96px); }
  .hacemos { list-style: none; display: grid; gap: 0 40px; }
  @media (min-width: 900px) { .hacemos { grid-template-columns: repeat(3, 1fr); } }
  .hacemos li { display: grid; gap: 10px; align-content: start; padding: 22px 0; border-bottom: 1px solid var(--linea); }
  .hacemos a { text-decoration: none; }
  .hacemos a:hover { color: var(--terracota-ink); }
  .hacemos .bajada { font-size: 1rem; }

  .equipo { display: grid; gap: 32px; }
  @media (min-width: 700px) { .equipo { grid-template-columns: repeat(3, 1fr); } }
  .persona { display: grid; gap: 6px; align-content: start; text-decoration: none; }
  .persona img { width: 100%; max-width: 240px; height: auto; margin-bottom: 10px; }
  a.persona:hover .titular { color: var(--terracota-ink); }
  .persona.texto { border-top: 1px solid var(--linea); padding-top: 16px; }
  .persona .bajada { font-size: .98rem; margin-top: 6px; }
  .sumate { margin-top: 28px; font-size: .95rem; color: var(--texto-2); }
  .redes-fila { margin: 0; font-size: .9rem; color: var(--texto-2); }
  .sumate a, .contacto a { color: inherit; }

  .dos-texto { display: grid; gap: 18px; justify-items: start; max-width: 66ch; font-size: 1.1rem; }
  .dos-texto p { margin: 0; }
  .dos-texto a:not(.enlace) { color: inherit; text-decoration-color: var(--luz); }
  .contacto { display: grid; gap: 10px; border-top: 1px solid var(--carbon); padding-top: 28px; }
  .contacto .datos a + a::before { content: ' · '; }
</style>
