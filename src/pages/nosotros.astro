---
/**
 * Nosotros (18 nov 2026): equipo, capacidades, espacios y la casa (Fototoma y RED Quynza).
 * Reemplaza el Nosotros del medio y /estudio/como-trabajamos. Retratos en foto normal, 4:5.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import CTAFinal from '../components/CTAFinal.astro';
import cap from '../data/capacidades.json';
import sitio from '../data/sitio.json';
import { dos } from '../lib/util';

const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);
const lugares = ['Bogotá', 'Pacífico colombiano', 'San Basilio de Palenque', 'Pereira', 'Barranquilla', 'Cali', 'Popayán', 'Tres países de Asia'];
---

<Base titulo="Nosotros" descripcion="El equipo de Dial Medio, productora audiovisual de Bogotá, y su casa: Fototoma en la música y la RED Quynza en la investigación.">
  <PortadaPagina
    kicker="Nosotros"
    titulo="Un equipo pequeño, de la idea al <em>estreno.</em>"
    bajada="Dial Medio es una productora audiovisual de Bogotá. Trabaja junto a Fototoma, que hace la música y el sonido, y a la RED Quynza, que investiga."
    indice={[{ texto: 'Equipo', href: '#equipo' }, { texto: 'La casa', href: '#casa' }, { texto: 'Capacidades', href: '#capacidades' }]}
  />

  <section class="seccion compacta tema-papel">
    <div class="contenedor lugares" data-revela>
      <p class="kicker sin-linea">Hemos filmado en</p>
      <ul>{lugares.map((l) => <li>{l}</li>)}</ul>
    </div>
  </section>

  <section class="seccion tema-papel" id="equipo">
    <div class="contenedor">
      <header class="cabeza" data-revela>
        <p class="kicker">{dos(1)} · Equipo</p>
        <h2 class="display d-2">Quién está <em>detrás.</em></h2>
      </header>
      <div class="equipo">
        {
          equipo.map((p) => (
            <article class="persona" data-revela>
              {p.data.foto ? (
                <Image src={p.data.foto} alt={p.data.nombre} widths={[400, 640]} sizes="(min-width: 980px) 24vw, (min-width: 640px) 45vw, 100vw" />
              ) : (
                <div class="sin-foto" aria-hidden="true" />
              )}
              <p class="rotulo">{p.data.rol}</p>
              <h3 class="titular t-3">{p.data.nombre}</h3>
              <p class="texto-2 bio">{p.data.bio}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion tema-carbon grano" id="casa">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">{dos(2)} · La casa</p>
          <h2 class="display d-2">Con quién <em>trabajamos.</em></h2>
        </div>
        <p class="texto-2" data-revela>Cuando un proyecto lo pide, las tres casas lo firman juntas.</p>
      </header>
      <dl class="creditos">
        <div data-revela><dt>Imagen, dirección y producción</dt><dd>Dial Medio</dd></div>
        {sitio.aliados.map((a) => <div data-revela><dt>{a.rol}</dt><dd><a href={a.url} target="_blank" rel="noopener">{a.nombre} ↗</a></dd></div>)}
      </dl>
    </div>
  </section>

  <section class="seccion tema-hueso" id="capacidades">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">{dos(3)} · Capacidades</p>
          <h2 class="display d-2">Con qué <em>trabajamos.</em></h2>
        </div>
        <p class="texto-2" data-revela>Equipos propios y espacios aliados en Bogotá. Lo que no tenemos lo alquilamos para cada proyecto.</p>
      </header>
      <div class="capacidades">
        {
          cap.grupos.map((g) => (
            <div data-revela>
              <h3 class="sub s-2">{g.titulo}</h3>
              <ul>{g.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          ))
        }
      </div>
      <div class="sueltos" data-revela>
        <p class="rotulo">También por separado</p>
        <ul class="etiquetas">{cap.sueltos.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <CTAFinal />
</Base>

<style>
  .lugares { display: flex; flex-wrap: wrap; gap: 10px 24px; align-items: baseline; }
  .lugares .kicker { margin: 0; }
  .lugares ul { list-style: none; display: flex; flex-wrap: wrap; }
  .lugares li { font-family: var(--f-display); font-size: clamp(1.3rem, 1.1rem + .8vw, 1.9rem); line-height: 1.2; }
  .lugares li + li::before { content: '·'; margin: 0 .5em; color: var(--luz); }
  .equipo { display: grid; gap: 48px 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .persona { display: grid; gap: 10px; align-content: start; }
  .persona :global(img), .sin-foto { aspect-ratio: 4 / 5; width: 100%; object-fit: cover; object-position: 50% 20%; background: var(--fibra); margin-bottom: 8px; }
  .persona h3, .persona p { margin: 0; }
  .bio { font-size: .94rem; line-height: 1.55; }
  .capacidades { display: grid; gap: 40px 32px; }
  .capacidades > div { border-top: 1px solid var(--borde); padding-top: 20px; display: grid; gap: 14px; align-content: start; }
  .capacidades ul { list-style: none; display: grid; gap: 8px; }
  .capacidades li { color: var(--texto-2); font-size: 1rem; line-height: 1.5; }
  @media (min-width: 760px) { .capacidades { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .capacidades { grid-template-columns: repeat(4, 1fr); } }
  .sueltos { margin-top: 48px; display: grid; gap: 12px; }
  .sueltos .etiquetas { font-size: 1rem; }
</style>
