---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PortadaPagina from '../../components/PortadaPagina.astro';
import ServicioDetalle from '../../components/ServicioDetalle.astro';
import PiezaCard from '../../components/PiezaCard.astro';
import Pendiente from '../../components/Pendiente.astro';
import CTAFinal from '../../components/CTAFinal.astro';
import Onda from '../../components/Onda.astro';
import { Image } from 'astro:assets';
import webRed from '../../assets/web/redquynza.jpg';
import webDial from '../../assets/web/dialmedio.jpg';

const sitios = [
  { nombre: 'RED Quynza', url: 'https://redquynza.org', img: webRed, nota: 'Red académica sobre violencia urbana: podcast, repositorio, boletín y documentales.' },
  { nombre: 'Dial', url: 'https://dialmedio.org', img: webDial, nota: 'Este sitio: identidad, portafolio, boletín y formulario de cotización.' },
];
import { anio, dos, formatos, rutaCaso } from '../../lib/util';

const servicios = (await getCollection('servicios', (s) => s.data.linea === 'impacto')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const casos = (await getCollection('casos', (c) => !c.data.borrador && c.data.vitrina === 'impacto')).sort(
  (a, b) => Number(b.data.destacado) - Number(a.data.destacado) || b.data.anio - a.data.anio,
);
const territorio = (await getCollection('medio', (m) => !m.data.borrador && m.data.mostrarEnImpacto && !!m.data.video)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const muestras = (await getCollection('muestras', (m) => !m.data.borrador)).sort((a, b) => a.data.orden - b.data.orden);

const publicos = ['ONG', 'Fundaciones', 'Cooperación internacional', 'Universidades', 'Marcas con propósito'];
---

<Base
  titulo="Dial Impacto · Documental y video para organizaciones"
  descripcion="Documental por encargo, cobertura de proyectos sociales y ambientales, video institucional y piezas con medición antes y después, para ONG, fundaciones, cooperación y universidades."
>
  <PortadaPagina
    kicker="Dial Impacto"
    titulo="Historias que muestran lo que tu organización <em>transforma.</em>"
    bajada="Documental, cobertura y video para organizaciones que trabajan con comunidades, en la ciudad y en el territorio."
    indice={[...servicios.map((s) => ({ texto: s.data.titulo, href: `#${s.id}` })), { texto: 'Trabajo', href: '#portafolio' }, { texto: 'Sitios web', href: '#web' }]}
  >
    <ul class="etiquetas publicos" aria-label="Para quién">{publicos.map((p) => <li class="etiqueta">{p}</li>)}</ul>
    <div class="acciones">
      <a href="/contacto?linea=impacto" class="btn">Cotizar un proyecto <span class="flecha">→</span></a>
      <a href="#servicios" class="btn linea">Ver servicios</a>
    </div>
  </PortadaPagina>

  <!-- SERVICIOS -->
  <section class="seccion tema-papel" id="servicios">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">{dos(1)} — Servicios</p>
          <h2 class="display d-2">Cuatro formas de contar tu trabajo.</h2>
        </div>
        <p class="texto-2" data-revela>Son puntos de partida. Cada proyecto se arma y se cotiza a la medida.</p>
      </header>
      <div class="servicios-rejilla">
        {servicios.map((s, i) => <ServicioDetalle servicio={s} n={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- MEDICIÓN, EN UNA LÍNEA -->
  <a href="/impacto/medicion" class="banda-med tema-carbon grano luz-baja">
    <div class="contenedor banda-med-fila">
      <p class="kicker sin-linea"><span class="acento">Nuestro diferencial</span></p>
      <p class="banda-med-texto">
        Podemos medir el efecto de tu pieza en la audiencia, <em>antes y después</em> de verla.
      </p>
      <span class="enlace">Cómo medimos <span>→</span></span>
    </div>
  </a>

  <!-- TRABAJO -->
  <section class="seccion tema-papel" id="portafolio">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">{dos(2)} — Trabajo</p>
          <h2 class="display d-2">De la ciudad al territorio.</h2>
        </div>
        <p class="texto-2" data-revela>Rodamos donde suceden las historias: en un set, en la calle, en un evento o en el campo.</p>
      </header>

      <div class="rejilla-2">
        {
          casos.map((c) => (
            <PiezaCard
              titulo={c.data.titulo}
              video={c.data.video}
              href={rutaCaso('impacto', c.id)}
              kicker={c.data.organizacion}
              resumen={c.data.resumen}
              meta={`${c.data.lugar} · ${c.data.anio}`}
            />
          ))
        }
        {
          territorio.map((m) => (
            <PiezaCard
              titulo={m.data.titulo}
              video={m.data.video}
              href={`/medio/${m.id}`}
              kicker={`${formatos[m.data.formato]} · Obra propia`}
              resumen={m.data.resumen}
              meta={`${m.data.lugar} · ${anio(m.data.fecha)}`}
            />
          ))
        }
        {casos.length === 0 && <Pendiente titulo="Primer caso por encargo" texto="Un proyecto hecho para una organización, con su permiso para nombrarla." />}
      </div>

      {
        muestras.length > 0 && (
          <div class="musica">
            <Onda alto={60} />
            <div class="musica-cabeza" data-revela>
              <h3 class="sub s-1">Música original y diseño sonoro</h3>
              <p class="texto-2">
                La música de cada pieza la componemos nosotros. Tu historia suena a ella misma, no a un banco de música.
              </p>
            </div>
            <div class="rejilla-2">
              {muestras.map((m) => (
                <PiezaCard titulo={m.data.titulo} video={m.data.video} kicker={m.data.disciplinas.join(' · ')} meta={m.data.rol} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- SITIOS WEB -->
  <section class="seccion tema-hueso" id="web">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">{dos(3)} — También hacemos</p>
          <h2 class="display d-2">La casa digital de <em>tu proyecto.</em></h2>
        </div>
        <p class="texto-2" data-revela>
          Diseñamos y publicamos sitios web para organizaciones: el lugar donde viven tus documentales, tus datos y tu boletín.
          Rápidos, fáciles de actualizar y con identidad propia.
        </p>
      </header>
      <div class="sitios">
        {
          sitios.map((w, i) => (
            <a class="sitio" href={w.url} target="_blank" rel="noopener" data-revela style={`--retraso:${i * 0.08}s`}>
              <span class="sitio-marco">
                <span class="sitio-barra" aria-hidden="true"><i /><i /><i /><span class="meta">{w.url.replace('https://', '')}</span></span>
                <Image src={w.img} alt={`Página de inicio de ${w.nombre}`} widths={[640, 1000, 1440]} sizes="(min-width: 900px) 50vw, 100vw" />
              </span>
              <span class="sitio-texto">
                <span class="sub s-2">{w.nombre} <span aria-hidden="true">↗</span></span>
                <span class="texto-2">{w.nota}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTAFinal linea="impacto" />
</Base>

<style>
  .publicos { margin-top: 4px; }
  .publicos .etiqueta { color: var(--hueso-2); }
  .servicios-rejilla { display: grid; gap: 72px 56px; }
  @media (min-width: 900px) {
    .servicios-rejilla { grid-template-columns: 1fr 1fr; }
  }

  .banda-med { display: block; position: relative; text-decoration: none; padding-block: clamp(40px, 5vw, 64px); }
  .banda-med-fila { display: grid; gap: 16px 48px; align-items: center; }
  .banda-med-texto { margin: 0; font-size: clamp(1.25rem, 1rem + 1vw, 1.8rem); line-height: 1.35; max-width: 36ch; }
  .banda-med-texto em { color: #e0714c; }
  .banda-med:hover .enlace { color: #e0714c; gap: 0.9em; }
  @media (min-width: 980px) {
    .banda-med-fila { grid-template-columns: 11rem 1fr auto; }
  }

  .rejilla-2 { display: grid; gap: 64px 32px; }
  @media (min-width: 760px) {
    .rejilla-2 { grid-template-columns: repeat(2, 1fr); }
  }
  .sitios { display: grid; gap: 48px 32px; }
  @media (min-width: 860px) { .sitios { grid-template-columns: 1fr 1fr; } }
  .sitio { display: grid; gap: 18px; text-decoration: none; align-content: start; }
  .sitio-marco { display: block; border-radius: 8px; overflow: hidden; background: var(--carbon); box-shadow: 0 30px 60px -34px rgba(23, 19, 15, 0.55); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .sitio:hover .sitio-marco { transform: translateY(-4px); box-shadow: 0 40px 70px -34px rgba(23, 19, 15, 0.6); }
  .sitio-barra { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--carbon-2); }
  .sitio-barra i { width: 9px; height: 9px; border-radius: 50%; background: var(--carbon-3); }
  .sitio-barra .meta { margin-left: 10px; font-size: 0.75rem; color: var(--hueso-2); }
  .sitio-marco :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .sitio-texto { display: grid; gap: 6px; }
  .sitio-texto .texto-2 { font-size: 1rem; max-width: 48ch; }
  .musica { margin-top: clamp(80px, 10vw, 136px); display: grid; gap: 40px; }
  .musica-cabeza { display: grid; gap: 12px 48px; }
  .musica-cabeza p { margin: 0; max-width: 52ch; }
  @media (min-width: 900px) {
    .musica-cabeza { grid-template-columns: 1fr 1fr; align-items: end; }
  }
</style>
