---
// Manual de marca de Dial, v5 (29 oct 2026): de la pantalla a la materia. El aro de pluma, «dial» en Fraunces suave,
// una sola luz roja, letras sin mono y fotos reveladas con película. Martín aprobó el camino B (la pluma) el 29 oct.
// Antes: v4 (24 oct, el aro con punto) y v3.2 (una sola estética con Al Aire). Página sin indexar: se comparte por enlace o como PDF.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Simbolo from '../components/Simbolo.astro';
import Sintonizador from '../components/Sintonizador.astro';

const decisiones = [
  {
    area: 'Símbolo',
    antes: 'El aro con punto de la v4: un trazo parejo, como hecho con compás.',
    ahora: 'El mismo aro, trazado como la o de una pluma de punta ancha: grueso a los lados, fino arriba y abajo.',
    porque: 'Conserva todo lo que se eligió en la v4 (medidas, punto a 45°, estaciones) y lo vuelve hecho a mano. Es análogo hasta en un favicon.',
  },
  {
    area: 'Logotipo',
    antes: '«dial» en Instrument Sans Bold y el apellido en terracota cursiva.',
    ahora: '«dial» en Fraunces suave, una serif de imprenta con las esquinas redondeadas por la tinta. El apellido, en Fraunces cursiva y en la misma tinta.',
    porque: 'La grotesca negra era neutra y de pantalla. Crema, terracota y cursiva juntas es la combinación que más se repite en las marcas generadas.',
  },
  {
    area: 'Color',
    antes: 'Carbón, papel, hueso, terracota y brasa en todo.',
    ahora: 'Negro de película, papel y una sola luz roja: el punto. La foto pone el color.',
    porque: 'Un punto rojo solo se ve más que un rojo repartido. Cada línea de noticias trae sus propios colores.',
  },
  {
    area: 'Letras',
    antes: 'Grotesca para titular, rótulos en caja y mono para datos.',
    ahora: 'Instrument Serif para titular, Bricolage Grotesque para leer, versalitas de Instrument Sans para rotular. Sin mono.',
    porque: 'La mono en mayúsculas y las cajas eran lo que más delataba una pieza hecha en pantalla.',
  },
  {
    area: 'Materia',
    antes: 'Un moteado de impresión digital y fotos tal como salen del sensor.',
    ahora: 'Procesos reales: película, tinta de imprenta, papel de fibra y kraft.',
    porque: 'Lo aprendimos con Termómetro: lo análogo no es un filtro, es mostrar el mundo como se toca.',
  },
];

const luces = [
  { titulo: 'Al aire', texto: 'El piloto rojo de la cabina de radio: se enciende y alguien habla. Es el dial ya sintonizado.' },
  { titulo: 'Grabando', texto: 'El punto rojo de la cámara cuando rueda. Dial es documental y debate: estamos registrando.' },
  { titulo: 'Revelando', texto: 'La luz roja del cuarto oscuro, la única que no vela la copia. Bajo ella aparece la imagen.' },
];

const estaciones = [
  { nombre: 'Arte y memoria', angulo: -90, proceso: 'Cuarto oscuro' },
  { nombre: 'Nuevos mundos posibles', angulo: -45, proceso: 'Cianotipo' },
  { nombre: 'Al Aire', angulo: 0, proceso: 'Imprenta' },
  { nombre: 'Tecnología y poder', angulo: 45, proceso: 'Plancha y sello' },
  { nombre: 'Termómetro', angulo: 90, proceso: 'Película y tiza' },
];

const colores = [
  { nombre: 'Negro de película', hex: '#1F1C19', rgb: '31 · 28 · 25', rol: 'Fondos oscuros y texto sobre claro. Negro levantado, nunca puro.', clase: 'c-carbon', proporcion: '40 %' },
  { nombre: 'Papel', hex: '#F4EEE5', rgb: '244 · 238 · 229', rol: 'Fondo claro y toda la letra sobre negro y sobre fotos.', clase: 'c-papel', proporcion: '40 %' },
  { nombre: 'Papel de fibra', hex: '#EBE3D6', rgb: '235 · 227 · 214', rol: 'Segunda superficie clara.', clase: 'c-hueso', proporcion: '15 %' },
  { nombre: 'Kraft', hex: '#BFA078', rgb: '191 · 160 · 120', rol: 'Solo en impresos: sellos, bolsas, pegatinas.', clase: 'c-kraft', proporcion: '—' },
  { nombre: 'Luz roja', hex: '#D4512E', rgb: '212 · 81 · 46', rol: 'Solo el punto. Una por pieza.', clase: 'c-terracota', proporcion: '1 %' },
];

const funcionales = [
  { nombre: 'Luz para texto en claro', hex: '#A83B1E', uso: 'Rótulos pequeños sobre papel' },
  { nombre: 'Luz para texto en negro', hex: '#E0653F', uso: 'Rótulos pequeños sobre negro' },
  { nombre: 'Humo', hex: '#5F574F', uso: 'Texto secundario sobre papel' },
  { nombre: 'Plata', hex: '#B5ACA0', uso: 'Texto secundario sobre negro' },
];

const escala = [
  { nivel: 'Titular', muestra: ['Contamos, ', 'y medimos,', ' el encuentro'], clase: 'm-d1', spec: 'Instrument Serif · regular · −1,2 % · interlineado 0,94–1. El acento en cursiva, en la misma tinta' },
  { nivel: 'Titular de sección', muestra: ['Historias que ', 'transforman.', ''], clase: 'm-d2', spec: 'Instrument Serif · regular · interlineado 0,96' },
  { nivel: 'Subtítulo', muestra: ['Cobertura de proyecto', '', ''], clase: 'm-sub', spec: 'Bricolage Grotesque · 600 · ancho 92 %' },
  { nivel: 'Texto', muestra: ['Producimos historias reales de personas, comunidades y organizaciones.', '', ''], clase: 'm-texto', spec: 'Bricolage Grotesque · 380 · ancho 92 % · 17–18 px · interlineado 1,6' },
  { nivel: 'Resaltado', muestra: ['La reserva se firmó ', '«a último minuto»', '.'], clase: 'm-resalte', spec: 'Bricolage en negrilla sobre franja de tinta negro grisácea. Una o dos por pieza' },
  { nivel: 'Rótulo', muestra: ['Al Aire · Bogotá · 17 oct 2026', '', ''], clase: 'm-rotulo', spec: 'Instrument Sans · 600 · versalitas · +16 % · con el punto de luz delante' },
  { nivel: 'Dato', muestra: ['1:07:36 · 66.735 vistas', '', ''], clase: 'm-dato', spec: 'Bricolage Grotesque · cifras tabulares · nunca mono' },
];

// Enlaces absolutos: funcionan también dentro del PDF.
const M = 'https://dialmedio.org/marca/';
const descargas = [
  ['Firma (símbolo + logotipo)', 'dial-firma-oscuro', 'dial-firma-claro'],
  ['Logotipo', 'dial-logotipo-oscuro', 'dial-logotipo-claro'],
  ['Símbolo', 'dial-simbolo-oscuro', 'dial-simbolo-claro'],
  ['Dial Impacto', 'dial-impacto-oscuro', 'dial-impacto-claro'],
  ['Dial Encuentros', 'dial-encuentros-oscuro', 'dial-encuentros-claro'],
  ['Dial Medio', 'dial-medio-oscuro', 'dial-medio-claro'],
  ['Dial Impacto · solo letras', 'dial-impacto-letras-oscuro', 'dial-impacto-letras-claro'],
  ['Dial Encuentros · solo letras', 'dial-encuentros-letras-oscuro', 'dial-encuentros-letras-claro'],
  ['Dial Medio · solo letras', 'dial-medio-letras-oscuro', 'dial-medio-letras-claro'],
  ['Dial Impacto · centrado', 'dial-impacto-centrado-oscuro', 'dial-impacto-centrado-claro'],
  ['Dial Encuentros · centrado', 'dial-encuentros-centrado-oscuro', 'dial-encuentros-centrado-claro'],
  ['Dial Medio · centrado', 'dial-medio-centrado-oscuro', 'dial-medio-centrado-claro'],
];
// Cuadradas, con aire para el recorte circular de las redes
const perfiles = [
  ['símbolo', 'simbolo'],
  ['Dial', 'dial'],
  ['Dial Impacto', 'impacto'],
  ['Dial Encuentros', 'encuentros'],
  ['Dial Medio', 'medio'],
];
---

<Base titulo="Manual de marca v5" descripcion="Manual de marca de Dial: el aro de pluma, la luz roja, color, letras, materia, fotografía y voz." noindex>
  <!-- PORTADA -->
  <section class="m-portada tema-carbon grano">
    <div class="contenedor m-portada-grid">
      <div class="m-portada-texto">
        <p class="kicker"><span class="acento">Manual de marca</span> · v5 · Octubre 2026</p>
        <h1 class="m-portada-logo"><Logo tono="claro" titulo="Dial" /></h1>
        <p class="lead-xl">De la pantalla <em>a la materia.</em></p>
        <p class="lead texto-2">
          La v5 lleva a toda la casa lo que aprendimos con Termómetro: el aro trazado a pluma, letras con tinta, una sola luz
          roja y fotos reveladas con película. Conserva lo esencial: el nombre en minúsculas, el aro, sus estaciones y el lema.
        </p>
      </div>
      <Simbolo tono="claro" anima class="m-portada-simbolo" titulo="Símbolo de Dial" />
    </div>
    <div class="contenedor"><Sintonizador /></div>
  </section>

  <!-- 01 DECISIONES -->
  <section class="seccion tema-papel" id="decisiones">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">01 — Qué cambió</p>
          <h2 class="display d-2">Cinco decisiones.</h2>
        </div>
        <p class="texto-2">Todo lo demás se desprende de estas cinco. Si una pieza duda, vuelve aquí.</p>
      </header>
      <ol class="decisiones">
        {
          decisiones.map((d) => (
            <li>
              <p class="kicker sin-linea">{d.area}</p>
              <dl>
                <div><dt class="meta">Antes</dt><dd class="texto-2">{d.antes}</dd></div>
                <div><dt class="meta">Ahora</dt><dd class="d-ahora">{d.ahora}</dd></div>
                <div><dt class="meta">Por qué</dt><dd class="texto-2">{d.porque}</dd></div>
              </dl>
            </li>
          ))
        }
      </ol>
      <div class="antes-despues">
        <figure><img src="/marca/v5/antes-digital.jpg" alt="Foto del plantón frente al Museo Nacional, sin tratar" loading="lazy" width="900" height="600" /><figcaption class="meta">Antes: tal como sale del sensor</figcaption></figure>
        <figure><img src="/marca/v5/despues-pelicula.jpg" alt="La misma foto revelada con película" loading="lazy" width="900" height="600" /><figcaption class="meta">Ahora: revelada con película · Foto: Martín Perea / Dial</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- 02 LA IDEA -->
  <section class="seccion tema-carbon grano" id="idea">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">02 — La idea</p>
          <h2 class="display d-2">Una sola <em>luz roja.</em></h2>
        </div>
        <p class="texto-2">
          En cada medio análogo hay una lucecita roja que avisa que algo está pasando. La de Dial es el punto del aro, y es el
          único color de la marca madre. Por eso el rojo va solo en el punto.
        </p>
      </header>
      <ul class="luces">
        {luces.map((l) => (
          <li>
            <span class="foco" aria-hidden="true" />
            <h3 class="sub s-2">{l.titulo}</h3>
            <p class="texto-2">{l.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 LOGOTIPO -->
  <section class="seccion tema-hueso" id="logotipo">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">03 — Logotipo</p>
          <h2 class="display d-2">El punto es la voz.</h2>
        </div>
        <p class="texto-2">
          «dial» en Fraunces suave (peso 600, suavidad 100, tamaño óptico 144), en minúsculas. El punto de la i es el nodo del
          símbolo, siempre en luz roja. Se dibuja como trazo: no hace falta instalar la letra.
        </p>
      </header>

      <div class="logos">
        <div class="logo-caja c-papel"><Logo tono="oscuro" /></div>
        <div class="logo-caja c-carbon"><Logo tono="claro" /></div>
        <div class="logo-caja c-kraft"><Logo tono="oscuro" /></div>
      </div>
      <ul class="notas">
        <li><strong>Protección:</strong> alrededor del logotipo, un espacio libre igual al alto de la letra d.</li>
        <li><strong>Tamaño mínimo:</strong> 64 px de ancho en pantalla, 18 mm impreso.</li>
        <li><strong>Impreso:</strong> en piezas sobre foto, papel o kraft el logo se imprime con tinta (borde mordido, carga desigual). El vector limpio queda para tamaños pequeños y el sitio.</li>
        <li><strong>No:</strong> deformar, cambiar el color del punto, poner el apellido en otro color, contornos, sombras ni degradados.</li>
      </ul>

      <h3 class="sub s-1 m-h3">Firmas por línea</h3>
      <p class="texto-2 m-p">El apellido va en Fraunces cursiva, a la derecha y en la misma tinta que «dial». Solo el punto lleva color.</p>
      <div class="firmas">
        {(['impacto', 'encuentros', 'medio'] as const).map((l) => (
          <div class="logo-caja c-papel firma"><Logo tono="oscuro" linea={l} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 SÍMBOLO -->
  <section class="seccion tema-carbon grano" id="simbolo">
    <div class="contenedor simbolo-grid">
      <div>
        <p class="kicker">04 — Símbolo</p>
        <h2 class="display d-2">Un dial trazado <em>a pluma.</em></h2>
        <p class="texto-2 m-p">
          El aro de la v4, con sus medidas (caja de 200: radio 84, punto 24,9, aire 9,4), trazado como la o de una pluma de punta
          ancha. El grosor cambia con un eje de pluma a −28°: el trazo crece un 12 % a los lados y baja al 42 % en lo más fino.
          El punto de luz roja va a 45°, separado por un respiro.
        </p>
        <ul class="notas claro">
          <li><strong>Completo:</strong> desde 24 px.</li>
          <li><strong>Compacto</strong> (aro más grueso, punto un poco mayor): por debajo de 24 px, favicon y sellos.</li>
          <li><strong>Animado:</strong> el aro se traza con la pluma desde el punto y la luz se enciende.</li>
          <li><strong>Nunca</strong> marcas alrededor del aro (parece un sol) ni el punto en la mitad de abajo (se lee como Q).</li>
        </ul>
      </div>
      <div class="simbolos">
        <div class="s-grande"><Simbolo tono="claro" /></div>
        <div class="s-fila">
          <div><Simbolo tono="claro" /><span class="meta">64 px</span></div>
          <div class="s-32"><Simbolo tono="claro" detalle="compacto" /><span class="meta">32 px · compacto</span></div>
          <div class="s-20"><Simbolo tono="claro" detalle="compacto" /><span class="meta">20 px · compacto</span></div>
        </div>
      </div>
    </div>
    <div class="contenedor">
      <h3 class="sub s-1 m-h3">Estaciones: un proceso análogo por línea</h3>
      <p class="texto-2 m-p">
        Las líneas de noticias giran el punto por la mitad de arriba, como estaciones de un mismo dial. Cada una tiene además
        su propio proceso, para que el feed sea variado y todo siga siendo Dial.
      </p>
      <ul class="estaciones">
        {estaciones.map((e) => (
          <li>
            <Simbolo tono="claro" angulo={e.angulo} />
            <span class="grados">{e.angulo === 0 ? '0°' : (e.angulo > 0 ? '+' : '−') + Math.abs(e.angulo) + '°'}</span>
            <span class="kicker sin-linea">{e.nombre}</span>
            <span class="texto-2">{e.proceso}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 COLOR -->
  <section class="seccion tema-papel" id="color">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">05 — Color</p>
          <h2 class="display d-2">Negro, papel y <em>una luz.</em></h2>
        </div>
        <p class="texto-2">
          La marca madre deja de pintar: la foto pone el color. Dial pone el negro donde se revela, el papel donde se imprime y
          la luz roja en el punto. La brasa se queda en Al Aire y Termómetro, donde ya trabaja.
        </p>
      </header>
      <div class="colores">
        {
          colores.map((c) => (
            <article class="color">
              <div class:list={['muestra', c.clase]} />
              <h3 class="sub s-2">{c.nombre}</h3>
              <p class="meta">{c.hex} · RGB {c.rgb}</p>
              <p class="texto-2">{c.rol}</p>
              <p class="meta">Proporción {c.proporcion}</p>
            </article>
          ))
        }
      </div>
      <h3 class="sub s-1 m-h3">Variaciones para texto</h3>
      <table class="tabla">
        <thead><tr><th>Nombre</th><th>Hex</th><th>Uso</th></tr></thead>
        <tbody>
          {funcionales.map((f) => (
            <tr><td><span class="punto" style={`background:${f.hex}`} />{f.nombre}</td><td class="meta">{f.hex}</td><td>{f.uso}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="texto-2 m-p">La luz roja como texto, solo en rótulos pequeños. Botones en tinta (negro sobre papel, papel sobre negro); al pasar el cursor se enciende la luz.</p>
    </div>
  </section>

  <!-- 06 LETRAS -->
  <section class="seccion tema-hueso" id="tipografia">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">06 — Letras</p>
          <h2 class="display d-2">Cuatro voces, <em>todas libres.</em></h2>
        </div>
        <p class="texto-2">Todas de licencia abierta (OFL), en Google Fonts. Ninguna es mono.</p>
      </header>
      <div class="familias">
        <article>
          <p class="kicker sin-linea">Solo el logotipo</p>
          <p class="fam fam-logo"><Logo tono="oscuro" linea="medio" /></p>
          <p class="texto-2">Fraunces suave. Nunca en titulares: así el logo no se gasta.</p>
        </article>
        <article>
          <p class="kicker sin-linea">Titulares</p>
          <p class="fam fam-serif">Instrument Serif</p>
          <p class="texto-2">La voz de los titulares, en el sitio y en las láminas. El acento en cursiva, en la misma tinta.</p>
        </article>
        <article>
          <p class="kicker sin-linea">Para leer</p>
          <p class="fam fam-brico">Bricolage</p>
          <p class="texto-2">Bricolage Grotesque: texto, subtítulos, botones y cifras. La eligió Martín para Termómetro por indie y análoga.</p>
        </article>
        <article>
          <p class="kicker sin-linea">Para rotular</p>
          <p class="fam fam-rotulo">Instrument Sans</p>
          <p class="texto-2">Versalitas espaciadas para antetítulos, fechas y créditos. Sin caja.</p>
        </article>
      </div>
      <ol class="escala-tipo">
        {
          escala.map((e) => (
            <li>
              <span class="meta">{e.nivel}</span>
              <span class={e.clase}>{e.muestra[0]}{e.muestra[1] && (e.clase === 'm-resalte' ? <b>{e.muestra[1]}</b> : <em>{e.muestra[1]}</em>)}{e.muestra[2]}</span>
              <span class="meta spec">{e.spec}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 07 MATERIA -->
  <section class="seccion tema-carbon grano" id="materia">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">07 — Materia</p>
          <h2 class="display d-2">Lo que se <em>toca.</em></h2>
        </div>
        <p class="texto-2">
          Cada textura imita un proceso físico real, con sus defectos a la escala correcta. Si algo parece hecho en pantalla,
          sobra: nada de neón, brillos, degradados ni cajas redondeadas.
        </p>
      </header>
      <div class="materias">
        <article>
          <img src="/marca/v5/despues-pelicula.jpg" alt="Foto revelada con película" loading="lazy" width="900" height="600" />
          <h3 class="sub s-2">Película</h3>
          <p class="texto-2">Grano fino, halo tibio en las luces, negros levantados, una fuga de luz distinta cada vez, viñeta y algo de polvo. Es la función <code>pelicula()</code> del kit de noticias.</p>
        </article>
        <article>
          <img src="/marca/v5/perfil.png" alt="El aro impreso con tinta sobre negro" loading="lazy" width="560" height="560" class="cuadrada" />
          <h3 class="sub s-2">Tinta</h3>
          <p class="texto-2">Cuando el logo va sobre algo, se imprime: borde mordido, carga desigual, la veta del tipo de madera. Es la función <code>tinta()</code> de Al Aire.</p>
        </article>
        <article>
          <img src="/marca/v5/impresos.jpg" alt="Tarjeta, pegatina y sello sobre papel kraft" loading="lazy" width="1100" height="715" />
          <h3 class="sub s-2">Papel</h3>
          <p class="texto-2">Papel de fibra para lo claro y kraft para lo impreso: tarjetas en letterpress, pegatinas, sellos de caucho.</p>
        </article>
        <article>
          <img src="/marca/v5/video-tercio.jpg" alt="Fotograma de video con el aro como marca de agua" loading="lazy" width="1400" height="788" />
          <h3 class="sub s-2">Luz</h3>
          <p class="texto-2">En video, el aro va de marca de agua y el punto puede encenderse con un halo leve, como un piloto. Tercios en serif cursiva y versalitas.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 08 FOTOGRAFÍA -->
  <section class="seccion tema-papel" id="fotografia">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">08 — Fotografía</p>
          <h2 class="display d-2">La foto propia, <em>primero.</em></h2>
        </div>
        <p class="texto-2">Todas reveladas con la misma película, para que el feed se vea como un solo cuerpo de trabajo.</p>
      </header>
      <div class="fotos">
        <figure><img src="/marca/v5/foto-planton-danza.jpg" alt="Bailarina frente al Museo Nacional, Bogotá" loading="lazy" width="600" height="750" /><figcaption class="meta">Martín Perea / Dial</figcaption></figure>
        <figure><img src="/marca/v5/foto-nukak-fruta.jpg" alt="Mujeres nukak comiendo frutas del monte" loading="lazy" width="600" height="750" /><figcaption class="meta">Galo Naranjo · dominio público</figcaption></figure>
