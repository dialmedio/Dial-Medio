---
// Manual de marca de Dial Medio, v6 (18 nov 2026): la productora. Dial deja de presentarse como medio de comunicación
// y pasa a ser productora audiovisual asociada a Fototoma (música) y a la RED Quynza (investigación). «Medio» = punto medio.
// Conserva de la v5 el logotipo en Fraunces, el aro de pluma y la luz roja. Cambia: casa oscura, texto en Instrument Sans,
// imagen en formato de cine, créditos compartidos. PROPUESTA hasta que Martín la apruebe.
// Antes: v5 (29 oct, la pluma), v4 (24 oct, el aro) y v3.2. Página sin indexar: se comparte por enlace o como PDF.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Simbolo from '../components/Simbolo.astro';
import Sintonizador from '../components/Sintonizador.astro';
import palenque from '../assets/estudio/palenque.jpg';
import liveSession from '../assets/estudio/live-session.jpg';
import feoPalante from '../assets/estudio/feo-palante.jpg';

const decisiones = [
  { area: 'Idea', antes: 'Un medio cultural: noticias, opinión, podcast y documental.', ahora: 'Una productora audiovisual. «Medio» quiere decir punto medio: el lugar desde donde una historia se cuenta con datos y sin caricatura.', porque: 'Abre la puerta a clientes de todos los sectores sin dejar de lado lo social, que sigue siendo el centro de la obra propia.' },
  { area: 'Casa', antes: 'Una sombrilla con líneas: Impacto, Encuentros, Medio y Estudio.', ahora: 'Una sola marca, Dial Medio, con seis servicios. Fototoma hace la música y la RED Quynza investiga.', porque: 'Cuatro apellidos confundían. Cada casa conserva su marca y firman juntas en los créditos.' },
  { area: 'Letras', antes: 'Bricolage Grotesque para leer.', ahora: 'Instrument Sans para leer y para los créditos. Instrument Serif sigue en los titulares.', porque: 'Bricolage era de revista indie. Instrument Sans es más sobria y se parece a la letra de los créditos de cine.' },
  { area: 'Superficie', antes: 'Papel claro por defecto, negro en algunas secciones.', ahora: 'Negro por defecto, como una sala. El papel queda para leer y para respirar entre secciones oscuras.', porque: 'La imagen se ve mejor sobre negro, y una productora se presenta con imagen.' },
  { area: 'Imagen', antes: 'Láminas 4:5 con procesos de imprenta, cianotipo y cuarto oscuro.', ahora: 'El fotograma ancho (2,39:1 y 16:9) a sangre. Los procesos de imprenta pasan al servicio de diseño de comunicación.', porque: 'Lo que vendemos es imagen en movimiento. El kit de láminas sigue vivo como oficio para clientes.' },
];

const luces = [
  { titulo: 'Grabando', texto: 'El punto rojo de la cámara cuando rueda. Es lo que hacemos.' },
  { titulo: 'Revelando', texto: 'La luz roja del cuarto oscuro, la única que no vela la copia. La investigación y el montaje pasan ahí.' },
  { titulo: 'Sintonizado', texto: 'La aguja del dial cuando encuentra la señal. El punto medio.' },
];

const casas = [
  { rol: 'Imagen, dirección y producción', nombre: 'Dial Medio', url: 'https://dialmedio.org' },
  { rol: 'Música original y diseño sonoro', nombre: 'Fototoma', url: 'https://fototomaproducciones.com' },
  { rol: 'Investigación', nombre: 'RED Quynza', url: 'https://redquynza.org' },
];

const firmas = [
  ['Obra de Dial', 'Una producción de Dial Medio · Música original de Fototoma'],
  ['Con la RED', 'RED Quynza en coproducción con Dial Medio (o al revés, según de quién sea la iniciativa)'],
  ['Para un cliente', 'Una producción de Dial Medio para [cliente] · Investigación: RED Quynza · Música: Fototoma'],
  ['Diseño para terceros', 'Diseño: Dial Medio, pequeño y al final. La pieza lleva la marca del cliente.'],
];

const colores = [
  { nombre: 'Negro de película', hex: '#1F1C19', rgb: '31 · 28 · 25', rol: 'La casa: fondos, cabecera y pie. Negro levantado, nunca puro.', clase: 'c-carbon', proporcion: '60 %' },
  { nombre: 'Negro de sala', hex: '#0F0D0C', rgb: '15 · 13 · 12', rol: 'Solo detrás de la imagen: bandas de cine y cajas de video.', clase: 'c-sala', proporcion: '—' },
  { nombre: 'Papel', hex: '#F4EEE5', rgb: '244 · 238 · 229', rol: 'Secciones para leer y toda la letra sobre negro.', clase: 'c-papel', proporcion: '30 %' },
  { nombre: 'Papel de fibra', hex: '#EBE3D6', rgb: '235 · 227 · 214', rol: 'Segunda superficie clara.', clase: 'c-hueso', proporcion: '9 %' },
  { nombre: 'Luz roja', hex: '#D4512E', rgb: '212 · 81 · 46', rol: 'El punto. Una por pieza: la i, el REC, un número.', clase: 'c-terracota', proporcion: '1 %' },
];

const funcionales = [
  { nombre: 'Luz para texto en claro', hex: '#A83B1E', uso: 'Rótulos pequeños sobre papel' },
  { nombre: 'Luz para texto en negro', hex: '#E0653F', uso: 'Rótulos y números sobre negro' },
  { nombre: 'Humo', hex: '#5F574F', uso: 'Texto secundario sobre papel' },
  { nombre: 'Plata', hex: '#B5ACA0', uso: 'Texto secundario sobre negro' },
];

const escala = [
  { nivel: 'Titular', muestra: ['Investigamos antes de ', 'filmar.', ''], clase: 'm-d1', spec: 'Instrument Serif · regular · interlineado 0,94. El acento en cursiva, en la misma tinta' },
  { nivel: 'Titular de sección', muestra: ['Del comercial al ', 'documental.', ''], clase: 'm-d2', spec: 'Instrument Serif · regular · interlineado 0,96' },
  { nivel: 'Texto', muestra: ['Hacemos publicidad, videoclips, eventos y documental, con investigación detrás.', '', ''], clase: 'm-texto', spec: 'Instrument Sans · 400 · ancho 96 % · 17–18 px · interlineado 1,6' },
  { nivel: 'Crédito', muestra: ['Dirección · Martín Perea', '', ''], clase: 'm-rotulo', spec: 'Instrument Sans · 600 · versalitas · +16 %. Rol en versalitas, nombre en serif cuando es grande' },
  { nivel: 'Rótulo', muestra: ['Productora audiovisual · Bogotá', '', ''], clase: 'm-rotulo con-punto', spec: 'Instrument Sans · 600 · versalitas · con el punto de luz delante' },
];

// Enlaces absolutos: funcionan también dentro del PDF.
const M = 'https://dialmedio.org/marca/';
const descargas = [
  ['Dial Medio (firma principal)', 'dial-medio-oscuro', 'dial-medio-claro'],
  ['Dial Medio · solo letras', 'dial-medio-letras-oscuro', 'dial-medio-letras-claro'],
  ['Dial Medio · centrado', 'dial-medio-centrado-oscuro', 'dial-medio-centrado-claro'],
  ['Logotipo «dial»', 'dial-logotipo-oscuro', 'dial-logotipo-claro'],
  ['Símbolo', 'dial-simbolo-oscuro', 'dial-simbolo-claro'],
  ['Firma (símbolo + logotipo)', 'dial-firma-oscuro', 'dial-firma-claro'],
];
const perfiles = [
  ['símbolo', 'simbolo'],
  ['Dial Medio', 'medio'],
  ['Dial', 'dial'],
];
---

<Base titulo="Manual de marca v6" descripcion="Manual de marca de Dial Medio, productora audiovisual: idea, casa, logotipo, símbolo, color, letras, imagen, créditos y voz." noindex>
  <!-- PORTADA -->
  <section class="m-portada tema-carbon grano">
    <div class="contenedor m-portada-grid">
      <div class="m-portada-texto">
        <p class="kicker"><span class="acento">Manual de marca</span> · v6 · Noviembre 2026 · Propuesta</p>
        <h1 class="m-portada-logo"><Logo tono="claro" linea="medio" titulo="Dial Medio" /></h1>
        <p class="lead-xl">El punto <em>medio.</em></p>
        <p class="lead texto-2">
          La v6 acompaña el paso de Dial a productora audiovisual, junto a Fototoma y la RED Quynza. Conserva el logotipo, el aro de pluma y la luz roja de la
          v5. Cambia la casa a negro, el texto a Instrument Sans y pone la imagen en formato de cine.
        </p>
      </div>
      <Simbolo tono="claro" anima class="m-portada-simbolo" titulo="Símbolo de Dial" />
    </div>
    <div class="contenedor"><Sintonizador frecuencia={1110} /></div>
  </section>

  <!-- 01 DECISIONES -->
  <section class="seccion tema-papel" id="decisiones">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">01 — Qué cambia</p>
          <h2 class="display d-2">De la v5 a la <em>v6.</em></h2>
        </div>
        <p class="texto-2">Cinco decisiones. Lo que no aparece aquí sigue igual que en la v5.</p>
      </header>
      <ol class="decisiones">
        {
          decisiones.map((d) => (
            <li>
              <h3 class="sub s-1">{d.area}</h3>
              <dl>
                <div><dt class="rotulo">Antes</dt><dd class="texto-2">{d.antes}</dd></div>
                <div><dt class="rotulo">Ahora</dt><dd class="d-ahora">{d.ahora}</dd></div>
                <div><dt class="rotulo">Por qué</dt><dd class="texto-2">{d.porque}</dd></div>
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 02 IDEA -->
  <section class="seccion tema-carbon grano" id="idea">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">02 — Idea</p>
          <h2 class="display d-2">Un dial busca el <em>punto medio.</em></h2>
        </div>
        <p class="texto-2">
          La aguja recorre el dial hasta encontrar la señal. Dial Medio trabaja con todos los sectores y busca en cada historia el lugar desde donde se puede
          contar con datos verificados, para que la entienda quien está de acuerdo y también quien no. La luz roja es el punto donde se detiene.
        </p>
      </header>
      <ul class="luces">
        {luces.map((l) => <li><span class="foco" aria-hidden="true" /><h3 class="sub s-2">{l.titulo}</h3><p class="texto-2">{l.texto}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- 03 LA CASA -->
  <section class="seccion tema-hueso" id="casa">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">03 — La casa</p>
          <h2 class="display d-2">Tres marcas que <em>firman juntas.</em></h2>
        </div>
        <p class="texto-2">Cada casa conserva su logo, sus colores y su voz. Nunca se funden en un logo nuevo: se juntan en los créditos.</p>
      </header>
      <dl class="creditos m-casas">
        {casas.map((c) => <div><dt>{c.rol}</dt><dd><a href={c.url} target="_blank" rel="noopener">{c.nombre}</a></dd></div>)}
      </dl>
      <h3 class="sub s-1 m-h3">Cómo se firma</h3>
      <table class="tabla">
        <thead><tr><th>Caso</th><th>Firma</th></tr></thead>
        <tbody>{firmas.map(([c, f]) => <tr><td>{c}</td><td>{f}</td></tr>)}</tbody>
      </table>
      <ul class="notas">
        <li><strong>Logos juntos:</strong> a la misma altura visual, en una fila, separados por un filete fino. Dial Medio va primero si la pieza es suya.</li>
        <li><strong>Servicios:</strong> son seis y se nombran en texto (Documental y campañas sociales, Publicidad y marcas, Videoclips y sesiones en vivo, Eventos y cobertura, Divulgación de investigación, Diseño de comunicación). No llevan logo propio.</li>
        <li><strong>Las firmas viejas</strong> (Dial Impacto, Dial Encuentros, Dial Estudio) ya no se usan. Los archivos siguen en /marca para piezas antiguas.</li>
      </ul>
    </div>
  </section>

  <!-- 04 LOGOTIPO -->
  <section class="seccion tema-papel" id="logotipo">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">04 — Logotipo</p>
          <h2 class="display d-2">El punto es la <em>señal.</em></h2>
        </div>
        <p class="texto-2">
          La firma principal es «dial medio»: «dial» en Fraunces suave 600 y «medio» en Fraunces cursiva, en la misma tinta. El punto de la i, en luz roja. Se
          dibuja como trazo: no hace falta instalar la letra.
        </p>
      </header>
      <div class="logos">
        <div class="logo-caja c-carbon"><Logo tono="claro" linea="medio" /></div>
        <div class="logo-caja c-papel"><Logo tono="oscuro" linea="medio" /></div>
        <div class="logo-caja sobre-foto">
          <Image src={liveSession} alt="" widths={[640, 1000]} sizes="(min-width: 900px) 33vw, 100vw" />
          <Logo tono="claro" linea="medio" />
        </div>
      </div>
      <ul class="notas">
        <li><strong>«dial» solo:</strong> cuando el espacio es chico (favicon, marca de agua, sello) o cuando «Dial Medio» ya se lee cerca.</li>
        <li><strong>Protección:</strong> alrededor del logotipo, un espacio libre igual al alto de la letra d.</li>
        <li><strong>Tamaño mínimo:</strong> 96 px de ancho en pantalla y 24 mm impreso para «dial medio»; 64 px y 18 mm para «dial».</li>
        <li><strong>Sobre imagen:</strong> en papel, sobre la zona oscura del fotograma. Si la imagen no tiene zona oscura, se baja con un velo negro, nunca con una caja.</li>
        <li><strong>No:</strong> deformar, cambiar el color del punto, poner «medio» en otro color, contornos, sombras ni degradados.</li>
      </ul>
    </div>
  </section>

  <!-- 05 SÍMBOLO -->
  <section class="seccion tema-carbon grano" id="simbolo">
    <div class="contenedor simbolo-grid">
      <div>
        <p class="kicker">05 — Símbolo</p>
        <h2 class="display d-2">El aro, <em>igual que en la v5.</em></h2>
        <p class="texto-2 m-p">
          El aro trazado como la o de una pluma de punta ancha (caja de 200: radio 84, punto 24,9, aire 9,4; eje −28°). El punto de luz roja va a 45°. En la
          v6 deja de girar por estaciones: esas eran las líneas de noticias.
        </p>
        <ul class="notas claro">
          <li><strong>Completo:</strong> desde 24 px. <strong>Compacto</strong> por debajo: favicon y sellos.</li>
          <li><strong>En video:</strong> marca de agua abajo a la derecha, al 60 %, y el logo animado al final (la i lanza el punto).</li>
          <li><strong>Nunca</strong> marcas alrededor del aro (parece un sol) ni el punto en la mitad de abajo (se lee como Q).</li>
        </ul>
      </div>
      <div class="simbolos">
        <div class="s-grande"><Simbolo tono="claro" /></div>
        <div class="s-fila">
          <div><Simbolo tono="claro" /><span class="meta">64 px</span></div>
          <div class="s-32"><Simbolo tono="claro" detalle="compacto" /><span class="meta">32 px · compacto</span></div>
          <div class="s-20"><Simbolo tono="claro" detalle="compacto" /><span class="meta">20 px · compacto</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 COLOR -->
  <section class="seccion tema-papel" id="color">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">06 — Color</p>
          <h2 class="display d-2">Negro de sala y <em>una luz.</em></h2>
        </div>
        <p class="texto-2">La paleta de la v5 con otra proporción: ahora manda el negro. El color lo pone la imagen. La brasa de Al Aire queda solo para el kit de diseño.</p>
      </header>
      <div class="colores">
        {
          colores.map((c) => (
            <article class="color">
              <div class:list={['muestra', c.clase]} />
              <h3 class="sub s-2">{c.nombre}</h3>
              <p class="meta">{c.hex} · RGB {c.rgb}</p>
              <p class="texto-2">{c.rol}</p>
              <p class="meta">Proporción {c.proporcion}</p>
            </article>
          ))
        }
      </div>
      <h3 class="sub s-1 m-h3">Variaciones para texto</h3>
      <table class="tabla">
        <thead><tr><th>Nombre</th><th>Hex</th><th>Uso</th></tr></thead>
        <tbody>
          {funcionales.map((f) => <tr><td><span class="punto" style={`background:${f.hex}`} />{f.nombre}</td><td class="meta">{f.hex}</td><td>{f.uso}</td></tr>)}
        </tbody>
      </table>
      <p class="texto-2 m-p">
        Junto a Fototoma: su único acento es el sol ámbar (#E0A84E) y el nuestro la luz roja. En una pieza compartida cada logo lleva su luz y el resto de la
        pieza va en negro y papel.
      </p>
    </div>
  </section>

  <!-- 07 LETRAS -->
  <section class="seccion tema-hueso" id="tipografia">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">07 — Letras</p>
          <h2 class="display d-2">Tres letras, <em>todas libres.</em></h2>
        </div>
        <p class="texto-2">Licencia abierta (OFL), en Google Fonts. Ninguna es mono.</p>
      </header>
      <div class="familias">
        <article>
          <p class="kicker sin-linea">Solo el logotipo</p>
          <p class="fam fam-logo"><Logo tono="oscuro" linea="medio" /></p>
          <p class="texto-2">Fraunces suave. Nunca en titulares: así el logo no se gasta.</p>
        </article>
        <article>
          <p class="kicker sin-linea">Titulares y cartelas</p>
          <p class="fam fam-serif">Instrument Serif</p>
          <p class="texto-2">Titulares del sitio, títulos de las piezas, cartelas y nombres en los créditos. El acento en cursiva.</p>
        </article>
        <article>
          <p class="kicker sin-linea">Texto y créditos</p>
          <p class="fam fam-sans">Instrument Sans</p>
          <p class="texto-2">Texto, botones y cifras. En versalitas espaciadas: rótulos, roles y fichas técnicas.</p>
        </article>
      </div>
      <ol class="escala-tipo">
        {
          escala.map((e) => (
            <li>
              <span class="meta">{e.nivel}</span>
              <span class={e.clase}>{e.muestra[0]}{e.muestra[1] && <em>{e.muestra[1]}</em>}{e.muestra[2]}</span>
              <span class="meta spec">{e.spec}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 08 IMAGEN -->
  <section class="seccion tema-carbon grano" id="imagen">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">08 — Imagen</p>
          <h2 class="display d-2">El fotograma <em>manda.</em></h2>
        </div>
        <p class="texto-2">La imagen va a sangre y en formato de cine. El texto se acomoda a la imagen, no al revés.</p>
      </header>
      <figure class="m-fotograma">
        <div class="fotograma"><Image src={palenque} alt="Calle de San Basilio de Palenque" widths={[800, 1400, 2000]} sizes="100vw" /></div>
        <figcaption class="credito"><b>San Basilio de Palenque</b><span>Foto de Martín Perea · 2,39:1</span></figcaption>
      </figure>
      <div class="formatos">
        <div><div class="caja-f f-239" /><p class="rotulo">2,39:1</p><p class="texto-2">Portadas, héroes y fotogramas destacados.</p></div>
        <div><div class="caja-f f-169" /><p class="rotulo">16:9</p><p class="texto-2">Video, miniaturas y presentaciones.</p></div>
        <div><div class="caja-f f-45" /><p class="rotulo">4:5</p><p class="texto-2">Carruseles y fotos en redes.</p></div>
        <div><div class="caja-f f-916" /><p class="rotulo">9:16</p><p class="texto-2">Reels, shorts e historias.</p></div>
      </div>
      <div class="si-no">
        <div>
          <p class="kicker sin-linea">Sí</p>
          <ul class="notas">
            <li>Fotogramas propios antes que archivo: gente, lugares y oficios que filmamos.</li>
            <li>Una cara mirando a cámara en las portadas, cuando la hay.</li>
            <li>El color de la película de la casa: negros levantados, luces tibias y grano fino según la resolución.</li>
            <li>Bandas negras de cine cuando el formato ancho lo pide.</li>
            <li>Mientras no haya fotogramas propios: fotos libres (Unsplash) reveladas con la película de la casa, con crédito y solo como ambiente. Lo documental en el lenguaje del moodboard (páramo, figura pequeña, retrato que mira); lo comercial con set, luz y escenario.</li>
          </ul>
        </div>
        <div>
          <p class="kicker sin-linea">No</p>
          <ul class="notas">
            <li>Fotos de banco presentadas como trabajo de Dial: nunca van en Trabajo ni en el portafolio.</li>
            <li>Dron de postal, gente sonriendo a nadie o el teal y naranja de publicidad.</li>
            <li>Consignas, banderas o logos de partidos en las imágenes de la marca.</li>
            <li>Texto encima de la cara de alguien, cajas de color o marcos.</li>
            <li>Miniaturas de YouTube con letras gigantes: la miniatura es un fotograma limpio.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 CRÉDITOS Y VIDEO -->
  <section class="seccion tema-papel" id="video">
    <div class="contenedor">
      <header class="cabeza doble">
        <div>
          <p class="kicker">09 — Créditos y video</p>
          <h2 class="display d-2">Como en una <em>sala.</em></h2>
        </div>
        <p class="texto-2">Tercios inferiores, cartelas y créditos finales usan las mismas dos letras. Los generadores de la casa ya los hacen.</p>
      </header>
      <div class="video-demo">
        <figure class="fotograma r-16-9">
          <Image src={feoPalante} alt="" widths={[800, 1400]} sizes="(min-width: 980px) 60vw, 100vw" />
          <div class="tercio"><span class="tercio-nombre">Delayn Núñez</span><span class="tercio-rol">Cantante · Feo Palante</span></div>
          <span class="agua" aria-hidden="true"><Simbolo tono="claro" /></span>
        </figure>
        <ul class="notas">
          <li><strong>Tercio inferior:</strong> nombre en Instrument Serif y rol en versalitas, sin caja, sobre la zona oscura. Generador de tercios (ProRes 4444 con alfa).</li>
          <li><strong>Cartela:</strong> una frase en serif, centrada, sobre negro. Para abrir capítulos o dar un dato.</li>
          <li><strong>Créditos finales:</strong> rol en versalitas y nombre en serif, en columnas. Al final, las firmas de las casas.</li>
