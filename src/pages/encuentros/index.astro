---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PortadaPagina from '../../components/PortadaPagina.astro';
import ServicioDetalle from '../../components/ServicioDetalle.astro';
import PiezaCard from '../../components/PiezaCard.astro';
import Pendiente from '../../components/Pendiente.astro';
import CTAFinal from '../../components/CTAFinal.astro';
import { dos, rutaCaso } from '../../lib/util';

const servicios = (await getCollection('servicios', (s) => s.data.linea === 'encuentros')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const casos = (await getCollection('casos', (c) => !c.data.borrador && c.data.vitrina === 'encuentros')).sort(
  (a, b) => b.data.anio - a.data.anio,
);

const espacios = [
  { nombre: 'Taller Graphito', nota: 'Bogotá' },
  { nombre: 'Teatro Acto Latino', nota: 'Bogotá' },
  { nombre: 'Espacio propio', nota: 'Para encuentros íntimos' },
];
---

<Base
  titulo="Dial Encuentros"
  descripcion="Producción y cobertura de eventos: foros, festivales, lanzamientos y música en vivo. Tarima, sonido, programación, videomapping y cobertura con un solo equipo."
>
  <PortadaPagina
    kicker="Dial Encuentros"
    titulo="Producimos el encuentro. Y lo dejamos <em>contado.</em>"
    bajada="Foros, festivales, lanzamientos y música en vivo. De la tarima a la pantalla, con un solo equipo."
    indice={[...servicios.map((s) => ({ texto: s.data.titulo, href: `#${s.id}` })), { texto: 'Espacios', href: '#espacios' }, { texto: 'Celebraciones privadas', href: '/encuentros/celebraciones' }]}
  >
    <div class="acciones">
      <a href="/contacto?linea=encuentros" class="btn">Cotizar un evento <span class="flecha">→</span></a>
    </div>
  </PortadaPagina>

  <section class="seccion tema-papel" id="servicios">
    <div class="contenedor">
      <header class="cabeza doble">
        <div data-revela>
          <p class="kicker">{dos(1)} — Servicios</p>
          <h2 class="display d-2">Todo el evento, o solo la cobertura.</h2>
        </div>
        <p class="texto-2" data-revela>Cada encuentro se cotiza según su tamaño, el lugar y lo que quieras llevarte después.</p>
      </header>
      <div class="rejilla-2">{servicios.map((s, i) => <ServicioDetalle servicio={s} n={i + 1} />)}</div>
    </div>
  </section>

  <section class="seccion compacta tema-hueso" id="espacios">
    <div class="contenedor espacios">
      <div data-revela>
        <p class="kicker">{dos(2)} — Espacios</p>
        <h2 class="display d-3">Dónde encontrarnos.</h2>
        <p class="texto-2">Trabajamos con espacios aliados en Bogotá. También llevamos la producción a tu lugar.</p>
      </div>
      <ul>
        {
          espacios.map((e, i) => (
            <li data-revela style={`--retraso:${i * 0.06}s`}>
              <span class="sub s-1">{e.nombre}</span>
              <span class="mono texto-2">{e.nota}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    (casos.length > 0 || import.meta.env.DEV) && (
      <section class="seccion tema-papel" id="portafolio">
        <div class="contenedor">
          <header class="cabeza doble">
            <div data-revela>
              <p class="kicker">{dos(3)} — Trabajo</p>
              <h2 class="display d-2">Encuentros que hemos producido.</h2>
            </div>
          </header>
          <div class="rejilla-2">
            {casos.map((c) => (
              <PiezaCard
                titulo={c.data.titulo}
                video={c.data.video}
                href={rutaCaso('encuentros', c.id)}
                kicker={c.data.organizacion}
                resumen={c.data.resumen}
                meta={`${c.data.lugar} · ${c.data.anio}`}
              />
            ))}
            {casos.length === 0 && (
              <Pendiente titulo="Evento completo" texto="Un evento producido de principio a fin: tarima, sonido, música en vivo, videomapping y cobertura." />
            )}
          </div>
        </div>
      </section>
    )
  }

  <a href="/encuentros/celebraciones" class="celebra tema-papel">
    <div class="contenedor celebra-fila">
      <span class="kicker">¿Es una celebración privada?</span>
      <span class="celebra-texto">Bodas, aniversarios y serenatas tienen <em>su propia página.</em></span>
      <span class="celebra-flecha" aria-hidden="true">→</span>
    </div>
  </a>

  <CTAFinal
    titulo="¿Qué encuentro estás preparando?"
    texto="Cuéntanos la fecha, el lugar y cuántas personas esperas. Te proponemos cómo producirlo y cómo dejarlo contado."
    linea="encuentros"
    mensajeWhatsapp="Hola, Martín. Vi el sitio de Dial y quiero cotizar un evento."
  />
</Base>

<style>
  .rejilla-2 { display: grid; gap: 72px 56px; }
  @media (min-width: 900px) { .rejilla-2 { grid-template-columns: 1fr 1fr; } }

  .espacios { display: grid; gap: 40px; }
  .espacios h2 { margin-block: 18px; }
  .espacios p { margin: 0; max-width: 40ch; }
  .espacios ul { list-style: none; border-top: 1px solid var(--borde); }
  .espacios li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--borde); }
  .espacios li .mono { text-align: right; }
  @media (min-width: 900px) { .espacios { grid-template-columns: 1fr 1.3fr; gap: 88px; align-items: start; } }

  .celebra { display: block; text-decoration: none; border-top: 1px solid var(--linea); transition: background 0.3s; }
  .celebra:hover { background: var(--hueso); }
  .celebra-fila { display: grid; gap: 14px 40px; padding-block: clamp(40px, 5vw, 64px); align-items: center; }
  .celebra-texto { font-size: clamp(1.4rem, 1rem + 1.4vw, 2.1rem); line-height: 1.3; }
  .celebra-texto em { color: var(--terracota-ink); }
  .celebra-flecha { font-size: 2rem; transition: transform 0.4s var(--ease); }
  .celebra:hover .celebra-flecha { transform: translateX(8px); color: var(--terracota-ink); }
  @media (min-width: 900px) { .celebra-fila { grid-template-columns: 16rem 1fr auto; } }
</style>
