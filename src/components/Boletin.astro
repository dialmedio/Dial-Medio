---
/**
 * Suscripción al boletín de Dial (Buttondown: buttondown.com/dial).
 * Envía sin salir de la página; si el navegador lo impide, abre Buttondown en otra pestaña.
 * Buttondown manda el correo de confirmación (doble opt-in).
 */
import sitio from '../data/sitio.json';

interface Props {
  id?: string;
  origen?: string;
}
const { id = 'boletin', origen = 'sitio' } = Astro.props;
const usuario = sitio.boletin.usuario;
const action = `https://buttondown.com/api/emails/embed-subscribe/${usuario}`;
---

<form class="boletin" id={id} method="post" action={action} target="_blank" data-boletin>
  <label class="sr-only" for={`${id}-correo`}>Tu correo electrónico</label>
  <div class="boletin-fila">
    <input id={`${id}-correo`} name="email" type="email" placeholder="tu@correo.com" autocomplete="email" required />
    <input type="hidden" name="embed" value="1" />
    <input type="hidden" name="tag" value={origen} />
    <button type="submit" class="btn">Suscribirme</button>
  </div>
  <p class="boletin-estado" role="status" aria-live="polite" data-estado></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-boletin]').forEach((form) => {
    const estado = form.querySelector<HTMLElement>('[data-estado]')!;
    const boton = form.querySelector<HTMLButtonElement>('button')!;
    form.addEventListener('submit', async (e) => {
      if (!form.checkValidity()) return;
      e.preventDefault();
      boton.disabled = true;
      estado.className = 'boletin-estado';
      estado.textContent = 'Enviando…';
      try {
        // Buttondown no expone CORS en este formulario: la respuesta es opaca pero la suscripción se registra.
        await fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' });
        form.reset();
        estado.classList.add('ok');
        estado.textContent = 'Listo. Revisa tu correo y confirma la suscripción.';
      } catch {
        form.submit();
        estado.textContent = '';
      } finally {
        boton.disabled = false;
      }
    });
  });
</script>

<style>
  .boletin { display: grid; gap: 10px; width: 100%; max-width: 520px; }
  .boletin-fila { display: flex; gap: 10px; flex-wrap: wrap; }
  .boletin input[type='email'] {
    flex: 1 1 220px;
    min-height: 52px;
    padding: 0 16px;
    font: inherit;
    font-size: 1rem;
    color: inherit;
    background: transparent;
    border: 1px solid var(--borde);
    border-radius: 100px;
    padding: 0 20px;
    transition: border-color 0.2s;
  }
  .boletin input[type='email']::placeholder { color: var(--texto-2); opacity: 0.8; }
  .boletin input[type='email']:focus { outline: none; border-color: var(--terracota); }
  .boletin .btn { flex: 0 0 auto; }
  .boletin-estado { margin: 0; min-height: 1.4em; font-family: var(--f-mono); font-size: var(--t-meta); color: var(--texto-2); }
  .boletin-estado.ok { color: var(--ambar); }
</style>
