---
/**
 * Símbolo de Dial (marca v4, 24 oct 2026): el aro con punto.
 * Un aro y el punto terracota de la i montado sobre él a 45°, con un respiro alrededor: un dial ya sintonizado.
 * Aro en hueso (sobre oscuro) o carbón (sobre claro); el punto siempre terracota.
 * `detalle="compacto"` engrosa el aro y agranda el punto para tamaños menores de 24 px.
 * `anima` lo dibuja al cargar: el aro se traza y el punto cae en su lugar.
 * Geometría en src/lib/aro.mjs (la misma de scripts/generar-marca.mjs).
 */
import { aro } from '../lib/aro.mjs';
interface Props {
  tono?: 'claro' | 'oscuro';
  detalle?: 'completo' | 'compacto';
  anima?: boolean;
  class?: string;
  titulo?: string;
}
const { tono = 'claro', detalle = 'completo', anima = false, class: clase = '', titulo } = Astro.props;
const color = tono === 'claro' ? 'var(--hueso)' : 'var(--carbon)';
const id = 'aro-' + Math.random().toString(36).slice(2, 9);
const cuerpo = aro(color, { compacto: detalle === 'compacto', centro: 'var(--terracota)', id, clases: true });
---
<svg
  class:list={['simbolo', { anima }, clase]}
  viewBox="0 0 200 200"
  role={titulo ? 'img' : undefined}
  aria-hidden={titulo ? undefined : 'true'}
  aria-label={titulo}
  set:html={cuerpo}
/>

<style>
  .simbolo { overflow: visible; }
  .simbolo :global(.aro-punto) { transform-box: fill-box; transform-origin: center; }

  @media (prefers-reduced-motion: no-preference) {
    .anima :global(.aro-trazo) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: trazar 1.1s var(--ease) 0.2s forwards;
    }
    .anima :global(.aro-punto) {
      transform: scale(0);
      animation: aparecer 0.8s cubic-bezier(0.3, 1.6, 0.4, 1) 1s forwards, latido 4.8s ease-in-out 2.6s infinite;
    }
  }

  @keyframes trazar { to { stroke-dashoffset: 0; } }
  @keyframes aparecer { to { transform: scale(1); } }
  @keyframes latido {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }
</style>
