---
/** Las láminas del carrusel tal como salieron en redes, para deslizar. Flechas en escritorio, dedo en el celular. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  laminas: ImageMetadata[];
  titulo: string;
}
const { laminas, titulo } = Astro.props;
---

<section class="laminas" aria-label={`Láminas: ${titulo}`} data-laminas>
  <div class="laminas-cabeza">
    <p class="rotulo">Así lo contamos en redes</p>
    <div class="laminas-control">
      <span class="datos" data-cuenta>1 / {laminas.length}</span>
      <button type="button" data-ir="-1" aria-label="Lámina anterior">←</button>
      <button type="button" data-ir="1" aria-label="Lámina siguiente">→</button>
    </div>
  </div>
  <ol class="laminas-pista" data-pista>
    {
      laminas.map((l, i) => (
        <li>
          <Image src={l} alt={`Lámina ${i + 1} de ${laminas.length}: ${titulo}`} widths={[540, 1080]} sizes="(min-width: 980px) 360px, 78vw" quality={82} />
        </li>
      ))
    }
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-laminas]').forEach((s) => {
    const pista = s.querySelector<HTMLElement>('[data-pista]')!;
    const cuenta = s.querySelector<HTMLElement>('[data-cuenta]')!;
    const items = [...pista.children] as HTMLElement[];
    const paso = () => (items[1]?.offsetLeft ?? 0) - (items[0]?.offsetLeft ?? 0) || pista.clientWidth;
    s.querySelectorAll<HTMLButtonElement>('[data-ir]').forEach((b) =>
      b.addEventListener('click', () => pista.scrollBy({ left: Number(b.dataset.ir) * paso(), behavior: 'smooth' })),
    );
    pista.addEventListener(
      'scroll',
      () => (cuenta.textContent = `${Math.min(items.length, Math.round(pista.scrollLeft / paso()) + 1)} / ${items.length}`),
      { passive: true },
    );
  });
</script>

<style>
  .laminas { display: grid; gap: 16px; }
  .laminas-cabeza { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .laminas-control { display: flex; align-items: center; gap: 8px; }
  .laminas-control .datos { margin-right: 6px; }
  .laminas-control button {
    width: 40px; height: 40px; border: 1px solid var(--borde); background: none; cursor: pointer; font-size: 1.05rem; color: inherit;
    transition: border-color .2s;
  }
  .laminas-control button:hover { border-color: currentColor; }
  .laminas-pista {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 360px);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 10px;
  }
  .laminas-pista li { scroll-snap-align: start; }
  .laminas-pista img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; box-shadow: 0 1px 0 var(--linea); }
</style>
