---
/**
 * Cabecera del medio (nov 2026). Arriba, la franja con la fecha y los accesos de la casa; luego la mancheta
 * con el logotipo (grande en la portada, compacto en el resto) y la fila de secciones, que se queda fija al
 * bajar y muestra el logotipo pequeño. En el celular las secciones se deslizan de lado, como en un diario.
 */
import Logo from './Logo.astro';
import sitio from '../data/sitio.json';
import { secciones, fechaDeHoy } from '../lib/medio';
import { whatsapp } from '../lib/util';

interface Props {
  portada?: boolean;
}
const { portada = false } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = await secciones();
const activo = (href: string) => ruta === href || ruta.startsWith(href + '/');
const casa = [
  { texto: 'Nosotros', href: '/nosotros' },
  { texto: 'Principios editoriales', href: '/principios' },
  { texto: 'Dial Estudio', href: '/estudio' },
  { texto: 'Contacto', href: '/contacto' },
];
---

<header class:list={['cabecera', { 'en-portada': portada }]} data-cabecera>
  <div class="franja tema-carbon">
    <div class="contenedor franja-fila">
      <p class="franja-fecha"><time data-hoy>{fechaDeHoy()}</time><span class="franja-ciudad"> · Bogotá</span></p>
      <ul class="franja-enlaces">
        <li><a href="/estudio">Dial Estudio</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="#boletin">Boletín</a></li>
      </ul>
    </div>
  </div>

  <div class="contenedor mancheta" data-mancheta>
    <button class="icono menu-boton" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-boton>
      <span class="sr-only">Abrir menú</span>
      <span class="menu-lineas" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <a href="/" class="mancheta-logo" aria-label="Dial, inicio">
      <Logo tono="oscuro" />
    </a>
    {portada && <p class="mancheta-lema">Análisis, opinión, documental y conversación. <em>Del ruido a la señal.</em></p>}
    <a href="/buscar" class="icono buscar-boton" aria-label="Buscar en Dial">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </a>
  </div>

  <nav class="secciones" aria-label="Secciones" data-secciones>
    <div class="contenedor secciones-fila">
      <button class="icono secciones-menu" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-boton>
        <span class="sr-only">Abrir menú</span>
        <span class="menu-lineas" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
      <a href="/" class="secciones-logo" aria-label="Dial, inicio" tabindex="-1"><Logo tono="oscuro" /></a>
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={activo(n.href) ? 'page' : undefined}>
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/buscar" class="secciones-buscar" aria-label="Buscar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </a>
    </div>
  </nav>

  <div class="menu-movil tema-papel" id="menu-movil" data-menu hidden>
    <div class="contenedor menu-tope">
      <a href="/" aria-label="Dial, inicio" class="menu-logo"><Logo tono="oscuro" /></a>
      <button class="icono" type="button" data-menu-cerrar><span class="sr-only">Cerrar menú</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
    <nav aria-label="Menú" class="contenedor">
      <ol>
        {
          nav.map((n, i) => (
            <li style={`--i:${i}`}>
              <a href={n.href} aria-current={activo(n.href) ? 'page' : undefined}>
                <span class="display">{n.texto}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <ul class="menu-casa">
        {casa.map((c) => <li><a href={c.href}>{c.texto}</a></li>)}
      </ul>
      <div class="menu-pie">
        <a href="/buscar" class="btn linea">Buscar en Dial</a>
        <a href={whatsapp('Hola, Dial. Les escribo desde la página.')} class="btn linea" target="_blank" rel="noopener">WhatsApp</a>
        <p class="meta">{sitio.correo}</p>
      </div>
    </nav>
  </div>
</header>

<script>
  // La fecha de hoy en Bogotá (la página es estática: la del servidor sería la del día en que se publicó).
  const dias = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const b = new Date(Date.now() - 5 * 3600 * 1000);
  const d = dias[b.getUTCDay()];
  document.querySelectorAll('[data-hoy]').forEach((t) => {
    t.textContent = `${d[0].toUpperCase()}${d.slice(1)} ${b.getUTCDate()} de ${meses[b.getUTCMonth()]} de ${b.getUTCFullYear()}`;
  });
  // Cuando la mancheta sale de la pantalla, la fila de secciones muestra el logotipo pequeño.
  const mancheta = document.querySelector('[data-mancheta]');
  const filas = document.querySelector('[data-secciones]');
  if (mancheta && filas) {
    new IntersectionObserver(([e]) => filas.classList.toggle('fija', !e.isIntersecting), { threshold: 0 }).observe(mancheta);
  }
  // En el celular, la sección activa queda a la vista dentro de la fila que se desliza.
  document.querySelector('.secciones [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
</script>

<style>
  .cabecera { display: contents; }

  /* Franja de arriba: fecha y accesos de la casa */
  .franja { font-family: var(--f-rotulo); font-size: .72rem; letter-spacing: .08em; }
  .franja-fila { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 36px; }
  .franja-fecha { margin: 0; color: var(--hueso-2); }
  .franja-enlaces { list-style: none; display: flex; gap: 22px; }
  .franja-enlaces a { color: var(--hueso-2); text-decoration: none; transition: color .2s; }
  .franja-enlaces a:hover { color: var(--papel); }
  @media (max-width: 640px) {
    .franja-ciudad, .franja-enlaces li:not(:first-child) { display: none; }
  }

  /* Mancheta */
  .mancheta {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 12px;
    padding-block: clamp(18px, 2.4vw, 26px) clamp(14px, 2vw, 22px);
    background: var(--papel);
  }
  .mancheta-logo { grid-column: 2; justify-self: center; text-decoration: none; color: var(--carbon); font-size: clamp(40px, 5vw, 58px); display: inline-flex; }
  .en-portada .mancheta { padding-block: clamp(26px, 4vw, 52px) clamp(18px, 2.6vw, 30px); }
  .en-portada .mancheta-logo { font-size: clamp(64px, 10vw, 128px); }
  .mancheta-lema {
    grid-column: 1 / -1;
    justify-self: center;
    margin: clamp(10px, 1.4vw, 16px) 0 0;
    text-align: center;
    font-size: clamp(.95rem, .9rem + .2vw, 1.05rem);
    color: var(--tinta-2);
  }
  .mancheta-lema em { color: var(--carbon); }
  .icono {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: none; border: 0; padding: 0; cursor: pointer;
    color: var(--carbon);
  }
  .icono svg { width: 22px; height: 22px; }
  .buscar-boton { grid-column: 3; grid-row: 1; }
  .menu-boton { grid-row: 1; }
  .menu-lineas { display: grid; gap: 5px; width: 20px; }
  .menu-lineas span { height: 1.5px; background: currentColor; transition: transform .3s var(--ease), opacity .2s; }
  [aria-expanded='true'] .menu-lineas span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  [aria-expanded='true'] .menu-lineas span:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .menu-lineas span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Secciones: fila fija con doble filete, como el pie de una mancheta impresa */
  .secciones {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--papel);
    border-top: 1px solid var(--carbon);
    border-bottom: 1px solid var(--linea);
    box-shadow: 0 -3px 0 -2px var(--carbon);
    transition: box-shadow .3s;
  }
  .secciones.fija { box-shadow: 0 -3px 0 -2px var(--carbon), 0 10px 24px -18px rgba(31, 28, 25, .5); }
  .secciones-fila { display: flex; align-items: center; gap: 20px; min-height: 50px; }
  .secciones-logo, .secciones-buscar {
    flex: none; display: inline-flex; text-decoration: none; color: var(--carbon);
    opacity: 0; pointer-events: none; transition: opacity .25s, transform .3s var(--ease);
  }
  .secciones-logo { font-size: 26px; transform: translateY(4px); }
  .secciones-buscar svg { width: 20px; height: 20px; }
  .fija .secciones-logo, .fija .secciones-buscar { opacity: 1; pointer-events: auto; transform: none; }
  .secciones ul {
    list-style: none;
    display: flex;
    flex: 1;
    justify-content: center;
    gap: clamp(18px, 2.6vw, 40px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .secciones ul::-webkit-scrollbar { display: none; }
  .secciones li { flex: none; }
  .secciones ul a {
    display: block;
    padding-block: 14px 13px;
    font-family: var(--f-rotulo);
    font-weight: 600;
    font-size: .8rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--carbon);
    position: relative;
    transition: color .2s;
  }
  .secciones ul a::after {
    content: ''; position: absolute; left: 50%; bottom: 5px;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--luz);
    transform: translateX(-50%) scale(0);
    transition: transform .3s var(--ease);
  }
  .secciones ul a:hover { color: var(--terracota-ink); }
  .secciones ul a[aria-current='page']::after { transform: translateX(-50%) scale(1); }

  .secciones-menu { display: none; flex: none; width: 40px; margin-left: calc(var(--gutter) - 10px); }
  @media (max-width: 860px) {
    .secciones-logo, .secciones-buscar { display: none; }
    .fija .secciones-menu { display: grid; }
    .fija .secciones ul, .secciones.fija ul { padding-left: 4px; }
    .secciones-fila { padding-inline: 0; }
    .secciones ul { justify-content: flex-start; padding-inline: var(--gutter); gap: 22px; mask-image: linear-gradient(90deg, #000 85%, transparent); }
  }
  @media (min-width: 861px) {
    .menu-boton { visibility: hidden; }
  }

  /* Menú del celular */
  .menu-movil { position: fixed; inset: 0; z-index: 60; overflow-y: auto; padding-bottom: 40px; }
  .menu-tope { display: flex; justify-content: space-between; align-items: center; min-height: 64px; margin-bottom: 16px; }
  .menu-logo { font-size: 36px; color: var(--carbon); text-decoration: none; display: inline-flex; }
  .menu-movil ol { list-style: none; border-top: 1px solid var(--carbon); }
  .menu-movil li { border-bottom: 1px solid var(--linea); }
  .menu-movil li a { display: block; padding-block: 14px; text-decoration: none; }
  .menu-movil .display { font-size: clamp(2.2rem, 10vw, 3rem); }
  .menu-movil a[aria-current='page'] .display { font-style: italic; }
  .menu-casa { list-style: none; display: grid; gap: 12px; margin-top: 28px; }
  .menu-casa a { text-decoration: none; font-weight: 500; }
  .menu-pie { display: grid; gap: 12px; margin-top: 32px; }
  .menu-pie .btn { justify-content: center; }
  .menu-pie p { text-align: center; margin: 8px 0 0; }
  @media (prefers-reduced-motion: no-preference) {
    .menu-movil:not([hidden]) li { animation: entra .5s var(--ease) both; animation-delay: calc(var(--i) * .05s); }
  }
  @keyframes entra { from { opacity: 0; transform: translateY(12px); } }
</style>
