---
/**
 * Cabecera de la productora (marca v6, nov 2026). Una franja negra fina, como la de una sala: logotipo,
 * cuatro secciones y el botón para cotizar. En la portada flota sobre el fotograma y se oscurece al bajar.
 * El menú del celular lo maneja el script de Base.astro (data-menu-boton, data-menu, data-menu-cerrar).
 */
import Logo from './Logo.astro';
import { NAV } from '../lib/util';

interface Props {
  portada?: boolean;
}
const { portada = false } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) => ruta === href || ruta.startsWith(href + '/');
---

<header class:list={['cab', { flota: portada }]} data-cab>
  <div class="contenedor cab-fila">
    <a href="/" class="cab-logo" aria-label="Dial Medio, inicio"><Logo tono="claro" linea="medio" titulo="Dial Medio" /></a>
    <nav class="cab-nav" aria-label="Principal">
      <ul>
        {NAV.map((n) => <li><a href={n.href} aria-current={activo(n.href) ? 'page' : undefined}>{n.texto}</a></li>)}
      </ul>
    </nav>
    <a href="/contacto" class="cab-cta" aria-current={activo('/contacto') ? 'page' : undefined}>Cotizar</a>
    <button class="cab-menu" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-boton>
      <span class="sr-only">Abrir menú</span>
      <span class="lineas" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="menu-movil tema-carbon grano" id="menu-movil" data-menu hidden>
    <div class="contenedor cab-fila">
      <a href="/" class="cab-logo" aria-label="Dial Medio, inicio"><Logo tono="claro" linea="medio" titulo="Dial Medio" /></a>
      <button class="cab-menu" type="button" data-menu-cerrar><span class="sr-only">Cerrar menú</span><span class="cerrar" aria-hidden="true">×</span></button>
    </div>
    <nav class="contenedor" aria-label="Menú">
      <ul class="menu-lista">
        {NAV.map((n) => <li><a href={n.href}>{n.texto}</a></li>)}
        <li><a href="/contacto">Cotizar</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // En la portada, la cabecera es transparente sobre el fotograma hasta que la persona baja.
  const cab = document.querySelector<HTMLElement>('[data-cab].flota');
  if (cab) {
    const revisar = () => cab.classList.toggle('solida', scrollY > 40);
    revisar();
    addEventListener('scroll', revisar, { passive: true });
  }
</script>

<style>
  .cab { position: sticky; top: 0; z-index: 50; background: var(--carbon); color: var(--papel); border-bottom: 1px solid var(--linea-clara); }
  .cab.flota { position: fixed; inset: 0 0 auto; background: transparent; border-color: transparent; transition: background .4s var(--ease), border-color .4s; }
  .cab.flota.solida { background: rgba(31, 28, 25, .94); border-color: var(--linea-clara); backdrop-filter: blur(8px); }
  .cab-fila { display: flex; align-items: center; gap: 28px; min-height: 68px; }
  .cab-logo { font-size: 30px; text-decoration: none; margin-right: auto; display: inline-flex; }
  .cab-nav { display: none; }
  .cab-nav ul { list-style: none; display: flex; gap: 30px; }
  .cab-nav a, .cab-cta {
    font-family: var(--f-rotulo); font-size: var(--t-etq); font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    text-decoration: none; color: var(--hueso-2); transition: color .2s;
  }
  .cab-nav a:hover, .cab-nav a[aria-current] { color: var(--papel); }
  .cab-nav a[aria-current] { text-decoration: underline; text-decoration-color: var(--luz); text-underline-offset: .7em; text-decoration-thickness: 2px; }
  .cab-cta { display: none; color: var(--papel); border: 1px solid rgba(244, 238, 229, .4); padding: 10px 16px; }
  .cab-cta:hover { border-color: var(--luz); background: var(--luz); }
  .cab-menu { background: none; border: 0; padding: 10px; margin-right: -10px; cursor: pointer; color: var(--papel); }
  .lineas { display: grid; gap: 7px; width: 26px; }
  .lineas span { height: 1.5px; background: currentColor; }
  .cerrar { font-size: 2rem; line-height: 1; }
  .menu-movil { position: fixed; inset: 0; z-index: 60; overflow-y: auto; }
  .menu-lista { list-style: none; display: grid; margin-top: 28px; border-top: 1px solid var(--linea-clara); }
  .menu-lista a { display: block; padding: 18px 0; border-bottom: 1px solid var(--linea-clara); font-family: var(--f-display); font-size: 2.4rem; line-height: 1; text-decoration: none; }
  @media (min-width: 861px) {
    .cab-nav, .cab-cta { display: block; }
    .cab-menu { display: none; }
    .cab-fila { min-height: 76px; }
    .cab-logo { font-size: 34px; }
  }
</style>
