---
/**
 * Logotipo de Dial (manual v3): "dial" en Instrument Sans Bold, con el punto de la i
 * como nodo central terracota. Trazos generados por scripts/generar-marca.mjs.
 * `linea` agrega la línea de negocio en Instrument Serif cursiva (impacto, encuentros, medio).
 */
import logo from '../data/logotipo.json';

interface Props {
  tono?: 'claro' | 'oscuro';
  linea?: string;
  class?: string;
  titulo?: string;
}
const { tono = 'claro', linea, class: clase = '', titulo = linea ? `Dial ${linea}` : 'Dial' } = Astro.props;
---

<span class:list={['logo', tono, clase]}>
  <svg class="logo-palabra" viewBox={logo.viewBox} role="img" aria-label={titulo}>
    <path d={logo.d} fill="currentColor" />
    <circle cx={logo.punto.cx} cy={logo.punto.cy} r={logo.punto.r} fill="var(--terracota)" />
  </svg>
  {linea && <span class="logo-linea" aria-hidden="true">{linea}</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: baseline; gap: 0.28em; line-height: 1; }
  .logo-palabra { height: 1em; width: auto; overflow: visible; transform: translateY(0.02em); }
  .claro { color: var(--hueso); }
  .oscuro { color: var(--carbon); }
  .logo-linea {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.02em;
    color: var(--terracota);
    letter-spacing: 0;
  }
</style>
