---
import Simbolo from './Simbolo.astro';

interface Props {
  tono?: 'claro' | 'oscuro';
  class?: string;
}
const { tono = 'claro', class: clase = '' } = Astro.props;
---

<span class:list={['logo', tono, clase]}>
  <Simbolo tono={tono} detalle="compacto" class="logo-simbolo" />
  <span class="logo-palabra">Dial</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    line-height: 1;
  }
  .logo :global(.logo-simbolo) { width: 1.55em; height: 1.55em; flex: none; }
  .logo-palabra {
    font-family: var(--f-display);
    text-transform: uppercase;
    font-size: 1.5em;
    letter-spacing: 0.02em;
    transform: translateY(0.02em);
  }
  .claro .logo-palabra { color: var(--hueso); }
  .oscuro .logo-palabra { color: var(--carbon); }
</style>
