---
/**
 * Un servicio: qué es, qué incluye, qué recibes y trabajo nuestro (antes vivía solo en /servicios).
 * modo 'resumen' = /servicios (título con enlace a la página propia y una muestra corta del trabajo);
 * modo 'pagina'  = /servicios/<slug> (la foto y el título van en la portada; aquí el gancho, el texto largo y toda la obra).
 * 21 nov 2026, reorganización: arriba dos columnas parejas (texto | incluye y recibes) y abajo, a todo el ancho, la
 * obra en una tira de igual altura. Se quitaron las fotos de cabecera de stock en /servicios: cada servicio se ilustra
 * con trabajo propio (Martín no quiere stock donde hay trabajo nuestro).
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CarruselMuestra from './CarruselMuestra.astro';
import TiraObra from './TiraObra.astro';
import { CARRUSELES } from '../lib/muestras';
import { OBRAS, CARRUSELES_RESUMEN, rutaServicio } from '../lib/servicios';
import { GALERIA_RETRATOS, FOTOGRAFO } from '../lib/retratos';
import { dos } from '../lib/util';

interface Props {
  s: CollectionEntry<'servicios'>;
  i: number;
  modo?: 'resumen' | 'pagina';
}
const { s, i, modo = 'resumen' } = Astro.props;
const resumen = modo === 'resumen';
const obras = OBRAS[s.id];
const para = s.data.paraQuien.charAt(0).toLowerCase() + s.data.paraQuien.slice(1).replace(/\.$/, '');
const parrafos = resumen || !s.data.texto.length ? [s.data.resumen] : s.data.texto;
const carruseles = resumen ? CARRUSELES.filter((c) => CARRUSELES_RESUMEN.includes(c.id)) : CARRUSELES;
const retratos = resumen ? GALERIA_RETRATOS.slice(0, 3) : GALERIA_RETRATOS;
---

<section class:list={['seccion', 'compacta', 'serv-sec', i % 2 ? 'tema-hueso' : 'tema-papel']} id={resumen ? s.id : 'detalle'}>
  <div class="contenedor serv">
    <div class="serv-cabeza" data-revela>
      <p class="kicker">{resumen ? `${dos(i + 1)} · ` : ''}Para {para}</p>
      {
        resumen ? (
          <h2 class="display d-3"><a href={rutaServicio(s)} class="serv-titulo">{s.data.titulo}</a></h2>
        ) : (
          s.data.gancho && <h2 class="display d-3">{s.data.gancho}</h2>
        )
      }
      {resumen && s.data.gancho && <p class="gancho serv-gancho">{s.data.gancho}</p>}
      {parrafos.map((p, j) => <p class:list={{ lead: j === 0, 'texto-largo': j > 0 }}>{p}</p>)}
      <div class="serv-acciones">
        <a href={`/contacto?servicio=${s.id}`} class="enlace">Cotizar este servicio <span>→</span></a>
        {resumen && <a href={rutaServicio(s)} class="enlace">Ver {s.data.titulo.toLowerCase()} <span>→</span></a>}
      </div>
    </div>
    <div class="serv-cuerpo" data-revela style="--retraso:.08s">
      <div class="serv-incluye">
        <p class="rotulo">Incluye</p>
        <ol class="recorrido">{s.data.incluye.map((x, j) => <li><span class="n">{dos(j + 1)}</span><span class="t">{x}</span></li>)}</ol>
      </div>
      <div class="serv-recibes">
        <p class="rotulo">Recibes</p>
        <ul>{s.data.entregables.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>

    {
      obras && (
        <div class="serv-obra" data-revela>
          <p class="rotulo">{obras.rotulo}</p>
          <TiraObra piezas={obras.piezas} />
          {obras.pie && <p class="credito"><span>{obras.pie}</span></p>}
        </div>
      )
    }
    {
      s.id === 'diseno' && (
        <div class="serv-obra" data-revela>
          <p class="rotulo">Carruseles que diseñamos y publicamos</p>
          <div class="laminas">{carruseles.map((c) => <CarruselMuestra c={c} />)}</div>
          <p class="credito"><span>Pasa el mouse por encima para ver las láminas.{resumen && <> <a href={rutaServicio(s)}>Ver más carruseles →</a></>}</span></p>
        </div>
      )
    }
    {
      s.id === 'retratos' && (
        <div class="serv-obra" data-revela>
          <p class="rotulo">Hecho por nosotros</p>
          <div class:list={['retratos', { resumen }]}>
            {retratos.map((f, j) => (
              <figure class:list={{ ancha: !resumen && j === 0 }}>
                <Image src={f.src} alt={f.alt} widths={[640, 1100, 1800, 2560]} sizes={resumen ? '(min-width: 1300px) 440px, (min-width: 760px) 33vw, 100vw' : j === 0 ? '(min-width: 1300px) 1200px, 100vw' : '(min-width: 1300px) 600px, (min-width: 700px) 50vw, 100vw'} />
              </figure>
            ))}
          </div>
          <p class="credito"><span>Secuencia en un humedal, 2026. Fotos de {FOTOGRAFO}.{resumen && <> <a href={rutaServicio(s)}>Ver la sesión completa →</a></>}</span></p>
        </div>
      )
    }
  </div>
</section>

<style>
  .serv-sec { padding-top: calc(var(--seccion) * .62); }
  .serv { display: grid; gap: 36px 72px; }
  @media (min-width: 980px) { .serv { grid-template-columns: 1.05fr 1fr; align-items: start; } }
  .serv-cabeza { display: grid; gap: 18px; align-content: start; justify-items: start; }
  .serv-cabeza p { margin: 0; }
  .serv-titulo { color: inherit; text-decoration: none; }
  .serv-titulo:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .12em; }
  .serv-gancho { font-size: clamp(1.25rem, 1.1rem + .5vw, 1.55rem); color: var(--texto-2); max-width: 30ch; }
  .serv-cabeza .lead, .serv-cabeza .texto-largo { max-width: 56ch; }
  .serv-cabeza .texto-largo { color: var(--texto-2); }
  .serv-acciones { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 6px; }
  .serv-cuerpo { display: grid; gap: 28px; }
  /* Incluye: un recorrido sobre la línea del dial (marcas cortas y un punto por paso), no una lista con viñetas. */
  .serv-incluye, .serv-recibes { width: 100%; display: grid; gap: 14px; }
  .serv-incluye .rotulo, .serv-recibes .rotulo { margin: 0; }
  .recorrido { list-style: none; margin: 0; padding: 0 0 0 22px; display: grid; gap: 0; position: relative;
    background: repeating-linear-gradient(to bottom, var(--borde) 0 1px, transparent 1px 12px) 0 0 / 7px 100% no-repeat; }
  .recorrido::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; border-left: 1px solid var(--borde); }
  .recorrido li { position: relative; display: grid; grid-template-columns: 2.4em 1fr; align-items: baseline; padding: 10px 0; }
  .recorrido li::before { content: ''; position: absolute; left: -25px; top: 50%; width: 7px; height: 7px; margin-top: -3px; border-radius: 50%; background: var(--acento-texto); transition: transform .3s var(--ease); }
  .recorrido li:hover::before { transform: scale(1.6); }
  .recorrido .n { font-family: var(--f-display); font-style: italic; color: var(--acento-texto); font-size: 1.05rem; }
  .recorrido .t { font-family: var(--f-display); font-size: clamp(1.1rem, 1rem + .35vw, 1.3rem); line-height: 1.3; }
  /* Recibes: lo que se entrega, en una franja oscura, como la cartela final de una película. */
  .serv-recibes { background: var(--caja); color: var(--caja-texto); padding: 22px 24px 24px; }
  .serv-recibes .rotulo { color: var(--caja-acento); }
  .serv-recibes ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .serv-recibes li { padding: 12px 0; border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent); font-family: var(--f-display); font-size: clamp(1.15rem, 1rem + .45vw, 1.45rem); line-height: 1.25; }
  .serv-recibes li:first-child { border-top: 0; padding-top: 4px; }
  @media (min-width: 700px) {
    .serv-recibes ul { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0 28px; }
    .serv-recibes li, .serv-recibes li:first-child { border-top: 0; border-left: 1px solid color-mix(in srgb, currentColor 18%, transparent); padding: 4px 0 4px 16px; }
  }
  /* Trabajo nuestro: a todo el ancho del contenedor, debajo del texto, separado por una línea fina. */
  .serv-obra { grid-column: 1 / -1; display: grid; gap: 16px; padding-top: 28px; border-top: 1px solid var(--borde); }
  .serv-obra > .rotulo { margin: 0; }
  .serv-obra .credito { margin: 0; }
  .serv-obra .credito a { color: inherit; }
  .laminas { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 14px; }
  @media (min-width: 980px) { .laminas { grid-template-columns: repeat(4, 1fr); } }
  /* Retratos: fotos 16:9 tal como salieron de la edición. En /servicios, tres en fila; en su página, la sesión completa. */
  .retratos { display: grid; gap: 12px; }
  @media (min-width: 700px) { .retratos { grid-template-columns: repeat(2, 1fr); } .retratos .ancha { grid-column: 1 / -1; } }
  @media (min-width: 760px) { .retratos.resumen { grid-template-columns: repeat(3, 1fr); } }
  .retratos figure { margin: 0; background: #0f0d0c; }
  .retratos img { display: block; width: 100%; height: auto; }
</style>
