---
/** Pie de la productora (marca v6, nov 2026): boletín, accesos, aliados y contacto. */
import Logo from './Logo.astro';
import Boletin from './Boletin.astro';
import sitio from '../data/sitio.json';
import { NAV, whatsapp } from '../lib/util';
import { getCollection } from 'astro:content';
import { rutaServicio } from '../lib/servicios';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);

const columnas = [
  { titulo: 'La productora', enlaces: [...NAV, { texto: 'Contacto', href: '/contacto' }, { texto: 'Manual de marca', href: '/marca' }] },
  { titulo: 'Servicios', enlaces: servicios.map((s) => ({ texto: s.data.titulo, href: rutaServicio(s) })) },
  { titulo: 'Aliados', enlaces: sitio.aliados.map((a) => ({ texto: `${a.nombre} · ${a.rol}`, href: a.url, fuera: true })) },
];
---

<footer class="pie tema-carbon grano">
  <div class="contenedor">
    <section class="pie-boletin" id="boletin" aria-labelledby="boletin-titulo">
      <div class="pie-boletin-texto">
        <p class="kicker">Boletín · {sitio.boletin.frecuencia}</p>
        <h2 class="display d-3" id="boletin-titulo">Lo que estamos <em>filmando.</em></h2>
        <p class="texto-2">{sitio.boletin.descripcion}</p>
      </div>
      <Boletin id="boletin-pie" origen="pie" />
    </section>

    <div class="pie-grid">
      <div class="pie-marca">
        <a href="/" aria-label="Dial Medio, inicio" class="pie-logo"><Logo tono="claro" linea="medio" titulo="Dial Medio" /></a>
        <p class="texto-2 pie-desc">{sitio.descripcion}</p>
        <ul class="pie-redes">
          {sitio.redes.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.nombre}</a></li>)}
        </ul>
      </div>

      {
        columnas.map((c) => (
          <nav class="pie-col" aria-label={c.titulo}>
            <p class="kicker sin-linea">{c.titulo}</p>
            <ul>
              {c.enlaces.map((e: { texto: string; href: string; fuera?: boolean }) => (
                <li>
                  <a href={e.href} {...(e.fuera ? { target: '_blank', rel: 'noopener' } : {})}>{e.texto}{e.fuera && ' ↗'}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="pie-col">
        <p class="kicker sin-linea">Escríbenos</p>
        <ul>
          <li><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
          <li><a href={whatsapp()} target="_blank" rel="noopener">WhatsApp {sitio.whatsapp.visible}</a></li>
          <li class="texto-2">{sitio.ciudad}</li>
        </ul>
      </div>
    </div>

    <div class="pie-base">
      <span>© {new Date().getFullYear()} Dial Medio · Productora audiovisual · {sitio.ciudad}</span>
      <span>Las imágenes de terceros conservan su licencia.</span>
    </div>
  </div>
</footer>

<style>
  .pie { padding-block: clamp(56px, 7vw, 88px) 28px; position: relative; }
  .pie-boletin {
    display: grid; gap: 28px 64px; align-items: end;
    padding-bottom: clamp(48px, 6vw, 72px); margin-bottom: clamp(48px, 6vw, 72px);
    border-bottom: 1px solid var(--linea-clara);
  }
  .pie-boletin-texto { display: grid; gap: 14px; }
  .pie-boletin-texto p { margin: 0; }
  .pie-boletin-texto .texto-2 { max-width: 46ch; }
  @media (min-width: 900px) {
    .pie-boletin { grid-template-columns: 1fr 1fr; }
    .pie-boletin :global(.boletin) { justify-self: end; }
  }
  .pie-grid { display: grid; gap: 48px 32px; }
  .pie-marca { max-width: 40ch; }
  .pie-logo { text-decoration: none; font-size: 48px; display: inline-block; }
  .pie-desc { font-size: 1rem; margin: 18px 0 0; }
  .pie-redes { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; }
  .pie-redes a, .pie-col a { text-decoration: none; font-size: 1rem; transition: color .2s; }
  .pie-redes a:hover, .pie-col a:hover { color: var(--terracota-clara); }
  .pie-col ul { list-style: none; display: grid; gap: 10px; margin-top: 18px; }
  .pie-base {
    margin-top: clamp(56px, 7vw, 96px); padding-top: 22px; border-top: 1px solid var(--linea-clara);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; color: var(--hueso-2); font-size: .8rem;
  }
  @media (min-width: 700px) { .pie-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .pie-grid { grid-template-columns: 1.4fr 1fr 1.1fr 1.1fr 1fr; } }
</style>
