---
import Logo from './Logo.astro';
import Boletin from './Boletin.astro';
import sitio from '../data/sitio.json';
import { secciones, lineas } from '../lib/medio';

const nav = await secciones();
const columnas = [
  { titulo: 'Secciones', enlaces: nav.map((n) => ({ texto: n.texto, href: n.href })) },
  {
    titulo: 'Noticias',
    enlaces: Object.entries(lineas).map(([k, l]) => ({ texto: l.nombre, href: `/noticias/${k}` })),
  },
  {
    titulo: 'La casa',
    enlaces: [
      { texto: 'Nosotros', href: '/nosotros' },
      { texto: 'Principios editoriales', href: '/principios' },
      { texto: 'Correcciones', href: '/principios#correcciones' },
      { texto: 'Escribe en Dial', href: '/opinion#escribe' },
      { texto: 'Dial Estudio', href: '/estudio' },
      { texto: 'Contacto', href: '/contacto' },
    ],
  },
];
---

<footer class="pie tema-carbon grano">
  <div class="contenedor">
    <section class="pie-boletin" id="boletin" aria-labelledby="boletin-titulo">
      <div class="pie-boletin-texto">
        <p class="kicker">Boletín · {sitio.boletin.frecuencia}</p>
        <h2 class="display d-3" id="boletin-titulo">Dial en tu <em>correo.</em></h2>
        <p class="texto-2">{sitio.boletin.descripcion}</p>
      </div>
      <Boletin id="boletin-pie" origen="pie" />
    </section>

    <div class="pie-grid">
      <div class="pie-marca">
        <a href="/" aria-label="Dial, inicio" class="pie-logo"><Logo tono="claro" /></a>
        <p class="pie-tagline cursiva">{sitio.tagline}</p>
        <p class="texto-2 pie-desc">{sitio.descripcion}</p>
        <ul class="pie-redes">
          {sitio.redes.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.nombre}</a></li>)}
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>

      {
        columnas.map((c) => (
          <nav class="pie-col" aria-label={c.titulo}>
            <p class="kicker sin-linea">{c.titulo}</p>
            <ul>
              {c.enlaces.map((e) => (
                <li>
                  <a href={e.href}>{e.texto}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="pie-base">
      <span>© {new Date().getFullYear()} Dial · {sitio.ciudad}</span>
      <span>Las fotos de terceros conservan su licencia; ver créditos en cada pieza.</span>
      <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>
    </div>
  </div>
</footer>

<style>
  .pie { padding-block: clamp(56px, 7vw, 88px) 28px; position: relative; }
  .pie-boletin {
    display: grid;
    gap: 28px 64px;
    align-items: end;
    padding-bottom: clamp(48px, 6vw, 72px);
    margin-bottom: clamp(48px, 6vw, 72px);
    border-bottom: 1px solid var(--linea-clara);
  }
  .pie-boletin-texto { display: grid; gap: 14px; }
  .pie-boletin-texto p { margin: 0; }
  .pie-boletin-texto .texto-2 { max-width: 46ch; }
  @media (min-width: 900px) {
    .pie-boletin { grid-template-columns: 1fr 1fr; }
    .pie-boletin :global(.boletin) { justify-self: end; }
  }
  .pie-grid { display: grid; gap: 48px 32px; grid-template-columns: repeat(2, 1fr); }
  .pie-marca { grid-column: 1 / -1; max-width: 38ch; }
  .pie-logo { text-decoration: none; font-size: 52px; display: inline-block; }
  .pie-tagline { color: var(--hueso); margin: 14px 0 16px; font-size: 1.6rem; line-height: 1.1; }
  .pie-desc { font-size: 1rem; }
  .pie-redes { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; }
  .pie-redes a, .pie-col a { text-decoration: none; font-size: 1rem; transition: color .2s; }
  .pie-redes a:hover, .pie-col a:hover { color: var(--terracota-clara); }
  .pie-col ul { list-style: none; display: grid; gap: 10px; margin-top: 18px; }
  .pie-col:last-child { grid-column: 1 / -1; }
  .pie-base {
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: 22px;
    border-top: 1px solid var(--linea-clara);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    color: var(--hueso-2);
    font-size: .8rem;
  }
  .pie-base a { color: inherit; text-decoration: none; }
  @media (min-width: 980px) {
    .pie-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; }
    .pie-marca, .pie-col:last-child { grid-column: auto; }
  }
</style>
