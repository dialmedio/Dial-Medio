---
/** Compartir una pieza: WhatsApp (el canal que más se usa en Colombia), X, Facebook, correo y copiar enlace. */
interface Props {
  titulo: string;
  url: string;
}
const { titulo, url } = Astro.props;
const t = encodeURIComponent(titulo);
const u = encodeURIComponent(url);
const redes = [
  { nombre: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}` },
  { nombre: 'X', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { nombre: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { nombre: 'Correo', href: `mailto:?subject=${t}&body=${u}` },
];
---

<div class="compartir">
  <span class="rotulo">Compartir</span>
  <ul>
    {redes.map((r) => <li><a href={r.href} target="_blank" rel="noopener">{r.nombre}</a></li>)}
    <li><button type="button" data-copiar={url}>Copiar enlace</button></li>
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        if (navigator.share && matchMedia('(pointer: coarse)').matches) {
          await navigator.share({ title: document.title, url: b.dataset.copiar });
          return;
        }
        await navigator.clipboard.writeText(b.dataset.copiar!);
        const antes = b.textContent;
        b.textContent = 'Copiado';
        setTimeout(() => (b.textContent = antes), 1800);
      } catch {}
    }),
  );
</script>

<style>
  .compartir { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; }
  .compartir .rotulo { color: var(--texto-2); }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  a, button {
    display: inline-flex; align-items: center; min-height: 34px; padding: 0 .85em;
    border: 1px solid var(--borde); background: none; cursor: pointer;
    font-family: var(--f-sub); font-size: .86rem; font-weight: 500; text-decoration: none; color: inherit;
    transition: border-color .2s, background .2s, color .2s;
  }
  a:hover, button:hover { border-color: currentColor; }
</style>
