---
/**
 * Video embebido "liviano": muestra la miniatura y solo carga el reproductor
 * de YouTube o Vimeo cuando la persona hace clic. La página abre rápido.
 */
import { miniatura, type Video } from '../lib/util';

interface Props {
  video: Video;
  titulo: string;
  class?: string;
  cargaInmediata?: boolean;
}
const { video, titulo, class: clase = '', cargaInmediata = false } = Astro.props;
const v = { plataforma: 'youtube', vertical: false, ...video } as Video;
const src = miniatura(v);
---

<div
  class:list={['video', { vertical: v.vertical }, clase]}
  data-video={v.id}
  data-plataforma={v.plataforma}
  data-titulo={titulo}
>
  <button type="button" class="video-boton" aria-label={`Reproducir: ${titulo}`}>
    {
      src ? (
        <img
          src={src}
          alt=""
          loading={cargaInmediata ? 'eager' : 'lazy'}
          decoding="async"
          referrerpolicy="no-referrer"
          data-respaldo={v.plataforma === 'youtube' ? `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg` : undefined}
        />
      ) : (
        <span class="video-vacio" />
      )
    }
    <span class="video-play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
    </span>
  </button>
</div>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--carbon-2);
    overflow: hidden;
    border-radius: var(--radio);
  }
  .video.vertical { aspect-ratio: 9 / 16; }
  .video-boton {
    all: unset;
    position: absolute;
    inset: 0;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .video-boton:focus-visible { outline: 2px solid var(--ambar); outline-offset: -4px; }
  .video img,
  .video-vacio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease), filter 0.6s var(--ease);

  }
  .video:hover img { transform: scale(1.03); }
  .video-play {
    position: relative;
    z-index: 2;
    width: clamp(56px, 7vw, 84px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--terracota);
    color: #f7f2ea;
    box-shadow: 0 0 0 0 rgba(193, 80, 46, 0.5);
    transition: transform 0.4s var(--ease), box-shadow 0.6s var(--ease);
  }
  .video-play svg { width: 42%; transform: translateX(6%); }
  .video:hover .video-play { transform: scale(1.08); box-shadow: 0 0 0 14px rgba(193, 80, 46, 0.18); }
  .video.vertical .video-play { width: 52px; }
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 3;
  }
</style>
