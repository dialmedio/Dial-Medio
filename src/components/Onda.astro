---
/**
 * Onda: del ruido a la señal. Un trazo que empieza como ruido y termina en una onda limpia.
 * Motivo musical de Dial; se dibuja al entrar en pantalla.
 * El trazo es determinista (mismo dibujo en cada compilación).
 */
interface Props {
  tono?: 'claro' | 'oscuro';
  alto?: number;
  class?: string;
}
const { tono = 'oscuro', alto = 64, class: clase = '' } = Astro.props;

const ancho = 1200;
const medio = 50;
let semilla = 7;
const azar = () => ((semilla = (semilla * 16807) % 2147483647) / 2147483647) - 0.5;
const puntos: string[] = [];
for (let x = 0; x <= ancho; x += 4) {
  const t = x / ancho;
  const ruido = Math.max(0, 1 - t * 1.55) ** 1.4; // el ruido se apaga hacia la derecha
  const señal = Math.min(1, Math.max(0, (t - 0.25) / 0.5)); // la señal aparece
  const y =
    medio +
    azar() * 78 * ruido +
    Math.sin(x / 11) * 10 * ruido +
    Math.sin((x / ancho) * Math.PI * 9) * 26 * señal * (1 - Math.max(0, t - 0.8) * 1.2);
  puntos.push(`${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`);
}
const d = puntos.join(' ');
const color = tono === 'claro' ? 'var(--hueso)' : 'var(--carbon)';
---

<svg class:list={['onda', clase]} viewBox={`0 0 ${ancho} 100`} preserveAspectRatio="none" style={`height:${alto}px;--c:${color}`} aria-hidden="true" data-revela>
  <path d={d} pathLength="1" class="onda-trazo" />
  <circle cx={ancho - 4} cy={medio} r="5" class="onda-punto" />
</svg>

<style>
  .onda { display: block; width: 100%; overflow: visible; }
  .onda-trazo {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  .onda-punto { fill: var(--terracota); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .onda .onda-trazo { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.4s var(--ease) 0.2s; }
    :global(.js) .onda .onda-punto { opacity: 0; transition: opacity 0.6s ease 2.3s; }
    :global(.js) .onda.visible .onda-trazo { stroke-dashoffset: 0; }
    :global(.js) .onda.visible .onda-punto { opacity: 1; }
  }
</style>
